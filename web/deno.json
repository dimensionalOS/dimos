{
  "workspace": [
    "./relay",
    "./shared",
    "./sdk",
    "./cockpit",
    "./blueprint_view"
  ],
  "unstable": [
    "net"
  ],
  "nodeModulesDir": "auto",
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@std/cli": "jsr:@std/cli@^1",
    "@std/crypto": "jsr:@std/crypto@^1",
    "react": "npm:react@^19.2.0",
    "react/": "npm:/react@^19.2.0/",
    "react-dom": "npm:react-dom@^19.2.0",
    "react-dom/": "npm:/react-dom@^19.2.0/",
    "@types/react": "npm:@types/react@^19.3.0",
    "@types/react-dom": "npm:@types/react-dom@^19.3.0"
  },
  "tasks": {
    "dev": "deno run --allow-net --allow-read relay/main.ts",
    "test": "deno test --allow-net --allow-read relay shared",
    "check": "deno check relay shared"
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": [
      "shared/fixtures/*.json",
      "cockpit/dist/",
      "sdk/dist/",
      "blueprint_view/dist/"
    ]
  },
  "lint": {
    "exclude": [
      "cockpit/dist/",
      "sdk/dist/",
      "blueprint_view/dist/"
    ],
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  }
}
