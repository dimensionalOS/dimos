<?xml version="1.0"?>
<!-- cadpy:sourcePath=../../dimos/robot/sim2_lab/gen_urdf.py -->
<!-- cadpy:sourceHash=9d40f1dfb91346b9a13a8696ba1dcf662f3d6e19d4ee2bfbed120a1ae9b7f72d -->
<robot name="cartesian_pusher">
  <link name="base_link">
    <inertial>
      <origin xyz="-.55 0 .05" />
      <mass value="2.0" />
      <inertia ixx="0.016666666666666666" iyy="0.004066666666666667" izz="0.0174" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin xyz="-.55 0 .05" />
      <geometry>
        <box size="0.12 0.3 0.1" />
      </geometry>
      <material name="base_link">
        <color rgba=".25 .3 .4 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="-.55 0 .05" />
      <geometry>
        <box size="0.12 0.3 0.1" />
      </geometry>
    </collision>
  </link>
  <link name="carriage">
    <inertial>
      <origin xyz="0 0 .15" />
      <mass value="0.5" />
      <inertia ixx="0.00048333333333333344" iyy="0.00048333333333333344" izz="0.0008333333333333335" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin xyz="0 0 .15" />
      <geometry>
        <box size="0.1 0.1 0.04" />
      </geometry>
      <material name="carriage">
        <color rgba=".2 .5 .8 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 .15" />
      <geometry>
        <box size="0.1 0.1 0.04" />
      </geometry>
    </collision>
  </link>
  <link name="tool">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.3" />
      <inertia ixx="0.0005000000000000001" iyy="0.0005000000000000001" izz="0.0005000000000000001" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" />
      <geometry>
        <box size="0.1 0.1 0.1" />
      </geometry>
      <material name="tool">
        <color rgba=".1 .7 .9 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" />
      <geometry>
        <box size="0.1 0.1 0.1" />
      </geometry>
    </collision>
  </link>
  <joint name="slide_x" type="prismatic">
    <parent link="base_link" />
    <child link="carriage" />
    <origin xyz="-.4 0 .08" />
    <axis xyz="1 0 0" />
    <limit lower="0" upper=".8" effort="80" velocity=".5" />
    <dynamics damping="2" friction="0" />
  </joint>
  <joint name="slide_y" type="prismatic">
    <parent link="carriage" />
    <child link="tool" />
    <origin xyz="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-.3" upper=".3" effort="80" velocity=".5" />
    <dynamics damping="2" friction="0" />
  </joint>
</robot>
