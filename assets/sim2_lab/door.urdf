<?xml version="1.0"?>
<!-- cadpy:sourcePath=../../dimos/robot/sim2_lab/gen_door.py -->
<!-- cadpy:sourceHash=4b4b733c86561f99aea6962d0c636911969d3e0812c52c4c342bbb606d594b0d -->
<robot name="door">
  <link name="base">
    <inertial>
      <origin xyz="0 0 .16" />
      <mass value="1.0" />
      <inertia ixx="0.008666666666666668" iyy="0.008666666666666668" izz="0.0002666666666666667" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin xyz="0 0 .16" />
      <geometry>
        <box size="0.04 0.04 0.32" />
      </geometry>
      <material name="base">
        <color rgba=".3 .3 .3 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 .16" />
      <geometry>
        <box size="0.04 0.04 0.32" />
      </geometry>
    </collision>
  </link>
  <link name="panel">
    <inertial>
      <origin xyz=".225 0 .15" />
      <mass value="0.4" />
      <inertia ixx="0.0030208333333333333" iyy="0.008333333333333333" izz="0.005354166666666668" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin xyz=".225 0 .15" />
      <geometry>
        <box size="0.4 0.025 0.3" />
      </geometry>
      <material name="panel">
        <color rgba=".7 .6 .3 1" />
      </material>
    </visual>
    <collision>
      <origin xyz=".225 0 .15" />
      <geometry>
        <box size="0.4 0.025 0.3" />
      </geometry>
    </collision>
  </link>
  <joint name="hinge" type="revolute">
    <parent link="base" />
    <child link="panel" />
    <axis xyz="0 0 1" />
    <limit lower="-1.5" upper="1.5" effort="10" velocity="2" />
    <dynamics damping=".1" />
  </joint>
</robot>
