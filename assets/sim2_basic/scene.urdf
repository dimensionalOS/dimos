<?xml version="1.0"?>
<!-- cadpy:sourcePath=gen_scene.py -->
<!-- cadpy:sourceHash=69137d3b7778133d3b2fa24147b47b25bbc772382331e4f8773053012d8137fc -->
<robot name="sim2_basic">
  <link name="assets" />
  <link name="base">
    <inertial>
      <origin xyz="-.55 0 .05" />
      <mass value="2.0" />
      <inertia ixx="0.016666666666666666" iyy="0.004066666666666667" izz="0.0174" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin xyz="-.55 0 .05" />
      <geometry>
        <box size="0.12 0.3 0.1" />
      </geometry>
      <material name="base">
        <color rgba=".25 .3 .4 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="-.55 0 .05" />
      <geometry>
        <box size="0.12 0.3 0.1" />
      </geometry>
    </collision>
  </link>
  <link name="tool">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.3" />
      <inertia ixx="0.0005000000000000001" iyy="0.0005000000000000001" izz="0.0005000000000000001" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" />
      <geometry>
        <box size="0.1 0.1 0.1" />
      </geometry>
      <material name="tool">
        <color rgba=".1 .7 .9 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" />
      <geometry>
        <box size="0.1 0.1 0.1" />
      </geometry>
    </collision>
  </link>
  <link name="box">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.3" />
      <inertia ixx="0.0009800000000000002" iyy="0.0009800000000000002" izz="0.0009800000000000002" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" />
      <geometry>
        <box size="0.14 0.14 0.14" />
      </geometry>
      <material name="box">
        <color rgba=".95 .45 .1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" />
      <geometry>
        <box size="0.14 0.14 0.14" />
      </geometry>
    </collision>
  </link>
  <link name="wall">
    <inertial>
      <origin xyz="1 0 .4" />
      <mass value="5.0" />
      <inertia ixx="1.3333333333333337" iyy="0.26933333333333337" izz="1.0693333333333337" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin xyz="1 0 .4" />
      <geometry>
        <box size="0.08 1.6 0.8" />
      </geometry>
      <material name="wall">
        <color rgba=".75 .7 .6 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="1 0 .4" />
      <geometry>
        <box size="0.08 1.6 0.8" />
      </geometry>
    </collision>
  </link>
  <joint name="base_joint" type="fixed">
    <parent link="assets" />
    <child link="base" />
    <origin xyz="0 0 0" />
  </joint>
  <joint name="box_joint" type="fixed">
    <parent link="assets" />
    <child link="box" />
    <origin xyz="0 0 0" />
  </joint>
  <joint name="wall_joint" type="fixed">
    <parent link="base" />
    <child link="wall" />
    <origin xyz="0 0 0" />
  </joint>
  <joint name="tool_joint" type="prismatic">
    <parent link="base" />
    <child link="tool" />
    <origin xyz="-.4 0 .08" />
    <axis xyz="1 0 0" />
    <limit lower="0" upper="1" effort="80" velocity=".5" />
    <dynamics damping="2" />
  </joint>
</robot>
