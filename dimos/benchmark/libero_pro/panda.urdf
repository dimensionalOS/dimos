  </joint>
  <link name="link5"><collision><origin xyz="0 0 -0.26"/><geometry><cylinder radius="0.06" length="0.10"/></geometry></collision></link>
  <joint name="joint5" type="revolute">
    <parent link="link4"/><child link="link5"/><origin xyz="-0.0825 0.384 0" rpy="-1.57079632679 0 0"/><axis xyz="0 0 1"/>
