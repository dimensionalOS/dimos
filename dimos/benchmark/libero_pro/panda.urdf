-->
<robot name="panda">
  <link name="base"/>
  <link name="link0"/>
  <joint name="base_fixed" type="fixed">
    <parent link="base"/><child link="link0"/>
  </joint>
  <link name="link1"><collision><origin xyz="0 0 -0.1915"/><geometry><cylinder radius="0.06" length="0.283"/></geometry></collision></link>
  <joint name="joint1" type="revolute">
    <parent link="link0"/><child link="link1"/><origin xyz="0 0 0.333"/><axis xyz="0 0 1"/>
    <limit lower="-2.8973" upper="2.8973" effort="80" velocity="2.175"/>
  </joint>
  <link name="link2"><collision><origin xyz="0 0 0"/><geometry><cylinder radius="0.06" length="0.12"/></geometry></collision></link>
