{
  "source": "data/recordings/session_openyam.db",
  "episodes": {
    "extractor": "episode_status",
    "status_stream": "status"
  },
  "observation": {
    "observation.images.wrist": {
      "stream": "color_image",
      "field": "data",
      "dtype": "video",
      "shape": [480, 640, 3],
      "names": ["height", "width", "channels"]
    },
    "observation.state": {
      "stream": "coordinator_joint_state",
      "field": "position",
      "dtype": "float32",
      "shape": [7],
      "names": [
        "arm/joint1", "arm/joint2", "arm/joint3", "arm/joint4",
        "arm/joint5", "arm/joint6", "arm/gripper"
      ]
    }
  },
  "action": {
    "action": {
      "stream": "applied_joint_position_command",
      "field": "position",
      "dtype": "float32",
      "shape": [7],
      "names": [
        "arm/joint1", "arm/joint2", "arm/joint3", "arm/joint4",
        "arm/joint5", "arm/joint6", "arm/gripper"
      ]
    }
  },
  "sync": {
    "anchor": "observation.images.wrist",
    "rate_hz": 30,
    "tolerance_ms": 20,
    "strategy": "nearest"
  },
  "quality": {
    "mode": "strict",
    "min_source_rate_ratio": 0.95,
    "max_camera_gap_ms": 100,
    "max_alignment_error_ms": 20
  },
  "output": {
    "format": "lerobot",
    "path": "data/datasets/openyam",
    "metadata": {
      "repo_id": "local/openyam-wrist",
      "robot_type": "openyam"
    }
  }
}
