{
  "source": "",
  "episodes": {
    "extractor": "episode_status",
    "status_stream": "status"
  },
  "observation": {
    "image": {
      "stream": "color_image",
      "field": "data",
      "dtype": "video",
      "shape": [480, 640, 3],
      "names": ["height", "width", "channels"]
    },
    "joint_state": {
      "stream": "coordinator_joint_state",
      "field": "position",
      "dtype": "float32",
      "shape": [7],
      "names": [
        "arm_joint1", "arm_joint2", "arm_joint3", "arm_joint4",
        "arm_joint5", "arm_joint6", "arm/gripper"
      ]
    }
  },
  "action": {
    "joint_target": {
      "stream": "coordinator_joint_state",
      "field": "position",
      "dtype": "float32",
      "shape": [7],
      "names": [
        "arm_joint1", "arm_joint2", "arm_joint3", "arm_joint4",
        "arm_joint5", "arm_joint6", "arm/gripper"
      ]
    }
  },
  "sync": {
    "anchor": "image",
    "rate_hz": 15.0,
    "tolerance_ms": 80.0,
    "strategy": "nearest"
  },
  "output": {
    "format": "lerobot",
    "path": "data/datasets/galaxea_a1z",
    "metadata": {
      "robot": "galaxea_a1z",
      "default_task_label": "hand_teach"
    }
  }
}
