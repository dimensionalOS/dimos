#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.9.0"
    }
    defaultPrim = "toy"
    doc = """Converted from the MuJoCo toy model; see assets/toy.py."""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "toy" (
    apiSchemas = ["GeomModelAPI"]
    assetInfo = {
        string name = "toy"
    }
    kind = "component"
)
{
    float3[] extentsHint = [(8.8, 8.9, 8.9), (9.35, 9.1, 9.25)]

    def Scope "Geometry"
    {
        def Xform "base" (
            apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI", "NewtonArticulationRootAPI"]
        )
        {
            uniform bool newton:jointsAddMobility = 1
            quatf xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (9, 9, 9)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            def Cube "Box" (
                apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "MjcCollisionAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
            )
            {
                float3[] extent = [(-1, -1, -1), (1, 1, 1)]
                rel material:binding:physics = </toy/Physics/PhysicsMaterial>
                uniform double[] mjc:solref = [0.02, 1]
                float newton:contactGap = 0
                float physics:mass = 1
                color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)] (
                    interpolation = "constant"
                )
                int[] primvars:displayColor:indices = None
                float[] primvars:displayOpacity = [1] (
                    interpolation = "constant"
                )
                int[] primvars:displayOpacity:indices = None
                double size = 2
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (0.2, 0.1, 0.1)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Xform "head" (
                apiSchemas = ["PhysicsRigidBodyAPI"]
            )
            {
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0.3, 0, 0.2)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

                def Sphere "Sphere" (
                    apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "MjcCollisionAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
                )
                {
                    float3[] extent = [(-0.05, -0.05, -0.05), (0.05, 0.05, 0.05)]
                    rel material:binding:physics = </toy/Physics/PhysicsMaterial>
                    uniform double[] mjc:solref = [0.02, 1]
                    float newton:contactGap = 0
                    float physics:mass = 0.1
                    color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)] (
                        interpolation = "constant"
                    )
                    int[] primvars:displayColor:indices = None
                    float[] primvars:displayOpacity = [1] (
                        interpolation = "constant"
                    )
                    int[] primvars:displayOpacity:indices = None
                    double radius = 0.05
                    quatf xformOp:orient = (1, 0, 0, 0)
                    float3 xformOp:scale = (1, 1, 1)
                    double3 xformOp:translate = (0, 0, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
                }

                def PhysicsRevoluteJoint "neck" (
                    apiSchemas = ["MjcJointAPI", "NewtonJointAPI"]
                )
                {
                    uniform token physics:axis = "Z"
                    rel physics:body0 = </toy/Geometry/base>
                    rel physics:body1 = </toy/Geometry/base/head>
                    point3f physics:localPos0 = (0.3, 0, 0.2)
                    point3f physics:localPos1 = (0, 0, 0)
                    quatf physics:localRot0 = (1, 0, 0, 0)
                    quatf physics:localRot1 = (1, 0, 0, 0)
                }
            }
        }
    }

    def Scope "Physics"
    {
        def Material "PhysicsMaterial" (
            apiSchemas = ["PhysicsMaterialAPI", "NewtonMaterialAPI"]
        )
        {
            float newton:contactDamping = 100
            float newton:contactStiffness = 2500
            float newton:rollingFriction = 0.0001
            float newton:torsionalFriction = 0.005
            float physics:dynamicFriction = 1
            float physics:staticFriction = 1
        }

        def MjcActuator "neck"
        {
            rel mjc:target = </toy/Geometry/base/head/neck>
        }
    }
}

def PhysicsScene "PhysicsScene" (
    apiSchemas = ["NewtonSceneAPI", "MjcSceneAPI"]
)
{
    uniform int newton:maxSolverIterations = 100
    uniform int newton:timeStepsPerSecond = 500
    vector3f physics:gravityDirection = (0, 0, -1)
    float physics:gravityMagnitude = 9.81
}
