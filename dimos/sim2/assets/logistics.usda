#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.9.0"
    }
    defaultPrim = "logistics"
    doc = """Generated from Composed Stage of root layer /tmp/claude-1000/-home-dimos/ff9ad774-151d-43c4-9774-fa96d8ad90f5/scratchpad/logistics/converted/logistics.usda
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "Flattened_Prototype_1"
{
    def Shader "PreviewSurface"
    {
        uniform token info:id = "UsdPreviewSurface"
        color3f inputs:diffuseColor.connect = </Flattened_Prototype_1.inputs:color>
        float inputs:metallic.connect = </Flattened_Prototype_1.inputs:metallic>
        float inputs:opacity.connect = </Flattened_Prototype_1.inputs:opacity>
        float inputs:roughness.connect = </Flattened_Prototype_1.inputs:roughness>
        token outputs:surface
    }

    def Shader "OpenPBR"
    {
        uniform token info:id = "ND_open_pbr_surface_surfaceshader"
        color3f inputs:base_color.connect = </Flattened_Prototype_1.inputs:color>
        float inputs:base_metalness.connect = </Flattened_Prototype_1.inputs:metallic>
        float inputs:geometry_opacity.connect = </Flattened_Prototype_1.inputs:opacity>
        float inputs:specular_roughness.connect = </Flattened_Prototype_1.inputs:roughness>
        token outputs:out
    }
}

