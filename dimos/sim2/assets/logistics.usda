def PhysicsScene "PhysicsScene" (
    apiSchemas = ["NewtonSceneAPI", "MjcSceneAPI"]
)
{
    uniform token mjc:option:cone = "elliptic"
    uniform double mjc:option:impratio = 10
    uniform int newton:maxSolverIterations = 100
    uniform int newton:timeStepsPerSecond = 200
    vector3f physics:gravityDirection = (0, 0, -1)
    float physics:gravityMagnitude = 9.81
}

# The MJCF said `<light pos="0 0 5" directional dir="0 0 -1">` and a headlight ambient of 0.35;
# the converter drops lights entirely ("lights are not supported"), so they are written here. A
# layer that says nothing about its lighting gets whatever the viewer guesses, which for the
# office scene was a room lit from nowhere with flat black through the windows.
def DistantLight "sun" (
    prepend apiSchemas = ["ShadowAPI"]
)
{
    # Straight down, as the MJCF's dir="0 0 -1" asked for.
    color3f inputs:color = (1, 1, 1)
    float inputs:intensity = 2.0
    bool inputs:shadow:enable = 1
    quatf xformOp:orient = (0.70710678, -0.70710678, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:orient"]
}

def DomeLight "ambient" (
    prepend apiSchemas = ["ShadowAPI"]
)
{
    # The headlight's ambient term: there is no bounce in the renderer, so this stands in for
    # what would reach a surface after scattering off the walls.
    color3f inputs:color = (1, 1, 1)
    float inputs:intensity = 1.2
    bool inputs:shadow:enable = 0
}
