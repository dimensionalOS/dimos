        string name = "scene"
    }
    kind = "component"
)
{
    float3[] extentsHint = [(-5, -5, 0), (5, 5, 1.02)]

    def Scope "Geometry"
    {
        def Plane "floor" (
            apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "MjcCollisionAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
        )
        {
            uniform token axis = "Z"
            float3[] extent = [(-5, -5, -0), (5, 5, 0)]
