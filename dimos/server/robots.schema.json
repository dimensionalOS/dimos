{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dimensionalOS/dimos/blob/main/dimos/server/robots.schema.json",
  "title": "dimos robots",
  "description": "robots.json: every robot dimos supports and what each of its blueprints is for. dimos/server/robots.py checks it against the code (every robot dir covered, every blueprint listed, every arg a real config field).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tags",
    "modes",
    "groups",
    "args",
    "robots",
    "excluded"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "about": {
      "type": "string"
    },
    "tags": {
      "description": "The fixed tag vocabulary, in display order. `replay` and `sim` are never written on a blueprint: they come from its modes.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/label"
      }
    },
    "modes": {
      "description": "Where a blueprint's data comes from, in display order: robot (real hardware), replay (a recording), sim (a simulator).",
      "type": "object",
      "propertyNames": {
        "enum": [
          "robot",
          "replay",
          "sim"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/label"
      }
    },
    "groups": {
      "description": "Robots shown together under one name (e.g. every arm under Arms).",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "args": {
      "description": "The essential args, defined once by id; a blueprint's modes name the ones they take.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/arg"
      }
    },
    "robots": {
      "description": "Every robot, in display order, by id.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/robot"
      }
    },
    "excluded": {
      "description": "Directories under dimos/robot that are not robots, each with the reason.",
      "type": "object",
      "propertyNames": {
        "pattern": "^dimos/robot/"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "description"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "app": {
      "description": "The app to install for this robot (dimOS Desktop's App Store installs it from `url`).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "url"
      ],
      "properties": {
        "id": {
          "description": "the app's install name: its repo's name",
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "description": "the app's git repository",
          "type": "string",
          "pattern": "^https://"
        },
        "ref": {
          "description": "the branch or tag to install",
          "type": "string"
        }
      }
    },
    "robot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "type",
        "manufacturer",
        "dirs",
        "blueprints"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "description": "What kind of robot it is: dog (a legged quadruped), wheeled, humanoid, arm or drone; null when it isn't a robot dimos drives (sensors, demos, simulators, coordinators). Desktop's robot picker shows only the robots with a type, with its icon.",
          "enum": [
            "dog",
            "wheeled",
            "humanoid",
            "arm",
            "drone",
            null
          ]
        },
        "manufacturer": {
          "description": "Who makes it, as its `name` starts (\"Unitree\" for \"Unitree Go2\"); null for DIY, open-source and generic hardware, and for what isn't a robot. Robots in one vendor folder (dimos/robot/<vendor>/<robot>) share it.",
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "group": {
          "description": "a key of `groups`",
          "type": "string"
        },
        "dirs": {
          "description": "The code directories that are this robot's (repo-relative). Every blueprint defined under one must be listed here.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^dimos/[A-Za-z0-9_/]+$"
          }
        },
        "recommended_app": {
          "$ref": "#/$defs/app"
        },
        "recommended": {
          "description": "The blueprints to suggest first for this robot, best first (a launcher lists them on top). Each is one of this robot's `blueprints`.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "defaults": {
          "description": "What a blueprint of this robot has unless it says otherwise.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "modes": {
              "$ref": "#/$defs/modes"
            },
            "recommended_config": {
              "$ref": "#/$defs/recommended_config"
            }
          }
        },
        "blueprints": {
          "description": "This robot's blueprints, by registered name (dimos/robot/all_blueprints.py).",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/blueprint"
          }
        }
      }
    },
    "blueprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "tags"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "description": "one plain sentence or two: what it does and what it needs",
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "description": "keys of the top-level `tags`, except replay and sim (they come from `modes`)",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "modes": {
          "$ref": "#/$defs/modes"
        },
        "starter": {
          "description": "a pick for \"start here\": its rank (1 first) across every robot",
          "type": "integer",
          "minimum": 1
        },
        "hidden": {
          "description": "a test, benchmark, mock or building block: listed only when asked for",
          "type": "boolean"
        },
        "recommended_app": {
          "description": "overrides the robot's; null: none",
          "oneOf": [
            {
              "$ref": "#/$defs/app"
            },
            {
              "type": "null"
            }
          ]
        },
        "recommended_config": {
          "$ref": "#/$defs/recommended_config"
        }
      }
    },
    "modes": {
      "description": "The modes it runs in (in order), each with the GlobalConfig values it sets and the args a person fills in. Without it: the robot's defaults, else robot mode with no args.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "robot",
          "replay",
          "sim"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "set": {
            "description": "GlobalConfig fields and the values this mode gives them (`--key value` before `run`)",
            "type": "object"
          },
          "args": {
            "description": "ids of top-level `args`, in the order a person fills them in",
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "arg": {
      "description": "An essential arg: a GlobalConfig field (`global`) or a module config field (`module` = the module's name in the blueprint, as in `dimos run <bp> --<module>.<field> value`).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label"
      ],
      "oneOf": [
        {
          "required": [
            "global"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "module"
                ]
              },
              {
                "required": [
                  "field"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "module",
            "field"
          ],
          "not": {
            "required": [
              "global"
            ]
          }
        }
      ],
      "properties": {
        "global": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "module": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "description": "text (default), number, bool, or recording (a picker of dimos recordings)",
          "enum": [
            "text",
            "number",
            "bool",
            "recording"
          ]
        },
        "placeholder": {
          "type": "string"
        },
        "default": {},
        "required": {
          "type": "boolean"
        },
        "streams": {
          "description": "recording: the streams it must have, each a list of acceptable names",
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "docs": {
          "description": "A page on how to find this value (where a robot's IP comes from); the Launcher links it beside the field. dimos/server/test_robots.py checks it resolves.",
          "type": "string",
          "pattern": "^https://"
        }
      }
    },
    "recommended_config": {
      "description": "The few settings a person should decide before running it, in order, shown first (a launcher's config editor puts them on top). Each is an arg from the top-level `args` (`arg`), or a GlobalConfig field (`global`) or module config field (`module`, `field`) written out, with an optional label, choices and default. On a blueprint it replaces the robot's defaults' list; [] means none.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/recommended_setting"
      }
    },
    "recommended_setting": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "arg"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "global"
                ]
              },
              {
                "required": [
                  "module"
                ]
              },
              {
                "required": [
                  "field"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "global",
            "label"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "arg"
                ]
              },
              {
                "required": [
                  "module"
                ]
              },
              {
                "required": [
                  "field"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "module",
            "field",
            "label"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "arg"
                ]
              },
              {
                "required": [
                  "global"
                ]
              }
            ]
          }
        }
      ],
      "properties": {
        "arg": {
          "description": "an id of the top-level `args` (its label, docs and placeholder come along)",
          "type": "string",
          "minLength": 1
        },
        "global": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "module": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$"
        },
        "label": {
          "description": "what to ask (overrides the arg's label)",
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "description": "text (default), number, bool, or recording (a picker of dimos recordings)",
          "enum": [
            "text",
            "number",
            "bool",
            "recording"
          ]
        },
        "placeholder": {
          "type": "string"
        },
        "docs": {
          "description": "A page on how to find this value (where a robot's IP comes from); the Launcher links it beside the field. dimos/server/test_robots.py checks it resolves.",
          "type": "string",
          "pattern": "^https://"
        },
        "default": {
          "description": "what to suggest"
        },
        "choices": {
          "description": "the values to pick from, each with a label (without it: a free value)",
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "label"
            ],
            "properties": {
              "value": {},
              "label": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
