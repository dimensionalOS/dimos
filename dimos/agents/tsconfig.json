{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "paths": {
      "@dimos/sdk": ["../../web/sdk/src/index.ts"],
      "@dimos/sdk/testing/fakeRelay": ["../../web/sdk/src/testing/fakeRelay.ts"],
      "@dimos/shared": ["../../web/shared/protocol.ts"],
      "@dimos/shared/manifest": ["../../web/shared/manifest.ts"]
    },
    "types": ["node"],
    "erasableSyntaxOnly": false
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
