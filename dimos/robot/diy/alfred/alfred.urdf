<?xml version="1.0"?>
<!-- Alfred: an i2rt FLOW holonomic base carrying a Livox Mid-360 and a RealSense
     D435i. Caster layout is the FLOW's own kinematic constant; the two sensor
     mounts are measured from the robot. -->
<robot name="alfred">

  <material name="shell"><color rgba="0.85 0.85 0.83 1"/></material>
  <material name="frame"><color rgba="0.35 0.38 0.37 1"/></material>
  <material name="rubber"><color rgba="0.11 0.11 0.10 1"/></material>
  <material name="sensor"><color rgba="0.20 0.45 0.70 1"/></material>

  <link name="base_link"/>

  <link name="base_body">
    <visual>
      <origin xyz="0 0 0.165" rpy="0 0 0"/>
      <geometry><box size="0.52 0.52 0.33"/></geometry>
      <material name="shell"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.165" rpy="0 0 0"/>
      <geometry><box size="0.52 0.52 0.33"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.165" rpy="0 0 0"/>
      <mass value="60.0"/>
      <inertia ixx="1.6" ixy="0" ixz="0" iyy="1.6" iyz="0" izz="2.7"/>
    </inertial>
  </link>
  <joint name="base_body_joint" type="fixed">
    <parent link="base_link"/><child link="base_body"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Caster kingpin positions (FLOW h_x/h_y). -->
  <link name="caster_front_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry><cylinder radius="0.05" length="0.04"/></geometry>
      <material name="rubber"/>
    </visual>
  </link>
  <joint name="caster_front_left_joint" type="fixed">
    <parent link="base_link"/><child link="caster_front_left_link"/>
    <origin xyz="0.2 0.2 0.05" rpy="0 0 0"/>
  </joint>

  <link name="caster_front_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry><cylinder radius="0.05" length="0.04"/></geometry>
      <material name="rubber"/>
    </visual>
  </link>
  <joint name="caster_front_right_joint" type="fixed">
    <parent link="base_link"/><child link="caster_front_right_link"/>
    <origin xyz="0.2 -0.2 0.05" rpy="0 0 0"/>
  </joint>

  <link name="caster_rear_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry><cylinder radius="0.05" length="0.04"/></geometry>
      <material name="rubber"/>
    </visual>
  </link>
  <joint name="caster_rear_left_joint" type="fixed">
    <parent link="base_link"/><child link="caster_rear_left_link"/>
    <origin xyz="-0.2 0.2 0.05" rpy="0 0 0"/>
  </joint>

  <link name="caster_rear_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry><cylinder radius="0.05" length="0.04"/></geometry>
      <material name="rubber"/>
    </visual>
  </link>
  <joint name="caster_rear_right_joint" type="fixed">
    <parent link="base_link"/><child link="caster_rear_right_link"/>
    <origin xyz="-0.2 -0.2 0.05" rpy="0 0 0"/>
  </joint>

  <!-- Lift mast at the front center of the deck. Height MEASURED 2026-08-26 from
       the side photo, scaled by the FLOW base height (deck top 0.33 m above
       floor): mast top 2.01 m above floor -> 1.68 m of extrusion above the deck. -->
  <link name="mast_link">
    <visual>
      <origin xyz="0 0 0.84" rpy="0 0 0"/>
      <geometry><box size="0.10 0.20 1.68"/></geometry>
      <material name="frame"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.84" rpy="0 0 0"/>
      <geometry><box size="0.10 0.20 1.68"/></geometry>
    </collision>
  </link>
  <joint name="mast_joint" type="fixed">
    <parent link="base_link"/><child link="mast_link"/>
    <origin xyz="0.21 0 0.331" rpy="0 0 0"/>
  </joint>

  <!-- Livox Mid-360 on an angled bracket, pitched ~22.5 deg forward.
       Calibrated 2026-08-17 from point-lio odometry vs wheel spin-in-place
       segments (drive_2026-08-16_23-46-03.db, 3-6 mm residual). -->
  <link name="mid360_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.065 0.065 0.06"/></geometry>
      <material name="sensor"/>
    </visual>
  </link>
  <joint name="mid360_joint" type="fixed">
    <parent link="base_link"/><child link="mid360_link"/>
    <origin xyz="0.2307 -0.1636 0.437" rpy="-0.0096 0.3933 -0.0219"/>
  </joint>

  <!-- RealSense D435i mounted upside-down at the rear, centered left-right,
       facing off the back, on a 40 mm extrusion rail lying on the deck about
       12 cm inboard of the rear edge. ESTIMATED 2026-08-26 from photos
       (deck 0.33 + 0.040 rail + ~0.008 mount + 0.0125 half body = 0.391);
       needs a spin calibration like the old D455 mount had.
       Roll pi = upside-down, yaw pi = facing rearward.
       camera_link sits at the depth (left infrared) imager, which is where the
       RealSense driver puts it; child offsets below are nominal D435i values,
       replace with factory extrinsics read back off the device. -->
  <link name="camera_link">
    <!-- The link sits at the left IR imager, not the housing center, so the box
         is offset along -y (infra2 is 50 mm along -y, housing 90 mm wide). -->
    <visual>
      <origin xyz="0 -0.025 0" rpy="0 0 0"/>
      <geometry><box size="0.025 0.090 0.025"/></geometry>
      <material name="sensor"/>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/><child link="camera_link"/>
    <origin xyz="-0.13 0 0.391" rpy="3.1415927 0 3.1415927"/>
  </joint>

  <link name="camera_depth_frame"/>
  <joint name="camera_depth_joint" type="fixed">
    <parent link="camera_link"/><child link="camera_depth_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="camera_depth_optical_frame"/>
  <joint name="camera_depth_optical_joint" type="fixed">
    <parent link="camera_depth_frame"/><child link="camera_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>

  <link name="camera_color_frame"/>
  <joint name="camera_color_joint" type="fixed">
    <parent link="camera_link"/><child link="camera_color_frame"/>
    <origin xyz="0 -0.015 0" rpy="0 0 0"/>
  </joint>
  <link name="camera_color_optical_frame"/>
  <joint name="camera_color_optical_joint" type="fixed">
    <parent link="camera_color_frame"/><child link="camera_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>

  <link name="camera_infra1_frame"/>
  <joint name="camera_infra1_joint" type="fixed">
    <parent link="camera_link"/><child link="camera_infra1_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="camera_infra1_optical_frame"/>
  <joint name="camera_infra1_optical_joint" type="fixed">
    <parent link="camera_infra1_frame"/><child link="camera_infra1_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>

  <link name="camera_infra2_frame"/>
  <joint name="camera_infra2_joint" type="fixed">
    <parent link="camera_link"/><child link="camera_infra2_frame"/>
    <origin xyz="0 -0.050 0" rpy="0 0 0"/>
  </joint>
  <link name="camera_infra2_optical_frame"/>
  <joint name="camera_infra2_optical_joint" type="fixed">
    <parent link="camera_infra2_frame"/><child link="camera_infra2_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>

  <link name="camera_accel_frame"/>
  <joint name="camera_accel_joint" type="fixed">
    <parent link="camera_link"/><child link="camera_accel_frame"/>
    <origin xyz="-0.0112 -0.0055 0.0051" rpy="0 0 0"/>
  </joint>
  <link name="camera_accel_optical_frame"/>
  <joint name="camera_accel_optical_joint" type="fixed">
    <parent link="camera_accel_frame"/><child link="camera_accel_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>

  <!-- RealSense D455 on the mast, centered left-right, facing forward, pitched
       down. Frame prefix d455 so it can coexist with the rear D435i (camera_*);
       run the driver with camera_name="d455". Child offsets are nominal D455
       values (95 mm IR baseline). -->
  <link name="d455_link">
    <!-- The link sits at the left IR imager (RealSense convention), ~15 mm from
         the left end of the 124 mm housing, so the box is offset along -y. -->
    <visual>
      <origin xyz="0 -0.0475 0" rpy="0 0 0"/>
      <geometry><box size="0.026 0.124 0.029"/></geometry>
      <material name="sensor"/>
    </visual>
  </link>
  <!-- Solved from drive_2026-08-18_23-05-04 by registering D455 depth against the
       point-lio lidar map (median error 5.6 -> 3.1 cm, inliers 44% -> 78%). Only z
       is tightly resolved; x and y are bounded to about +/-3 cm, so treat them as a
       best estimate rather than a measurement. -->
  <joint name="d455_joint" type="fixed">
    <parent link="base_link"/><child link="d455_link"/>
    <origin xyz="0.2146 -0.0008 1.5435" rpy="0.0012 0.1448 -0.0106"/>
  </joint>

  <link name="d455_depth_frame"/>
  <joint name="d455_depth_joint" type="fixed">
    <parent link="d455_link"/><child link="d455_depth_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="d455_depth_optical_frame"/>
  <joint name="d455_depth_optical_joint" type="fixed">
    <parent link="d455_depth_frame"/><child link="d455_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>

  <link name="d455_color_frame"/>
  <joint name="d455_color_joint" type="fixed">
    <parent link="d455_link"/><child link="d455_color_frame"/>
    <origin xyz="0 -0.029 0" rpy="0 0 0"/>
  </joint>
  <link name="d455_color_optical_frame"/>
  <joint name="d455_color_optical_joint" type="fixed">
    <parent link="d455_color_frame"/><child link="d455_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>

  <link name="d455_infra1_frame"/>
  <joint name="d455_infra1_joint" type="fixed">
    <parent link="d455_link"/><child link="d455_infra1_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="d455_infra1_optical_frame"/>
  <joint name="d455_infra1_optical_joint" type="fixed">
    <parent link="d455_infra1_frame"/><child link="d455_infra1_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>

  <link name="d455_infra2_frame"/>
  <joint name="d455_infra2_joint" type="fixed">
    <parent link="d455_link"/><child link="d455_infra2_frame"/>
    <origin xyz="0 -0.095 0" rpy="0 0 0"/>
  </joint>
  <link name="d455_infra2_optical_frame"/>
  <joint name="d455_infra2_optical_joint" type="fixed">
    <parent link="d455_infra2_frame"/><child link="d455_infra2_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>

  <link name="d455_accel_frame"/>
  <joint name="d455_accel_joint" type="fixed">
    <parent link="d455_link"/><child link="d455_accel_frame"/>
    <origin xyz="-0.0160 -0.0302 0.0074" rpy="0 0 0"/>
  </joint>
  <link name="d455_accel_optical_frame"/>
  <joint name="d455_accel_optical_joint" type="fixed">
    <parent link="d455_accel_frame"/><child link="d455_accel_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>

</robot>
