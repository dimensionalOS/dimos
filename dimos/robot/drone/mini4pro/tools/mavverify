FAIL, WARN, INFO, SKIP, PASS = "FAIL", "WARN", "INFO", "SKIP", "PASS"
ORDER = {FAIL: 0, WARN: 1, SKIP: 2, INFO: 3, PASS: 4}


def L(name, args=None):
    if args and name in args.limit_override:
        return args.limit_override[name]
    return LIMITS[name][0]


class Report:
    def __init__(self):
        self.findings = []  # (severity, check_id, detail)

    def add(self, sev, cid, detail=""):
        assert cid in CHECKS, cid
        self.findings.append((sev, cid, detail))

    def ok(self, cid, detail=""):
        self.add(PASS, cid, detail)

    def count(self, sev):
        return sum(1 for s, _, _ in self.findings if s == sev)

    def render(self, out, quiet=False):
        seen = set()
        for sev, cid, detail in sorted(self.findings, key=lambda f: (ORDER[f[0]], f[1])):
            if quiet and sev in (PASS, INFO):
                continue
            head = f"{sev:<4} {cid:<28}"
            title = "" if cid in seen else CHECKS[cid][0]
            seen.add(cid)
            out.write(f"{head} {detail or title}\n")
            if detail and title:
                out.write(f"{'':<4} {'':<28} ({title})\n")
            if sev == FAIL:
                out.write(f"{'':<4} {'':<28} expectation: {CHECKS[cid][1]}\n")


