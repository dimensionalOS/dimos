def main():
    argv = sys.argv[1:]
    try:
        if argv and argv[0] == "ls":
            return sub_ls(argv[1:])
        if argv and argv[0] == "pull":
            return sub_pull(argv[1:])
        if argv and argv[0] == "rm":
            return sub_rm(argv[1:])
        args = query_parser().parse_args(argv)
        if args.selftest:
            return selftest()
        if args.selftest_real:
            return selftest_real(required=True)
        return run_query(args)
    except (bb.Refusal, bb.PhoneDown) as e:
        sys.stderr.write(f"blackbox: {e}\n")
        return 2
    except BrokenPipeError:
        return 0


if __name__ == "__main__":
    raise SystemExit(main())
