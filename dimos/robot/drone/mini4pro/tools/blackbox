    # ── output modes, as typed ──
    code, out_b, err = _cli([part1, "--json", "-k", "tag"], binary=True)
    want = hashlib.md5(b"".join(r + b"\n" for r in tag_raw)).hexdigest()
    got = hashlib.md5(out_b).hexdigest()
    check(
        "--json: byte-faithful (md5 vs planted lines)",
        code == 0 and got == want,
        f"md5 {got} vs {want}; err={err}",
    )
    code, out_s, err = _cli([part1, "-k", "tag"])
    check(
        "footer: matched/lines/files/unparseable all stated",
        "12 matched of 24 lines across 2 files (1 unparseable)" in out_s,
