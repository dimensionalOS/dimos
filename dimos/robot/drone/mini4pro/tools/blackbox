# ─────────────────────────────── output helpers ───────────────────────────────


def flatten(row):
    """One display dict per row: nested objects become dotted columns (f.vx), and
    anything deeper or list-shaped is shown as compact JSON rather than guessed at."""
    out = {}
    for k, v in row.items():
        if isinstance(v, dict):
            for k2, v2 in v.items():
                out[f"{k}.{k2}"] = (
                    json.dumps(v2, separators=(",", ":")) if isinstance(v2, (dict, list)) else v2
                )
        elif isinstance(v, list):
            out[k] = json.dumps(v, separators=(",", ":"))
        else:
            out[k] = v
    return out


def fmt_cell(col, v):
    if v is None:
        return ""
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, float):
        return (f"{v:.3f}") if col == "t" else (f"{v:.6g}")
    s = str(v)
    return s if len(s) <= 48 else s[:47] + "…"


def print_table(rows, fields, out):
    if fields:
        cols = fields
        cells = [[fmt_cell(c, bb.field(r, c)) for c in cols] for r in rows]
    else:
        flat = [flatten(r) for r in rows]
        cols, seen = [], set()
        for head in ("t", "k"):
            if any(head in f for f in flat):
                cols.append(head)
                seen.add(head)
        for f in flat:
            for c in f:
                if c not in seen:
                    seen.add(c)
                    cols.append(c)
        cells = [[fmt_cell(c, f.get(c)) for c in cols] for f in flat]
    if not rows:
        return
    widths = [
        max(len(c), max((len(row[i]) for row in cells), default=0)) for i, c in enumerate(cols)
    ]
    num = [
        all(re.fullmatch(r"-?\d+(\.\d+)?([eE][-+]?\d+)?", row[i]) for row in cells if row[i] != "")
        and any(row[i] != "" for row in cells)
        for i in range(len(cols))
    ]

    def line(vals):
        return "  ".join(
            (v.rjust(w) if n else v.ljust(w)) for v, w, n in zip(vals, widths, num, strict=False)
        ).rstrip()

    out.write(line(cols) + "\n")
    for row in cells:
        out.write(line(row) + "\n")


def footer(out, shown, matched, record):
    extra = " (%d unparseable)" % len(record.bad) if record.bad else ""
    if shown != matched:
        out.write(
            "%d shown of %d matched of %d lines across %d files%s\n"
            % (shown, matched, record.total_lines, len(record.paths), extra)
        )
    else:
        out.write(
            "%d matched of %d lines across %d files%s\n"
            % (matched, record.total_lines, len(record.paths), extra)
        )


SEV_MARK = {"error": "!!", "warn": " !"}


def print_events(rows, out):
    for e in rows:
        t = e.get("t")
        out.write(
            "%s %9s  %-26s %s\n"
            % (
                SEV_MARK.get(e.get("sev"), "  "),
                (f"{t:.3f}") if isinstance(t, (int, float)) else "?",
                e.get("code", "?"),
                e.get("msg") or "",
            )
        )


