            check("pull: refuses a non-empty dest by name", False, "no refusal")
        except bb.Refusal as e:
            check("pull: refuses a non-empty dest by name", "into-existing" in str(e), str(e))
        os.environ["FAKE_TRUNCATE"] = PHONE_FLIGHT + ".002.jsonl"
        try:
            bb.pull_session(phone, PHONE_FLIGHT, os.path.join(tmp, "pulled2"), out=io.StringIO())
            check("pull: a truncated transfer is caught by the size check", False, "no refusal")
        except bb.Refusal as e:
            check(
                "pull: a truncated transfer is caught by the size check",
                "truncated" in str(e) and ".002.jsonl" in str(e),
                str(e),
            )
        del os.environ["FAKE_TRUNCATE"]

        code, out_s, err = _cli(["rm", PHONE_STUB])
        stub_file = os.path.join(pdir, PHONE_STUB + ".001.jsonl")
        check(
            "rm: lists the files and refuses without --yes",
            code == 2 and "--yes" in err and PHONE_STUB in out_s and os.path.exists(stub_file),
            "code=%d err=%s" % (code, err),
        )
        code, out_s, err = _cli(["rm", "latest", "--yes"])
        check(
            "rm latest: refused by name", code == 2 and "latest" in err and "explicit" in err, err
        )
        code, out_s, err = _cli(["rm", PHONE_STUB, "--yes"])
        check(
            "rm --yes: deletes exactly that session from the phone",
            code == 0
            and not os.path.exists(stub_file)
            and os.path.exists(os.path.join(pdir, PHONE_FLIGHT + ".001.jsonl")),
            "code=%d err=%s" % (code, err),
        )
    finally:
        for k in ("BLACKBOX_PHONEADB", "FAKE_PHONE_DIR", "FAKE_LOG", "FAKE_TRUNCATE"):
            os.environ.pop(k, None)

    # ── report ──
    failures = 0
    width = max(len(n) for n, _, _ in checks)
    print("blackbox self-test — %d checks against planted records and a fake phone\n" % len(checks))
    for name, ok, note in checks:
        print("%s %-*s" % ("ok  " if ok else "FAIL", width, name))
        if not ok:
            failures += 1
            print(f"     {note}")
    print(f"\nfixtures in {tmp}")

    rc_real = selftest_real(required=False)
    if failures:
        print(
            "%d check(s) FAILED — a query answered wrong on data whose answer "
            "was planted." % failures
        )
    else:
        print("every planted answer came back exact.")
    return (1 if failures else 0) + rc_real


def selftest_real(required=True):
    """The known numbers of a real flight — datasets/landing06, the record whose
    ad-hoc analysis this tool replaces. Counted independently the night it was flown:
    321 tags, 125 events, landing_commit at t=147.636."""
    d = os.path.join(bb.DATASETS, "landing06")
    if not os.path.isdir(d):
        msg = (
            f"real-record checks skipped: no {d} (datasets are not in git; "
            "run from the main checkout, or set BLACKBOX_DATASETS)"
        )
        if required:
            print("FAIL " + msg)
            return 1
        print("\n" + msg)
        return 0
    rec = bb.Record.open("landing06")
    t = rec.t_of("landing_commit")
    checks = [
        (
            "landing06: 321 tags",
            rec.count().get("tag") == 321,
            "got {!r}".format(rec.count().get("tag")),
        ),
        (
            "landing06: 125 events",
            rec.count().get("event") == 125,
            "got {!r}".format(rec.count().get("event")),
        ),
        (
            "landing06: landing_commit at t=147.636",
            t is not None and abs(t - 147.636) < 0.01,
            f"got {t!r}",
        ),
        (
            "landing06: ±2 s window around the commit is non-trivial",
            len(rec.lines(around_event="landing_commit")) > 50,
            "n=%d" % len(rec.lines(around_event="landing_commit")),
        ),
    ]
    if _sql_available():
        # px>=60 counted two independent ways on 2026-07-29: the stdlib --where
        # path and SQL both say 73. NOT 59, and not the trusted-solve population
        # either — landing06 has metric=true on 0 tags, so pixel size and trust
        # are different gates. The check pins the measured 73 AND that both
        # counting paths agree, through the CLI (re-exec included).
        big_where = len(rec.lines(kind="tag", where="px>=60"))
        code, out_s, err = _cli(
            [
                "landing06",
                "--sql",
                "SELECT count(*) n, sum(CASE WHEN px>=60 THEN 1 ELSE 0 END) big FROM tag",
            ]
        )
        m = re.search(r"\b(\d+)\s+(\d+)\b", out_s or "")
        checks.append(
            (
                "landing06: --sql field query (n=321, px>=60 -> 73, both paths agree)",
                code == 0
                and m is not None
                and int(m.group(1)) == 321
                and int(m.group(2)) == 73
                and big_where == 73,
                "where=%d out=%r err=%r" % (big_where, out_s, err),
            )
        )
    else:
        checks.append(
            ("landing06: --sql checks skipped (no duckdb in any reachable interpreter)", True, "")
        )
    failures = 0
    print("\nreal-record checks — datasets/landing06\n")
    for name, ok, note in checks:
        print("{} {}".format("ok  " if ok else "FAIL", name))
        if not ok:
            failures += 1
            print(f"     {note}")
    return 1 if failures else 0


