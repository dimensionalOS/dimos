    )
    code, out_s, _ = _cli([part1, "--events", "--all-events"])
    check("--all-events: the plumbing comes back", "zenoh_phase" in out_s)
    code, out_s, _ = _cli([part1, "--count"])
    check("--count: per kind", re.search(r"12\s+tag", out_s) is not None, out_s)
    code, out_s, _ = _cli([part1, "--count", "-k", "event"])
    check("--count on events: per code", re.search(r"2\s+goto_accepted", out_s) is not None, out_s)
    code, out_s, _ = _cli([part1, "--fields", "t,px,f.vx", "-k", "tag", "--limit", "2"])
    check("--fields: dotted projection, missing -> empty", "0.1" in out_s and "px" in out_s, out_s)
    code, out_s, _ = _cli([part1, "--csv", "-k", "tag", "--limit", "1"])
    check("--csv", out_s.splitlines()[0].startswith("t,k,") if out_s else False, out_s)
    code, out_s, _ = _cli([part1, "--where", "px>1e9"])
    check("no matches exits 1", code == 1, "code=%d" % code)
    code, out_s, err = _cli([part1, os.path.join(tmp, SESSION_B + ".001.jsonl")])
    check(
        "two records without --diff: refused by name",
        code == 2 and "diff" in err,
        "code=%d err=%s" % (code, err),
    )
    code, out_s, err = _cli([part1, "--json", "--fields", "t"])
    check(
        "--json with --fields: refused (raw lines are not to be reshaped)",
        code == 2 and "byte" in err,
        err,
    )

    # ── the SQL escape hatch: fields must be REAL columns, not just bookkeeping ──
    # (count(*) alone once passed while every field query failed — never again.)
    if _sql_available():
        code, out_s, err = _cli(
            [
                part1,
                "--sql",
                "SELECT count(*) n, sum(CASE WHEN px>=60 THEN 1 ELSE 0 END) big FROM tag",
            ]
        )
        # planted px: 50..95 step 5 (eight of them >=60) plus 100 and 101 -> big=10
        check(
            "--sql: JSON fields are real columns (px on tag)",
            code == 0 and re.search(r"\b12\s+10\b", out_s) is not None,
            f"out={out_s!r} err={err!r}",
        )
        code, out_s, err = _cli(
            [part1, "--sql", "SELECT t, code, msg FROM event WHERE code='landing_commit'"]
        )
        check(
            "--sql: t/code/msg on event",
            code == 0 and "height=1.0" in out_s and "12.000" in out_s,
            f"out={out_s!r} err={err!r}",
        )
        # nested + heterogeneous: mav_in rows carry f={type} and f={vx};
        # union-by-name must make f a STRUCT where f.vx reads through.
        code, out_s, err = _cli([part1, "--sql", "SELECT avg(f.vx) vx FROM mav_in"])
        check(
            "--sql: nested STRUCT field f.vx across heterogeneous rows",
            code == 0 and re.search(r"\b100\b", out_s) is not None,
            f"out={out_s!r} err={err!r}",
        )
    else:
        check("--sql field checks skipped (no duckdb in any reachable interpreter)", True)

    # ── diffing ──
    rb = bb.Record.open(os.path.join(tmp, SESSION_B + ".001.jsonl"))
    ops = bb.diff_events(rec, rb)
    minus = [a["code"] for op, a, _ in ops if op == "-"]
    plus = [b["code"] for op, _, b in ops if op == "+"]
    check(
        "diff_events: exactly the planted divergence",
        minus == ["goto_accepted"] and plus == ["tag_descent_denied"],
        f"minus={minus!r} plus={plus!r}",
    )
    dts = [a["dt"] for op, a, _ in ops if op == " " and a["code"] == "landing_commit"]
    check(
        "diff_events: dt is since the previous curated event, per record",
        dts and abs(dts[0] - 2.0) < 1e-6,
        f"dt={dts!r}",
    )
    d = bb.diff_counts(rec, rb)
    ec = {k: (na, nb) for k, na, nb in d["event_code"]}
    check(
        "diff_counts: the same divergence in numbers",
        ec.get("goto_accepted") == (2, 1) and ec.get("tag_descent_denied") == (0, 1),
        f"ec={ec!r}",
    )

    # ── the phone, behind a fake phoneadb ──
    pdir, fake = _plant_phone(tmp)
    log = os.path.join(tmp, "fake.log")
    os.environ["BLACKBOX_PHONEADB"] = fake
    os.environ["FAKE_PHONE_DIR"] = pdir
    os.environ["FAKE_LOG"] = log
    os.environ.pop("FAKE_TRUNCATE", None)
    try:
        phone = bb.Phone()
        serial = phone.attach()
        check(
            "phone: serial pinned to the 10.55.1.15 transport, not mDNS",
            serial == "10.55.1.15:39999",
            serial,
        )
        sessions = phone.sessions()
        check(
            "phone ls: grouped, sized, stub marked",
            set(sessions) == {PHONE_FLIGHT, PHONE_STUB}
            and sessions[PHONE_FLIGHT].jsonl_bytes == 600
            and sessions[PHONE_FLIGHT].video_bytes == 5000
            and not sessions[PHONE_FLIGHT].likely_ground_stub
            and sessions[PHONE_STUB].likely_ground_stub,
            "%r" % {k: (s.jsonl_bytes, s.video_bytes) for k, s in sessions.items()},
        )
        check(
            "phone: pinned serial rides every later call",
            "SERIAL=10.55.1.15:39999" in open(log).read(),
        )
        check("phone: latest = newest prefix", phone.latest() == PHONE_STUB)

        dest = os.path.join(tmp, "pulled")
        buf = io.StringIO()
        bb.pull_session(phone, PHONE_FLIGHT, dest, out=buf)
        pulled = sorted(os.listdir(dest))
        check(
            "pull: all parts + sidecars, sizes verified, memexport pointed at",
            pulled
            == sorted(
                [
                    PHONE_FLIGHT + ".001.jsonl",
                    PHONE_FLIGHT + ".002.jsonl",
                    PHONE_FLIGHT + ".v001.h264",
                ]
            )
            and "memexport" in buf.getvalue(),
