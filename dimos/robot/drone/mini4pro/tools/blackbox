        and not g[SESSION_A].likely_ground_stub
        and g[SESSION_B].likely_ground_stub,
    )
    try:
        bb.resolve(tmp)
        check("two sessions in one dir: refused by name", False, "no refusal")
    except bb.Refusal as e:
        check(
            "two sessions in one dir: refused by name",
            SESSION_A in str(e) and SESSION_B in str(e),
            str(e),
        )

    # ── selection ──
    q = rec.query(around_event="landing_commit")
    check(
        "--around-event: ±2 s around the commit's own t",
        [r["t"] for r in q] == [10.0, 11.5, 12.0, 13.9],
        "got %r" % [r["t"] for r in q],
    )
    q = rec.query(around_event="goto_accepted", nth=1, window=0.5)
    check(
        "--around-event --nth 1: the second occurrence",
        len(q) == 1 and q[0].get("msg") == "second",
        f"got {list(q)!r}",
    )
    try:
        rec.query(around_event="never_happened")
        check("--around-event unknown code: refused by name", False, "no refusal")
    except bb.Refusal as e:
        check("--around-event unknown code: refused by name", "never_happened" in str(e), str(e))
    q = rec.query(code="landing_commit")
    check("--code implies -k event", len(q) == 1 and q[0]["k"] == "event", f"got {list(q)!r}")
    q = rec.query(name="HEARTBEAT")
    check(
        "--name implies mav_in+mav_out",
        len(q) == 2 and {r["k"] for r in q} == {"mav_in", "mav_out"},
    )
    q = rec.query(kind="tag", where="px>60 and margin>100")
    check(
        "--where: planted subset, missing field never matches",
        len(q) == 8 and all(r["px"] > 60 for r in q) and all(r.get("margin", 0) > 100 for r in q),
        "n=%d" % len(q),
    )
    q = rec.query(kind="tag", where="f.vx > 0.55")
    check(
        "--where: dotted f.vx reaches nested fields",
        [r["px"] for r in q] == [80, 85, 90, 95],
