FRAME_FORMAT = "mini4pro-zenohframes-1"
RECORD_FORMAT = "mini4pro-flightlog-1"

# ─────────────────────────────────────────────────────────────────────────────
# The catalogue. `docs/zenoh-topics.md` is the prose; this is the machine copy,
# and the two are checked against each other by `--keys` being readable next to it.
#
# QoS names are DiMOS's own (`protocol/pubsub/impl/zenohpubsub.py:72-74`):
#   NEVER_DROP  = reliable + block      LATEST_WINS = best_effort + drop
#   None        = zenoh's publisher defaults, which are reliable + drop.
#
# Note what is NOT here: DiMOS assigns NEVER_DROP by *channel name* and its list is
# ("human_input", "agent", "agent_idle", "command") matched against the name with the
# prefix already stripped. Our channel is `drone/command`, not `command`, so that rule
# does not fire and the QoS below is a decision this side has to make explicitly. See
# the contract doc.
# ─────────────────────────────────────────────────────────────────────────────

NEVER_DROP = "NEVER_DROP"
LATEST_WINS = "LATEST_WINS"

# channel -> (lcm type, qos, carried by a frames file?)
# `datum` was here until 2026-07-27, as a NEVER_DROP `sensor_msgs.NavSatFix`. It is
# deleted, not deprecated in place: the origin it announced is recoverable by subtracting
# `pose` from `gps_location`, and a message restating a derivable fact is a message that
# can disagree with it. `docs/zenoh-frames-and-paths.md`.
CATALOGUE = {
    "odom": ("nav_msgs.Odometry", None, True),
    "pose": ("geometry_msgs.PoseStamped", None, True),
    "gps_location": ("sensor_msgs.NavSatFix", None, True),
    "imu": ("sensor_msgs.Imu", None, True),
    "battery": ("sensor_msgs.BatteryState", None, True),
    "mode": ("std_msgs.String", None, True),
    # Never in a replay: gimbal attitude is not in AircraftState and no recorder line
    # carries it, so a flight record never says where the camera was pointing
    # (`zenohreplay --coverage`). The live bridge publishes it; a replay cannot.
    "gimbal": ("geometry_msgs.Vector3", None, False),
    # Published by the bridge, but a flight record carries no reason column for them
    # and `zenohreplay` therefore does not encode them. Listed so the key set a
    # subscriber sees from a replay is honestly a subset of the live one, not a
    # different one.
    "status": ("std_msgs.String", NEVER_DROP, False),
    "health": ("std_msgs.String", NEVER_DROP, False),
    "command_ack": ("std_msgs.String", NEVER_DROP, False),
    # 2026-07-29: the tag's world-frame belief and the commanded velocity. Published live
    # (and derived offline by tools/memexport from `tag`/`stick_cmd` lines); `zenohreplay`
    # does not encode them — a fix and a stick command are not AircraftStates — so no
    # frames file carries them and a replayed key set stays an honest subset of the live one.
    "tag_fix": ("vision_msgs.Detection3DArray", None, False),
    "setpoint": ("geometry_msgs.TwistStamped", None, False),
    # 2026-07-30: DJI's own wind estimate, m/s, as a bare Float32. Published live on key
    # delivery (change-driven — silence means UNCHANGED, not stale) and derived offline by
    # tools/memexport from `dji_field` windSpeedDmS lines; `zenohreplay` does not encode it —
    # a key delivery is not an AircraftState, deliberately, so a replayed key set stays an
    # honest subset of the live one.
    "wind": ("std_msgs.Float32", None, False),
}

# The frame tree, `docs/mem2-converter.md` §2. Named here because `--selftest` asserts
# them off decoded frames; the encoding itself is `zenohreplay`'s, and these two must not
# become a second opinion about it.
FRAME_WORLD = "drone/world"
FRAME_BASE_LINK = "drone/base_link"

# `header.frame_id` per channel. `odom` and `pose` are in the local frame; `gps_location`,
# `imu` and `battery` are stamped with the sensor's own body frame, which is the ROS
# convention and the reason an Imu's orientation is a rotation *into* drone/world.
FRAME_EXPECTED = {
    "odom": FRAME_WORLD,
    "pose": FRAME_WORLD,
    "gps_location": FRAME_BASE_LINK,
    "imu": FRAME_BASE_LINK,
    "battery": FRAME_BASE_LINK,
}

DEFAULT_PREFIX = "dimos/drone"
DEFAULT_ROUTER = "10.55.1.50:7447"  # hyper1 — see docs/zenoh-dimos-transport.md 2.6
ZENOH_PORT = 7447
# `--local`'s private loopback bus. Deliberately not 7447: on this laptop that port
# already belongs to an unrelated zenoh router, and a replay must not join a bus it
# was not pointed at.
LOCAL_ENDPOINT = "tcp/127.0.0.1:7452"


def key_expr(prefix, channel):
    """`<prefix>/<channel>/<pkg>.<Type>` — DiMOS's own shape, dot before the type."""
    return f"{prefix}/{channel}/{CATALOGUE[channel][0]}"


# ─────────────────────────────────────────────────────────────────────────────
# Interpreter. zenoh lives wherever eclipse-zenoh was installed, which on this
# machine is DiMOS's venv — the same interpreter that has DiMOS's decoders, so it
# is also the one that can prove a frame arrived correctly.
# ─────────────────────────────────────────────────────────────────────────────

CANDIDATE_PYTHONS = [
    os.environ.get("ZENOHPUBLISH_PYTHON"),
    os.path.expanduser("~/coding/dimos/.venv/bin/python"),
]


def ensure_zenoh(reexec=True):
    """Import zenoh, re-execing under an interpreter that has it if this one does not.

    Explicit and noisy rather than clever: it prints which interpreter it moved to,
    because "the tool silently ran as something else" is its own class of bug.
    """
    try:
        import zenoh  # noqa: F401

        return
    except ImportError:
        pass
    if reexec:
        for cand in CANDIDATE_PYTHONS:
            if not cand or not os.path.exists(cand):
                continue
            if os.path.realpath(cand) == os.path.realpath(sys.executable):
                continue
            probe = os.system(f"{cand} -c 'import zenoh' 2>/dev/null")
            if probe == 0:
                sys.stderr.write(f"zenohpublish: no zenoh here; re-exec under {cand}\n")
                os.execv(cand, [cand, os.path.abspath(__file__), *sys.argv[1:]])
    sys.stderr.write(
        "zenohpublish: eclipse-zenoh is not importable.\n"
        "  DiMOS pins zenoh 1.x and its venv already has it:\n"
        "    ~/coding/dimos/.venv/bin/python tools/zenohpublish ...\n"
        "  or make one:\n"
        "    uv venv .venv && uv pip install eclipse-zenoh==1.9.0\n"
        "  or point ZENOHPUBLISH_PYTHON at an interpreter that has it.\n"
    )
    sys.exit(2)


# ─────────────────────────────────────────────────────────────────────────────
# Decoders — DiMOS's own, so that "it decoded" means DiMOS can read it
# ─────────────────────────────────────────────────────────────────────────────


def load_decoders(dimos_lcm):
    """`{lcm type name: class}` from DiMOS itself, falling back to the raw bindings.

    Two sources, deliberately in this order. `dimos.msgs` is what a DiMOS consumer
    actually calls, so a decode there is the real acceptance test. The generated
    `lcm_msgs` package under `dimos-lcm` is what `zenohreplay` encoded with, and is
    the fallback for a machine that has the bindings but not DiMOS.
    """
    types = sorted({t for t, _, _ in CATALOGUE.values()})
    try:
        from dimos.msgs.helpers import resolve_msg_type

        out = {}
        for name in types:
            cls = resolve_msg_type(name)
            if cls is None:
                raise ImportError(f"dimos cannot resolve {name}")
            out[name] = cls
        return out, "dimos.msgs (DiMOS's own consumer path)"
    except ImportError:
        pass
    root = os.path.join(os.path.expanduser(dimos_lcm), "generated", "python_lcm_msgs")
    if os.path.isdir(os.path.join(root, "lcm_msgs")):
        sys.path.insert(0, root)
        try:
            out = {}
            for name in types:
                pkg, cls = name.split(".")
                out[name] = getattr(importlib.import_module(f"lcm_msgs.{pkg}.{cls}"), cls)
            return out, f"lcm_msgs under {root}"
        except ImportError:
            pass
    return None, None


def set_stamp(msg, unix_s):
    """Move a message's header stamp to `unix_s`. True if there was one to move."""
    if hasattr(msg, "ts"):
        msg.ts = unix_s
        return True
    header = getattr(msg, "header", None)
    stamp = getattr(header, "stamp", None)
    if stamp is None:
        return False
    stamp.sec = math.floor(unix_s)
    stamp.nsec = round((unix_s - math.floor(unix_s)) * 1e9)
    return True


# ─────────────────────────────────────────────────────────────────────────────
# The frames file
# ─────────────────────────────────────────────────────────────────────────────


class Frames:
    def __init__(self, header, rows, path):
        self.header = header
        self.rows = rows
        self.path = path

    @property
    def span(self):
        return (self.rows[-1]["t"] - self.rows[0]["t"]) if len(self.rows) > 1 else 0.0

    def counts(self):
        return collections.Counter(r["ch"] for r in self.rows)


def encode_record(path):
    """A raw flight record in, a frames file out — by running `zenohreplay`, not by
    reimplementing it.

    Added 2026-07-27 after Ivan asked the obvious question: *"shouldn't this read the raw
    recording directly?"* It should. Requiring a frames file made the user learn an
    intermediate format that exists for our convenience, and the tool answered a raw record
    with homework rather than doing it.

    **It shells out rather than importing.** `zenohreplay` is where every encoding decision
    lives — the two gates, the origin, the ENU conversion — and there must be exactly one
    of each. Importing a sibling script by path is fragile, and copying any of it would create
    a second encoder that drifts. A subprocess costs a temp file and a second of wall clock,
    and it guarantees these two tools can never disagree about what a flight would have
    published, which is the only property that matters here.

    `--frames` is still there for when the intermediate is what you want: diffing it between
    builds, counting it, decoding one line by hand.
    """
    replay = os.path.join(os.path.dirname(os.path.abspath(__file__)), "zenohreplay")
    if not os.path.exists(replay):
        raise SystemExit(f"cannot encode {path}: {replay} is missing")
    fd, out = tempfile.mkstemp(prefix="zenohframes-", suffix=".jsonl")
    os.close(fd)
    atexit.register(lambda: os.path.exists(out) and os.unlink(out))
    sys.stderr.write(f"encoding {path} with zenohreplay ...\n")
    r = subprocess.run([sys.executable, replay, path, "--frames", out], stdout=subprocess.DEVNULL)
    if r.returncode != 0:
        raise SystemExit("zenohreplay failed on %s (exit %d)" % (path, r.returncode))
    return out


def as_frames_path(path):
    """Return a frames path for [path], encoding it first if it is a raw record."""
    try:
        with open(path) as fh:
            header = json.loads(fh.readline())
    except (OSError, ValueError):
        return path  # read_frames reports it properly
    return encode_record(path) if header.get("format") == RECORD_FORMAT else path


def read_frames(path, start=None, end=None):
    try:
        fh = open(path)
    except OSError as e:
        raise SystemExit(
            f"cannot read {path}: {e.strerror}\n"
            "  This wants a frames file, which is made offline:\n"
            f"    tools/zenohreplay <flight>.jsonl --frames {path}"
        )
    with fh:
        first = fh.readline()
        try:
            header = json.loads(first)
        except ValueError:
            raise SystemExit(f"{path}: first line is not a {FRAME_FORMAT} header")
        if header.get("format") != FRAME_FORMAT:
            extra = ""
            if header.get("format") == RECORD_FORMAT:
                # Should be unreachable: encode_record() converts a raw record before we get
                # here. Kept so a future path that skips it fails with an instruction rather
                # than a type error.
                extra = (
                    "\n  That is a raw flight record. Encode it first:\n"
                    f"    tools/zenohreplay {path} --frames out.jsonl"
                )
            raise SystemExit(
                "{}: format is {!r}, expected {!r} — this reads what "
                "`zenohreplay --frames` writes.{}".format(
                    path, header.get("format"), FRAME_FORMAT, extra
                )
            )
        rows = []
        for line in fh:
            line = line.strip()
            if not line:
                continue
            r = json.loads(line)
            if start is not None and r["t"] < start:
                continue
            if end is not None and r["t"] > end:
                break
            if r["ch"] not in CATALOGUE:
                raise SystemExit(
                    "{}: unknown channel {!r} — the catalogue here and the "
                    "one in zenohreplay have diverged".format(path, r["ch"])
                )
            r["raw"] = bytes.fromhex(r["hex"])
            if len(r["raw"]) != r["len"]:
                raise SystemExit(
                    "%s: frame at t=%s says len %d but carries %d bytes"
                    % (path, r["t"], r["len"], len(r["raw"]))
                )
            rows.append(r)
    if not rows:
        raise SystemExit(f"{path}: no frames in the selected window")
    return Frames(header, rows, path)


