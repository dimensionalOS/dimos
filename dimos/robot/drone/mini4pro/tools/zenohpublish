def print_keys(prefix):
    print(f"Zenoh key expressions — docs/zenoh-topics.md, prefix {prefix}\n")
    print("  %-52s %-24s %s" % ("key expression", "QoS", "replayable"))
    for ch, (_typ, qos, in_frames) in CATALOGUE.items():
        print(
            "  %-52s %-24s %s"
            % (
                key_expr(prefix, ch),
                qos or "default (reliable, drop)",
                "yes" if in_frames else "no",
            )
        )
    print()
    print("`replayable` is whether zenohreplay encodes the channel from a")
    print("mini4pro-flightlog-1 record. The four `no`s are limits of the derivation rather")
    print("than of the recording: status/health/command_ack are recorded as `event` lines")
    print("and not yet reconstructed, and the gimbal edge needs the COMMANDED angle, which")
    print("no record carries because MsdkGimbalAim does not go through DjiCalls.")
    print()
    print("Frames, docs/mem2-converter.md 2 — checked off decoded bytes by --selftest:")
    print(f"  odom, pose               header.frame_id  {FRAME_WORLD}")
    print(f"  odom                     child_frame_id   {FRAME_BASE_LINK}")
    print(f"  gps_location, imu, battery                {FRAME_BASE_LINK}")
    print("  drone/camera, drone/camera_optical        the tf tree's leaves, not published")
    print("                                            by anything here yet")
    print()
    print("There is no `datum` channel. A subscriber recovers where 0,0,0 is by")
    print("subtracting pose from gps_location over samples carrying both, which is what")
    print("--selftest does. docs/zenoh-frames-and-paths.md is the argument.")
    print()
    print("Two rows this table and docs/zenoh-topics.md disagree about, stated rather than")
    print("silently reconciled: that doc retires `gimbal` in favour of a `tf` edge and adds")
    print("`tf` and `video`. The Kotlin encoder still has `gimbal` and neither it nor")
    print("zenohreplay produces `tf`, so this table follows the encoder. When the encoder")
    print("moves, this moves with it.")
    print()
    print("QoS names are DiMOS's (protocol/pubsub/impl/zenohpubsub.py):")
    print("  NEVER_DROP  reliable + block      LATEST_WINS  best_effort + drop")
    print("  default     reliable + drop  (zenoh's own publisher defaults)")
    print()
    print("QoS is a publisher-side property; a subscriber cannot ask for it and cannot")
    print("tell what it was. It is in the contract because the Android publisher must")
    print("set the same values, not because anything downstream can check.")
    return 0


def main():
    ap = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    ap.add_argument("frames", nargs="*", help="a frames file from `zenohreplay --frames`")
    ap.add_argument(
        "--prefix", default=DEFAULT_PREFIX, help=f"key prefix (default {DEFAULT_PREFIX})"
    )

    g = ap.add_argument_group("where the bus is")
    g.add_argument(
        "--router",
        default=DEFAULT_ROUTER,
        help=f"router to dial, host[:port] (default {DEFAULT_ROUTER} — hyper1)",
    )
    g.add_argument(
        "--connect",
        action="append",
        default=[],
        help="dial this endpoint instead of the router; repeatable",
    )
    g.add_argument(
        "--listen", action="append", default=[], help="also listen on this endpoint; repeatable"
    )
    g.add_argument(
        "--local",
        action="store_true",
        help="dial nothing: a plain peer, for a laptop with nothing else running",
    )
    g.add_argument(
        "--mode",
        default="peer",
        choices=["peer", "client", "router"],
        help="zenoh session mode (default peer, matching DiMOS)",
    )
    g.add_argument(
        "--no-scouting", action="store_true", help="disable multicast and gossip discovery"
    )

    g = ap.add_argument_group("timing")
    g.add_argument(
        "--speed",
        type=float,
        default=1.0,
        help="timeline multiplier; 0 means as fast as possible (default 1)",
    )
    g.add_argument("--start", type=float, help="skip to this many seconds into the flight")
    g.add_argument("--end", type=float, help="stop at this many seconds")
    g.add_argument("--loop", action="store_true", help="replay for ever")
    g.add_argument(
        "--loop-gap", type=float, default=2.0, help="seconds of silence between passes (default 2)"
    )
    g.add_argument(
        "--restamp",
        action="store_true",
        help="rewrite header stamps to live wall clock (re-encodes; off by default)",
    )

    g = ap.add_argument_group("modes")
    g.add_argument("--spy", action="store_true", help="subscribe and decode instead of publishing")
    g.add_argument(
        "--echo",
        action="append",
        default=[],
        metavar="CH",
        help="in --spy, print every message on this channel; repeatable",
    )
    g.add_argument("--for-seconds", type=float, help="in --spy, stop after this long")
    g.add_argument(
        "--selftest", action="store_true", help="publish, subscribe and decode in one process"
    )
    g.add_argument(
        "--selftest-frames",
        type=int,
        default=800,
        help="how many frames the selftest sends (default 800)",
    )
    g.add_argument("--selftest-port", type=int, default=7887)
    g.add_argument("--keys", action="store_true", help="print the key expressions and exit")

    g = ap.add_argument_group("noise")
    g.add_argument(
        "--status-every", type=float, default=5.0, help="seconds between progress lines (default 5)"
    )
    g.add_argument("--quiet", action="store_true", help="no progress lines")
    g.add_argument(
        "--dimos-lcm",
        default="~/coding/dimos-lcm",
        help="dimos-lcm checkout, for decoding without DiMOS installed",
    )
    g.add_argument(
        "--no-reexec",
        action="store_true",
        help="fail rather than re-exec under an interpreter that has zenoh",
    )
    args = ap.parse_args()

    for ch in args.echo:
        if ch not in CATALOGUE:
            ap.error("--echo {}: not a channel. Try one of: {}".format(ch, ", ".join(CATALOGUE)))

    if args.keys:
        return print_keys(args.prefix)

    ensure_zenoh(reexec=not args.no_reexec)

    paths = []
    for p in args.frames:
        matched = sorted(glob.glob(p))
        paths.extend(matched if matched else [p])

    if args.spy:
        if paths:
            ap.error("--spy takes no frames file; it listens for one being published")
        session = open_session(args, "spy session", listening=True)
        print()
        try:
            return spy(args, session)
        finally:
            session.close()

    if len(paths) != 1:
        ap.error("give exactly one flight record or frames file, or --spy")
    frames = read_frames(as_frames_path(paths[0]), args.start, args.end)

    if args.selftest:
        describe_frames(frames, args)
        return selftest(args, frames)

    describe_frames(frames, args)
    session = open_session(args, "publish session", listening=False)
    print()
    try:
        return publish(args, frames, session)
    finally:
        session.close()


if __name__ == "__main__":
    sys.exit(main())
