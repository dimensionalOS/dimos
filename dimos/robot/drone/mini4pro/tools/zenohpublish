# The session
# ─────────────────────────────────────────────────────────────────────────────


def endpoint(spec):
    """`host`, `host:port` or a full `proto/host:port` -> a zenoh endpoint."""
    if "/" in spec:
        return spec
    return "tcp/%s" % (spec if ":" in spec else "%s:%d" % (spec, ZENOH_PORT))


def open_session(args, what, listening):
    """Open a zenoh session exactly the way DiMOS opens one.

    `ZenohSessionPool.acquire` builds a bare `zenoh.Config()` and inserts mode,
    connect/endpoints and listen/endpoints as JSON5. Mirrored rather than
    reimplemented so that "it works here" transfers to "it works there".

    `--local` is a loopback bus on its own port rather than multicast scouting, for
    two reasons: this project's AP filters multicast between wifi clients, which is
    what made DiMOS stop trusting scouting in the first place; and port 7447 on a
    developer machine is not necessarily free — on this laptop it belongs to an
    unrelated zenoh router, and a replay that quietly joins someone else's bus is a
    worse failure than one that does not start.
    """
    import zenoh

    connect = [endpoint(e) for e in args.connect]
    listen = [endpoint(e) for e in args.listen]
    if args.local and not connect and not listen:
        if listening:
            listen = [LOCAL_ENDPOINT]
        else:
            connect = [LOCAL_ENDPOINT]
    if not connect and not listen and not args.local:
        connect = [endpoint(args.router)]

    cfg = zenoh.Config()
    cfg.insert_json5("mode", json.dumps(args.mode))
    if connect:
        cfg.insert_json5("connect/endpoints", json.dumps(connect))
    if listen:
        cfg.insert_json5("listen/endpoints", json.dumps(listen))
    if args.no_scouting or args.local:
        cfg.insert_json5("scouting/multicast/enabled", "false")
        cfg.insert_json5("scouting/gossip/enabled", "false")
    session = zenoh.open(cfg)
    print(f"{what}   mode {args.mode}")
    print("  connect      %s" % (", ".join(connect) or "— (nothing dialled)"))
    print("  listen       %s" % (", ".join(listen) or "— (zenoh's defaults)"))
    if args.local:
        print("  scouting     off — a two-process loopback bus, no router, no multicast")
    elif not connect and not listen:
        print("               relying on multicast scouting, which this project's AP")
        print("               is known to filter between wifi clients. Fine on one host.")
    return session


def qos_kwargs(qos):
    import zenoh

    if qos == NEVER_DROP:
        return {
            "reliability": zenoh.Reliability.RELIABLE,
            "congestion_control": zenoh.CongestionControl.BLOCK,
        }
    if qos == LATEST_WINS:
        return {
            "reliability": zenoh.Reliability.BEST_EFFORT,
            "congestion_control": zenoh.CongestionControl.DROP,
        }
    return {}


