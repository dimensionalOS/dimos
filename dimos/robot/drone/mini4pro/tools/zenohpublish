# Spy — the other half of the proof
# ─────────────────────────────────────────────────────────────────────────────


def digest(ch, msg):
    """One line a human can check against the flight. Never a repr().

    DiMOS's own `Vector3.__str__` raises on NaN (`geometry_msgs/Vector3.py:158`,
    `int(NaN)`), and this bridge publishes NaN deliberately wherever a quantity is
    not reported. So printing a decoded Imu or Odometry the obvious way crashes,
    and every field this prints is reached explicitly.
    """
    try:
        if ch == "gps_location":
            return "{}  {:.7f}, {:.7f}  alt {:.2f}  status {}".format(
                frame_of(msg) or "?",
                msg.latitude,
                msg.longitude,
                msg.altitude,
                msg.status,
            )
        if ch == "odom":
            p = msg.position
            return f"{frame_of(msg)}->{msg.child_frame_id}  x {p[0]:.2f} y {p[1]:.2f} z {p[2]:.2f}"
        if ch == "pose":
            p = msg.position
            return f"{frame_of(msg)}  x {p[0]:.2f} y {p[1]:.2f} z {p[2]:.2f}"
        if ch == "imu":
            q = msg.orientation
            return f"{frame_of(msg)}  quat {q[0]:.3f} {q[1]:.3f} {q[2]:.3f} {q[3]:.3f}"
        if ch == "battery":
            return f"{msg.percentage * 100.0:.0f}%  {msg.voltage:.2f} V  {msg.temperature:.1f} C"
        if ch in ("mode", "status", "health", "command_ack"):
            return repr(msg.data)
        if ch == "gimbal":
            return f"pitch {msg.x:.1f}"
    except Exception as e:
        return f"decoded, but this tool cannot render it: {e!r}"
    return "decoded"


def fmt_age(seconds):
    """How far behind wall clock a header stamp is, in a unit a human can read.

    `-` means the stamp is in the future, which is a real thing to see: two machines
    whose clocks disagree, or a --restamp against a clock that is not this one.
    """
    sign = "-" if seconds < 0 else ""
    s = abs(seconds)
    if s < 90:
        return f"{sign}{s:.1f}s"
    if s < 5400:
        return f"{sign}{s / 60.0:.1f}m"
    return f"{sign}{s / 3600.0:.1f}h"


# `telemetry/Geo`'s constant, and `zenohreplay`'s. Duplicated on purpose: recovering the
# origin below is a *consumer's* derivation, and a check that imports the code under test
# proves only that the code agrees with itself.
METRES_PER_DEG = 111194.93


def enu_metres(from_lat, from_lon, to_lat, to_lon):
    """ENU offset in metres as (east, north)."""
    north = (to_lat - from_lat) * METRES_PER_DEG
    east = (to_lon - from_lon) * METRES_PER_DEG * math.cos(math.radians(from_lat))
    return east, north


def xy_of(msg):
    """A pose's local (east, north) metres, whichever binding decoded it, or None.

    `dimos.msgs` flattens `position` onto the message as an indexable vector; the generated
    `lcm_msgs` classes nest it one level for `PoseStamped` and two for `Odometry`.
    """
    p = getattr(msg, "position", None)
    if p is None:
        pose = getattr(msg, "pose", None)
        p = getattr(pose, "position", None) if pose is not None else None
        if p is None and pose is not None:
            p = getattr(getattr(pose, "pose", None), "position", None)
    if p is None:
        return None
    if hasattr(p, "x"):
        return float(p.x), float(p.y)
    return float(p[0]), float(p[1])


def recover_origin(poses, fixes):
    """Where `drone/world`'s 0,0,0 is, from the two channels that both describe it.

    **This is the arithmetic that replaced the deleted `datum` message**, and it is a
    subscriber's first act rather than ours: `pose` and `gps_location` are the same
    measurement expressed two ways — GPS, and GPS minus a constant — so subtracting them
    over any set of samples carrying both gives the constant back, from every sample rather
    than from the one instant a message would have named.

    The projection is inverted exactly: the encoder takes `cos(latitude)` at the *origin*,
    so this recovers the latitude first and takes the cosine there. `docs/mem2-converter.md`
    quotes a 4.4 µm residual, which is what taking the cosine at each sample's own latitude
    costs; doing it this way the residual is floating-point noise.

    Returns `((lat, lon), worst separation in metres)`, or `(None, 0.0)`.
    """
    recovered = []
    for ts in sorted(set(poses) & set(fixes)):
        east, north = poses[ts]
        lat, lon = fixes[ts]
        lat0 = lat - north / METRES_PER_DEG
        c = math.cos(math.radians(lat0))
        if c == 0.0:
            continue
        recovered.append((lat0, lon - east / (METRES_PER_DEG * c)))
    if not recovered:
        return None, 0.0
    mean_lat = sum(a for a, _ in recovered) / len(recovered)
    mean_lon = sum(b for _, b in recovered) / len(recovered)
    worst = 0.0
    for lat, lon in recovered:
        de, dn = enu_metres(mean_lat, mean_lon, lat, lon)
        worst = max(worst, math.hypot(de, dn))
    return (mean_lat, mean_lon), worst


def frame_of(msg):
    """A decoded message's `header.frame_id`, whichever binding produced it.

    `dimos.msgs` flattens the header onto the message; the generated `lcm_msgs` classes
    keep it nested. Both are loadable here (see `load_decoders`), so both are reached.
    """
    if hasattr(msg, "frame_id"):
        return msg.frame_id
    header = getattr(msg, "header", None)
    return getattr(header, "frame_id", None)


def stamp_of(msg):
    if hasattr(msg, "ts"):
        return msg.ts
    h = getattr(msg, "header", None)
    s = getattr(h, "stamp", None)
    if s is None:
        return None
    return s.sec + s.nsec / 1e9


class Spy:
    def __init__(self, decoders, echo=()):
        self.decoders = decoders
        self.echo = set(echo)
        self.lock = threading.Lock()
        self.count = collections.Counter()
        self.bytes = collections.Counter()
        self.failed = collections.Counter()
        self.last = {}
        self.last_at = {}
        # now-minus-header-stamp. The column that makes "this is a three-hour-old
        # recording" visible, and the only way to see that --restamp did anything.
        self.last_skew = {}
        self.first_at = None
        self.started = time.time()
        self.unknown = collections.Counter()
        # --echo collapses consecutive identical renderings. `mode` sits on one word
        # for a thousand messages and then changes, and the change is the whole point;
        # a thousand identical lines hide it. `odom` never repeats, so nothing is lost.
        self.echoed = {}
        self.repeats = collections.Counter()

    def on_sample(self, sample):
        key = str(sample.key_expr)
        data = sample.payload.to_bytes()
        ch = self.channel_of(key)
        now = time.time()
        with self.lock:
            if self.first_at is None:
                self.first_at = now
            if ch is None:
                self.unknown[key] += 1
                return
            self.count[ch] += 1
            self.bytes[ch] += len(data)
            self.last_at[ch] = now
        cls = self.decoders[CATALOGUE[ch][0]] if self.decoders else None
        if cls is None:
            return
        try:
            msg = cls.lcm_decode(data)
        except Exception as e:
            with self.lock:
                self.failed[ch] += 1
                self.last[ch] = f"DECODE FAILED: {e!r}"
            return
        line = digest(ch, msg)
        stamp = stamp_of(msg)
        with self.lock:
            self.last[ch] = line
            self.last_skew[ch] = None if stamp is None else now - stamp
            if ch not in self.echo:
                return
            if self.echoed.get(ch) == line:
                self.repeats[ch] += 1
                return
            repeats = self.repeats.pop(ch, 0)
            self.echoed[ch] = line
        if repeats:
            print("  %-14s ... and %d more the same" % (ch, repeats))
        print("  %-14s %s" % (ch, line))

    @staticmethod
    def channel_of(key):
        parts = key.split("/")
        if len(parts) < 2:
            return None
        ch = parts[-2]
        return ch if ch in CATALOGUE else None

    def table(self, prefix):
        with self.lock:
            if not self.count and not self.unknown:
                print("  (nothing yet)")
                return
            now = time.time()
            print(
                "  %-14s %7s %9s %7s %9s  %s"
                % ("channel", "msgs", "bytes", "age", "stamped", "last value")
            )
            for ch in CATALOGUE:
                n = self.count.get(ch, 0)
                if not n:
                    continue
                age = now - self.last_at[ch]
                skew = self.last_skew.get(ch)
                stamped = "—" if skew is None else fmt_age(skew)
                bad = "  (%d UNDECODABLE)" % self.failed[ch] if self.failed.get(ch) else ""
                print(
                    "  %-14s %7d %9d %6.1fs %9s  %s%s"
                    % (ch, n, self.bytes[ch], age, stamped, self.last.get(ch, "-"), bad)
                )
            for key, n in self.unknown.most_common():
                print("  UNKNOWN KEY   %7d            %s" % (n, key))


def spy(args, session):
    decoders, source = load_decoders(args.dimos_lcm)
    if decoders is None:
        print("no LCM bindings found — this will count bytes but cannot prove them.")
        print("  Point --dimos-lcm at the dimos-lcm checkout, or run under a")
        print("  interpreter that has DiMOS importable.")
    else:
        print(f"decoding     with {source}")
    pattern = f"{args.prefix}/**"
    print(f"subscribed   {pattern}")
    print()
    s = Spy(decoders, echo=args.echo)
    sub = session.declare_subscriber(pattern, s.on_sample)
    deadline = time.time() + args.for_seconds if args.for_seconds else None
    try:
        while deadline is None or time.time() < deadline:
            time.sleep(args.status_every)
            print("t+%.0fs listening" % (time.time() - s.started))
            s.table(args.prefix)
    except KeyboardInterrupt:
        print()
    finally:
        sub.undeclare()
    print()
    print("totals")
    s.table(args.prefix)
    total = sum(s.count.values())
    if not total:
        print()
        print("NOTHING ARRIVED. That is a real answer, and usually one of:")
        print("  - the publisher and this spy dialled different endpoints")
        print("  - the router is not up (try: nc -vz {})".format(DEFAULT_ROUTER.replace(":", " ")))
        print(f"  - --prefix differs between the two (this one: {args.prefix})")
        return 1
    if sum(s.failed.values()):
        print()
        print("SOME FRAMES DID NOT DECODE — arrival is not proof; this is the proof.")
        return 1
    return 0


# ─────────────────────────────────────────────────────────────────────────────
# Selftest — publish, subscribe, decode, and check the values, in one process
# ─────────────────────────────────────────────────────────────────────────────


def selftest(args, frames):
    import zenoh

    decoders, source = load_decoders(args.dimos_lcm)
    if decoders is None:
        print("selftest cannot run: no LCM bindings. Arrival alone proves only the socket.")
        return 1
    print(f"decoding     with {source}")

    port = args.selftest_port
    sub_cfg = zenoh.Config()
    sub_cfg.insert_json5("mode", '"peer"')
    sub_cfg.insert_json5("listen/endpoints", json.dumps(["tcp/127.0.0.1:%d" % port]))
    sub_cfg.insert_json5("scouting/multicast/enabled", "false")
    sub_cfg.insert_json5("scouting/gossip/enabled", "false")
    pub_cfg = zenoh.Config()
    pub_cfg.insert_json5("mode", '"peer"')
    pub_cfg.insert_json5("connect/endpoints", json.dumps(["tcp/127.0.0.1:%d" % port]))
    pub_cfg.insert_json5("scouting/multicast/enabled", "false")
    pub_cfg.insert_json5("scouting/gossip/enabled", "false")
    print("transport    two peers over tcp/127.0.0.1:%d, scouting off" % port)

    rows = frames.rows[: args.selftest_frames]
    expect = collections.Counter(r["ch"] for r in rows)
    got = []
    done = threading.Event()

    def on_sample(sample):
        got.append((str(sample.key_expr), sample.payload.to_bytes()))
        if len(got) >= len(rows):
            done.set()

    sub_session = zenoh.open(sub_cfg)
    sub = sub_session.declare_subscriber(f"{args.prefix}/**", on_sample)
    pub_session = zenoh.open(pub_cfg)
    time.sleep(1.0)  # let the peers find each other before the first put
    pub = Publisher(pub_session, args.prefix, sorted(expect))
    for row in rows:
        pub.put(row["ch"], row["raw"])
    done.wait(timeout=15.0)
    time.sleep(0.5)
    pub.undeclare()
    sub.undeclare()
    pub_session.close()
    sub_session.close()

    failures = []
    if len(got) != len(rows):
        failures.append("%d frames sent, %d arrived" % (len(rows), len(got)))

    by_channel = collections.Counter()
    origin = frames.header.get("origin") or frames.header.get("datum") or {}
    decoded = 0
    reencoded = 0
    stamps = []
    poses, fixes = {}, {}
    for key, data in got:
        ch = Spy.channel_of(key)
        if ch is None:
            failures.append(f"arrived on a key with no known channel: {key}")
            continue
        if key != key_expr(args.prefix, ch):
            failures.append(f"key {key} is not the catalogue's {key_expr(args.prefix, ch)}")
        by_channel[ch] += 1
        cls = decoders[CATALOGUE[ch][0]]
        try:
            msg = cls.lcm_decode(data)
        except Exception as e:
            failures.append(f"{ch} did not decode: {e!r}")
            continue
        decoded += 1
        # A decode that drops a field re-encodes differently. Byte equality is the
        # only cheap check that the decode was complete rather than merely plausible.
        try:
            if msg.lcm_encode() == data:
                reencoded += 1
            else:
                failures.append(f"{ch} decoded but did not re-encode to the same bytes")
        except Exception as e:
            failures.append(f"{ch} would not re-encode: {e!r}")
        st = stamp_of(msg)
        if st is not None:
            stamps.append(st)
        # The frame names, off the decoded bytes. A rename that lands only in a docstring
        # has not landed, and this is the tool that puts the old one on a live bus.
        if ch in FRAME_EXPECTED and frame_of(msg) != FRAME_EXPECTED[ch]:
            failures.append(
                f"{ch} header.frame_id is {frame_of(msg)!r}, not {FRAME_EXPECTED[ch]!r}"
            )
        if ch == "odom":
            if msg.child_frame_id != FRAME_BASE_LINK:
                failures.append(
                    f"odom child_frame_id is {msg.child_frame_id!r}, not {FRAME_BASE_LINK!r}"
                )
            p = msg.position
            if not all(math.isfinite(v) for v in (p[0], p[1], p[2])):
                failures.append(f"odom position is not finite: {tuple(p)!r}")
            if math.hypot(p[0], p[1]) > 2000.0:
                failures.append(
                    f"odom is {math.hypot(p[0], p[1]):.0f} m from the origin, which is not this flight"
                )
        # There is no datum message to check the origin against, so check the arithmetic
        # that replaced it: pose and gps_location are the same measurement, so subtracting
        # them must give the header's origin back.
        if ch == "pose":
            xy = xy_of(msg)
            if xy is None:
                failures.append(
                    f"a decoded pose has no position this tool can read ({type(msg).__name__})"
                )
            else:
                poses[round(stamp_of(msg) or 0.0, 6)] = xy
        if ch == "gps_location":
            fixes[round(stamp_of(msg) or 0.0, 6)] = (msg.latitude, msg.longitude)

    for ch, n in expect.items():
        if by_channel.get(ch, 0) != n:
            failures.append("%s: sent %d, received %d" % (ch, n, by_channel.get(ch, 0)))
    if stamps and stamps != sorted(stamps):
        failures.append("header stamps did not arrive in order")

    recovered, residual = recover_origin(poses, fixes)
    if origin and recovered:
        de, dn = enu_metres(origin["lat"], origin["lon"], recovered[0], recovered[1])
        if math.hypot(de, dn) > 0.01:
            failures.append(
                "the origin recovered by subtracting pose from gps_location is"
                " {:.7f}, {:.7f} — {:.3f} m from the header's {:.7f}, {:.7f}".format(
                    recovered[0], recovered[1], math.hypot(de, dn), origin["lat"], origin["lon"]
                )
            )
        if residual > 0.01:
            failures.append(
                f"the recovered origin is not one constant: {residual:.4f} m of spread"
                " across the paired samples"
            )
    elif origin and poses and fixes:
        failures.append(
            "no pose/gps_location pair shared a stamp, so the origin cannot be"
            " recovered — which is the only way a consumer learns where 0,0,0 is"
        )

    print()
    print("sent         %d frames on %d channels" % (len(rows), len(expect)))
    print("received     %d" % len(got))
    print("decoded      %d" % decoded)
    print("re-encoded   %d byte-identical" % reencoded)
    for ch in CATALOGUE:
        if expect.get(ch):
            print(
                "  %-52s %5d -> %5d"
                % (key_expr(args.prefix, ch), expect[ch], by_channel.get(ch, 0))
            )
    frames_checked = sum(1 for ch in FRAME_EXPECTED if expect.get(ch))
    print(
        "frames       %d channels checked against the tree: %s -> %s"
        % (frames_checked, FRAME_WORLD, FRAME_BASE_LINK)
    )
    if recovered:
        print(
            "origin       %.7f, %.7f recovered from %d paired samples, spread %.1f um"
            % (recovered[0], recovered[1], len(set(poses) & set(fixes)), residual * 1e6)
        )
    else:
        print(
            "origin       NOT RECOVERED — no window with both pose and gps_location on it,"
            " so the check did not run"
        )
    print()
    if failures:
        print("selftest FAILED")
        for f in failures[:30]:
            print("  " + f)
        if len(failures) > 30:
            print("  ... and %d more" % (len(failures) - 30))
        return 1
    print("selftest ok: every frame arrived on its catalogue key, decoded with DiMOS's")
    print("own message classes, re-encoded to the same bytes, carried the frames the")
    print("contract names, and gave the origin back by subtraction.")
    return 0


