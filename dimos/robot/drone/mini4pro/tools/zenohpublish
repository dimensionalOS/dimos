# Publishing
# ─────────────────────────────────────────────────────────────────────────────


class Publisher:
    """Declared publishers for every channel a frames file actually carries."""

    def __init__(self, session, prefix, channels):
        self.prefix = prefix
        self.pubs = {}
        for ch in channels:
            self.pubs[ch] = session.declare_publisher(
                key_expr(prefix, ch), **qos_kwargs(CATALOGUE[ch][1])
            )

    def put(self, ch, data):
        self.pubs[ch].put(data)

    def undeclare(self):
        for p in self.pubs.values():
            try:
                p.undeclare()
            except Exception:
                pass


def describe_frames(frames, args):
    hdr = frames.header
    counts = frames.counts()
    print(f"frames       {frames.path}")
    print("  session    %s" % (hdr.get("session") or "?"))
    started = hdr.get("started_unix_ms")
    if started:
        rec = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(started / 1000.0))
        age_h = (time.time() - started / 1000.0) / 3600.0
        print(f"  recorded   {rec} ({age_h:.1f} h ago)")
    # `origin` since the datum channel's deletion; `datum` is the old spelling, read so an
    # already-encoded frames file still describes itself.
    d = hdr.get("origin") or hdr.get("datum") or {}
    if d:
        print(
            "  origin     {:.7f}, {:.7f}, takeoff alt {}  ({}'s 0,0,0, never published)".format(
                d.get("lat"),
                d.get("lon"),
                ("{:.3f} m".format(d["alt"])) if d.get("alt") is not None else "unknown",
                FRAME_WORLD,
            )
        )
    print(
        "  window     t=%.3f..%.3f s (%.1f s), %d frames"
        % (frames.rows[0]["t"], frames.rows[-1]["t"], frames.span, len(frames.rows))
    )
    if args.speed != 1.0:
        print(f"  speed      {args.speed:g}x — {frames.span / args.speed:.1f} s of wall clock")
    print()
    print("publishing on")
    for ch in CATALOGUE:
        n = counts.get(ch, 0)
        if not n:
            continue
        qos = CATALOGUE[ch][1] or "default (reliable, drop)"
        print("  %-52s %6d  %s" % (key_expr(args.prefix, ch), n, qos))
    silent = [ch for ch in CATALOGUE if not counts.get(ch)]
    if silent:
        print("  silent in this recording: {}".format(", ".join(silent)))
        print("  (a channel with nothing on it and a channel with no data look the same")
        print("   from outside — that is the encoder's rule, not a fault here)")
    print()


class Restamper:
    """Rewrites each message's header stamp to the wall clock it is published at.

    Off by default. A replay is honest about being old: the stamps are the flight's.
    But a consumer that discards anything older than a few seconds discards the whole
    replay, so this exists — and it is the only thing in this tool that re-encodes,
    which is why it verifies its own round trip before it is allowed to touch a frame.

    **The stamp tracks the send, not the recording, and `--speed` is therefore in it.**
    The naive rule — add a constant offset to every stamp — is right at 1x and wrong
    everywhere else: at 20x it hands a subscriber stamps 20 times further apart than
    the messages, so the stream races into the future and the staleness filter this
    option exists to satisfy sees a stamp a minute ahead of its own clock. That was
    not reasoned out; the spy's `stamped` column showed it as a growing negative age.

    Frames from one sample keep one stamp, because they are one reading.
    """

    def __init__(self, decoders, rows):
        self.decoders = decoders
        self.unstamped = set()
        bad = []
        seen = set()
        for r in rows:
            if r["ch"] in seen:
                continue
            seen.add(r["ch"])
            cls = decoders[CATALOGUE[r["ch"]][0]]
            msg = cls.lcm_decode(r["raw"])
            if msg.lcm_encode() != r["raw"]:
                bad.append(r["ch"])
            if not set_stamp(msg, 0.0):
                self.unstamped.add(r["ch"])
        if bad:
            raise SystemExit(
                "--restamp refused: decode->encode is not byte-identical for {}.\n"
                "  Restamping would change more than the stamp, and a replay whose\n"
                "  bytes differ from the aircraft's is not a replay.".format(", ".join(bad))
            )

    def begin(self, rows, speed):
        """Anchor a pass. Returns the state `stamp_for` needs."""
        self._speed = speed
        self._wall0 = time.time()
        self._unix0 = rows[0]["unix"]
        self._cached_t = None
        self._cached_stamp = None

    def stamp_for(self, row):
        if row["t"] == self._cached_t:
            return self._cached_stamp
        if self._speed > 0:
            stamp = self._wall0 + (row["unix"] - self._unix0) / self._speed
        else:
            # --speed 0 has no timeline to map onto: the frames go out as fast as
            # they can, so "now" is the only true answer.
            stamp = time.time()
        self._cached_t, self._cached_stamp = row["t"], stamp
        return stamp

    def apply(self, row):
        if row["ch"] in self.unstamped:
            return row["raw"]
        cls = self.decoders[CATALOGUE[row["ch"]][0]]
        msg = cls.lcm_decode(row["raw"])
        set_stamp(msg, self.stamp_for(row))
        return msg.lcm_encode()


def publish(args, frames, session):
    rows = frames.rows
    channels = sorted({r["ch"] for r in rows})
    pub = Publisher(session, args.prefix, channels)

    restamper = None
    if args.restamp:
        decoders, source = load_decoders(args.dimos_lcm)
        if decoders is None:
            raise SystemExit(
                "--restamp needs the LCM bindings; none found. "
                "Point --dimos-lcm at the dimos-lcm checkout."
            )
        restamper = Restamper(decoders, rows)
        print(f"restamp      on, via {source}")
        print(f"             stamps track the send, so --speed {args.speed:g} is in them: a")
        print("             subscriber sees stamps advancing with its own clock")
        if restamper.unstamped:
            print(
                "             ({} carry no header at all and go out unchanged)".format(
                    ", ".join(sorted(restamper.unstamped))
                )
            )
        print()

    sent = collections.Counter()
    t_zero = rows[0]["t"]
    worst_late = 0.0
    passes = 0
    started_wall = time.time()

    try:
        while True:
            passes += 1
            wall0 = time.monotonic()
            if restamper:
                restamper.begin(rows, args.speed)
            next_status = wall0 + args.status_every
            for row in rows:
                if args.speed > 0:
                    due = wall0 + (row["t"] - t_zero) / args.speed
                    now = time.monotonic()
                    if due > now:
                        time.sleep(due - now)
                    else:
                        worst_late = max(worst_late, now - due)
                data = restamper.apply(row) if restamper else row["raw"]
                pub.put(row["ch"], data)
                sent[row["ch"]] += 1
                if not args.quiet and time.monotonic() >= next_status:
                    next_status = time.monotonic() + args.status_every
                    status_line(row["t"] - t_zero, sent, started_wall, passes, args)
            if not args.loop:
                break
            if not args.quiet:
                print("  --- pass %d complete, restarting in %.1f s ---" % (passes, args.loop_gap))
            time.sleep(args.loop_gap)
    except KeyboardInterrupt:
        print()
    finally:
        pub.undeclare()

    print()
    print(
        "published    %d frames over %.1f s of wall clock%s"
        % (
            sum(sent.values()),
            time.time() - started_wall,
            (", %d passes" % passes) if passes > 1 else "",
        )
    )
    for ch in CATALOGUE:
        if sent.get(ch):
            print("  %-52s %6d" % (key_expr(args.prefix, ch), sent[ch]))
    if worst_late > 0.05:
        print(f"  worst lateness {worst_late:.3f} s — the timeline slipped; a slower --speed or a")
        print("  quieter machine would hold it better")
    else:
        print("  timeline held to within %.0f ms" % (worst_late * 1000.0))
    return 0


def status_line(t, sent, started_wall, passes, args):
    elapsed = time.time() - started_wall
    total = sum(sent.values())
    per = " ".join("%s %d" % (ch[:4], sent[ch]) for ch in CATALOGUE if sent.get(ch))
    print(
        "  t=%7.1fs  %-58s  %5d frames  %5.1f/s%s"
        % (
            t,
            per,
            total,
            total / elapsed if elapsed else 0.0,
            ("  pass %d" % passes) if passes > 1 else "",
        )
    )


