def list_cases(out):
    out.write("The eight things that could have happened, and what in the log separates them.\n")
    out.write("If a log cannot distinguish these, it has failed.\n\n")
    for n, (slug, title, evidence) in CASES.items():
        out.write("case %d  %s\n" % (n, slug))
        out.write(f"        {title}\n")
        out.write(f"        distinguished by: {evidence}\n\n")


