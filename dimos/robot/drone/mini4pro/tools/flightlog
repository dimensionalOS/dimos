        type=float,
        metavar="S",
        help="how far a joined sample may be from a command (default 0.25)",
    )
    ap.add_argument(
        "--corners",
        action="store_true",
        help="how far the flown path left the drawn one, against CORNER_ALLOWANCE_M",
    )
    ap.add_argument("--cross-check", metavar="TLOG", help="compare against a QGC .tlog")
    ap.add_argument("--list-cases", action="store_true", help="the eight cases and their evidence")
    ap.add_argument(
        "--selftest", action="store_true", help="synthetic sessions with planted faults"
    )
    ap.add_argument("--only", metavar="SUBSTR", help="restrict --selftest to matching profiles")
    ap.add_argument("--verbose", action="store_true", help="print full output in --selftest")
    args = ap.parse_args()

    if args.list_cases:
        list_cases(sys.stdout)
        return 0
    if args.selftest:
        rc = selftest(args.only, args.verbose)
        return rc + corners_selftest(args.verbose)
    if not args.files:
        ap.error("give a session file, or --selftest / --list-cases")

    s = read_session(expand(args.files))
    rc = 0
    if args.corners:
        verdict = corner_report(s, sys.stdout, args)
        rc = 1 if verdict == FAIL else 0
    elif args.diagnose_axis:
        verdict = diagnose_axis(s, sys.stdout, args)
        rc = 1 if verdict in (FAIL, INFO) else 0
    else:
        summarise(s, sys.stdout, args)
    if args.cross_check:
        v = cross_check(s, args.cross_check, sys.stdout)
        if v == FAIL:
            rc = 1
    return rc


if __name__ == "__main__":
    raise SystemExit(main())
