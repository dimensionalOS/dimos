def _corner_session(path, overshoot_m):
    """A two-leg mission flown with a planted corner deviation of [overshoot_m] metres.

    The legs are a right angle so the corner is unambiguous: 60 m north, then 60 m
    east. The flown path follows them exactly except across the turn, where it bulges
    outward — which is what cutting a corner too wide looks like from above.

    **The planted number is the perpendicular distance the report should measure**, not
    the distance the point is moved. At a right angle the outward bisector is 45° to
    both legs, so a point pushed `k` along it is only `k·sin45 = 0.707k` from the
    nearest segment. Planting 5 m of *push* and asserting a 5 m *reading* was the first
    version of this test, and it failed — correctly, and for a reason worth keeping in
    the code: a self-test whose planted value is not the quantity under test proves
    nothing about the quantity under test.
    """
    lat0, lon0 = 38.0, 23.7
    dlat = 1.0 / METRES_PER_DEG
    dlon = 1.0 / (METRES_PER_DEG * math.cos(math.radians(lat0)))
    wp = [(lat0, lon0), (lat0 + 60 * dlat, lon0), (lat0 + 60 * dlat, lon0 + 60 * dlon)]

    lines = [
        json.dumps(
            {
                "t": 0,
                "k": "header",
                "format": FORMAT,
                "schema": 1,
                "session": "synthetic-corners",
                "part": 1,
                "started_unix_ms": UNIX0,
                "started_mono_ns": MONO0,
                "opened_unix_ms": UNIX0,
                "opened_mono_ns": MONO0,
                "clock": {
                    "mono": "SystemClock.elapsedRealtimeNanos",
                    "wall": "System.currentTimeMillis",
                    "t_field": "seconds since started_mono_ns",
                },
                "config": {"queue_capacity": 8192, "flush_interval_ms": 500},
                "meta": {"note": f"synthetic corner profile, overshoot {overshoot_m:.1f} m"},
            }
        )
    ]
    for seq, (la, lo) in enumerate(wp):
        lines.append(
            _line(
                1.0 + seq * 0.01,
                "mav_in",
                name="MISSION_ITEM_INT",
                f={"seq": seq, "command": 16, "x": round(la * 1e7), "y": round(lo * 1e7)},
            )
        )

    t = 10.0
    fixes = []
    for i in range(61):  # up the first leg
        fixes.append((t + i * 0.2, lat0 + i * dlat, lon0))
    # Across the corner: eight samples pushed out along the bisector by the planted amount.
    push = overshoot_m * math.sqrt(2.0)  # so the *perpendicular* deviation is overshoot_m
    for i in range(9):
        k = math.sin(math.pi * i / 8.0) * push
        fixes.append(
            (
                t + 12.2 + i * 0.2,
                lat0 + (60 + k * 0.7071) * dlat,
                lon0 + (i * 1.5 + k * 0.7071) * dlon,
            )
        )
    for i in range(12, 61):  # along the second leg
        fixes.append((t + 13.8 + i * 0.2, lat0 + 60 * dlat, lon0 + i * dlon))
    for ft, la, lo in fixes:
        lines.append(
            _line(
                ft,
                "mav_out",
                name="GLOBAL_POSITION_INT",
                f={"lat": round(la * 1e7), "lon": round(lo * 1e7), "relative_alt": 20000},
            )
        )

    lines.append(
        _line(t + 12.0, "event", code="goto_arrived", sev="info", msg="mission item=1 err=2.90")
    )
    lines.append(
        _line(
            t + 26.0,
            "event",
            code="goto_arrived",
            sev="info",
            msg="mission complete seq=2 err=0.30",
        )
    )
    with open(path, "w") as f:
        f.write("\n".join(lines) + "\n")


def corners_selftest(verbose=False):
    """Two planted corners: one inside the allowance, one past it.

    The same rule the axis diagnosis is held to — a report that has never been shown
    to catch anything is not a report. A wide corner is the *only* thing this mode
    exists to notice, so a synthetic one that it calls `ok` would be worse than having
    no mode at all.
    """
    import io

    tmp = tempfile.mkdtemp(prefix="flightlog-corners-")
    cases = [
        ("inside the allowance", 2.0, PASS),
        ("past the allowance", 9.0, FAIL),
        ("close enough to warn", 5.0, WARN),
    ]
    failures = 0
    print("\ncorner report self-test — %d planted corners\n" % len(cases))
    for name, overshoot, want in cases:
        path = os.path.join(tmp, f"corner-{overshoot:.0f}.001.jsonl")
        _corner_session(path, overshoot)
        s = read_session([path])
        buf = io.StringIO()
        got = corner_report(s, buf, None)
        text = buf.getvalue()
        m = re.search(r"worst\s+([\d.]+) m", text)
        measured = float(m.group(1)) if m else -1.0
        # **The number, not just the verdict.** A report that says FAIL for the wrong
        # reason is a report that will say ok for the wrong reason too.
        close = abs(measured - overshoot) <= 0.35
        ok = got == want and close
        failures += 0 if ok else 1
        print(
            "  %-24s planted %4.1f m  measured %5.2f m  want %-4s got %-4s  %s"
            % (name, overshoot, measured, want, got, "ok" if ok else "MISMATCH")
        )
        if verbose or not ok:
            print(buf.getvalue())
    print("\n%d/%d corner profiles behaved as planted" % (len(cases) - failures, len(cases)))
    return failures


def selftest(only=None, verbose=False):
    tmp = tempfile.mkdtemp(prefix="flightlog-selftest-")
    width = max(len(p) for p in PROFILES)
    failures = 0
    print("flightlog self-test — %d profiles, each with one planted fault\n" % len(PROFILES))
    for name, p in PROFILES.items():
        if only and only not in name:
            continue
        path = os.path.join(tmp, name + ".001.jsonl")
        synth(name, path)
        s = read_session([path])

        class A:
            pass

        args = A()
        args.from_t = 2.0
        args.to_t = 6.0
        args.around = None
        args.max_rows = 6
        for k, v in DEFAULTS.items():
            setattr(args, k, v)
        import io

        buf = io.StringIO()
        diagnose_axis(s, buf, args)
        text = buf.getvalue()

        want, got = set(p["expect"]), set()
        for c in CASES:
            if ("case %d " % c) in text.split("Evidence supports:")[-1]:
                got.add(c)
        ok = want.issubset(got)
        notes = []
        if not ok:
            notes.append(
                "expected case(s) {}, named {}".format(
                    sorted(want) or "none", sorted(got) or "none"
                )
            )
        if p.get("want_missing") and p["want_missing"] not in text:
            ok = False
            notes.append("did not report {} as missing".format(p["want_missing"]))
        if p.get("want_drop") and "LOST INSIDE THIS WINDOW" not in text:
            ok = False
            notes.append("did not flag the drop inside the window")
        if p.get("want_text") and p["want_text"] not in text:
            ok = False
            notes.append("did not print {!r}".format(p["want_text"]))
        if (
            not p["expect"]
            and not p.get("want_missing")
            and not p.get("want_drop")
            and not p.get("want_text")
            and got
        ):
            ok = False
            notes.append(f"clean profile but named {sorted(got)}")

        status = "ok  " if ok else "FAIL"
        print("%s %-*s  %s" % (status, width, name, p["desc"]))
        if notes:
            for nline in notes:
                print(f"     {nline}")
        if not ok:
            failures += 1
        if verbose or not ok:
            print("\n".join("     | " + ln for ln in text.splitlines()))
            print()

    print(f"\nfixtures in {tmp}")
    if failures:
        print("%d profile(s) NOT caught — the diagnosis has a hole." % failures)
    else:
        print("every planted fault was named correctly.")
    return 1 if failures else 0


