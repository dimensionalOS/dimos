        epilog="the recorder that writes these files is "
        "android/app/src/main/java/com/dimensional/mini4pro/record/",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    ap.add_argument(
        "files", nargs="*", help="session JSONL file(s); one part pulls in its siblings"
