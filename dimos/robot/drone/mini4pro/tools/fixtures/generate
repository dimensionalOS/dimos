# ("v1", "corrupt", "truncate", "coalesce", "seq_bump", "sysid"), or return
# False to drop the frame entirely.


def _zero_latlon(name, f, ctx, i, st):
    if "lat" in f:
        f["lat"] = f["lon"] = 0


def _latlon_degrees(name, f, ctx, i, st):
    if "lat" in f:
        f["lat"], f["lon"] = int(LAT), int(LON)


def _latlon_swapped(name, f, ctx, i, st):
    if "lat" in f:
        f["lat"], f["lon"] = f["lon"], f["lat"]


def _alt_mm_in_vfr(name, f, ctx, i, st):
    if name == "VFR_HUD":
        f["alt"] = float(st["alt_mm"])


def _hdg_degrees(name, f, ctx, i, st):
    if name == "GLOBAL_POSITION_INT":
        f["hdg"] = round(st["hdg_cdeg"] / 100)


def _hdg_signed(name, f, ctx, i, st):
    if name == "GLOBAL_POSITION_INT":
        f["hdg"] = round(YAW_DEG * 100) & 0xFFFF  # int16 -12110 cast to uint16


def _amsl_relative(name, f, ctx, i, st):
    if name == "GLOBAL_POSITION_INT":
        f["alt"] = st["rel_mm"]
    if name == "VFR_HUD":
        f["alt"] = st["rel_m"]
    if name == "GPS_RAW_INT":
        f["alt"] = st["rel_mm"]


def _cell_zero_sentinel(name, f, ctx, i, st):
    if name == "BATTERY_STATUS":
        f["voltages"] = CELLS_MV + [0] * 8


def _current_sign(name, f, ctx, i, st):
    if "current_battery" in f:
        f["current_battery"] = round(CURRENT_MA / 10)


def _current_milliamps(name, f, ctx, i, st):
    if "current_battery" in f:
        f["current_battery"] = -CURRENT_MA  # mA sent as if it were cA


def _climb_sign(name, f, ctx, i, st):
    if name == "VFR_HUD":
        f["climb"] = st["vz"] / 100.0


def _groundspeed_cms(name, f, ctx, i, st):
    if name == "VFR_HUD":
        f["groundspeed"] = st["gs_ms"] * 100.0


def _attitude_degrees(name, f, ctx, i, st):
    if name == "ATTITUDE":
        f["yaw"] = YAW_DEG
        f["roll"], f["pitch"] = -1.0, 0.0  # KeyAircraftAttitude, degrees


def _fix_3d_few_sats(name, f, ctx, i, st):
    if name == "GPS_RAW_INT":
        f["satellites_visible"] = 2


def _no_fix_zeros(name, f, ctx, i, st):
    """Not a fault — DJI withdrawing the fix, exactly as it did on 2026-07-26.

    Half way through, GPSSignalLevel collapses: GPS_RAW_INT goes to NO_FIX with
    lat/lon 0/0 while still seeing every satellite, and GLOBAL_POSITION_INT is
    suppressed rather than sent as 0/0. Both are decisions the encoder documents
    (TelemetryEncoder.kt:614-619), so this stream must pass.
    """
    if st["t"] < 4.0:
        return
    if name == "GLOBAL_POSITION_INT":
        return False
    if name == "GPS_RAW_INT":
        f["fix_type"] = 1
        f["lat"] = f["lon"] = 0


def _time_frozen(name, f, ctx, i, st):
    if "time_boot_ms" in f:
        f["time_boot_ms"] = 1


def _motor_outputs_bit(name, f, ctx, i, st):
    if name == "SYS_STATUS":
        f["onboard_control_sensors_present"] |= mav2.MAV_SYS_STATUS_SENSOR_MOTOR_OUTPUTS
        f["onboard_control_sensors_enabled"] |= mav2.MAV_SYS_STATUS_SENSOR_MOTOR_OUTPUTS


def _wrong_autopilot(name, f, ctx, i, st):
    if name == "HEARTBEAT":
        f["autopilot"] = mav2.MAV_AUTOPILOT_GENERIC


def _pack_from_one_cell(name, f, ctx, i, st):
    if name == "SYS_STATUS":
        f["voltage_battery"] = CELLS_MV[0]


def _missing_position(name, f, ctx, i, st):
    if name == "GLOBAL_POSITION_INT":
        return False


def _heartbeat_slow(name, f, ctx, i, st):
    if name == "HEARTBEAT" and st["t"] % 5.0 > 0.001:
        return False


def _crc_corrupt(name, f, ctx, i, st):
    if i % 20 == 7:
        ctx["corrupt"] = True


def _seq_gap(name, f, ctx, i, st):
    if i % 40 == 11:
        ctx["seq_bump"] = 3


def _mavlink1(name, f, ctx, i, st):
    ctx["v1"] = True


def _sysid_two(name, f, ctx, i, st):
    if i % 7 == 0:
        ctx["sysid"] = 2


def _truncated(name, f, ctx, i, st):
    if i % 30 == 5:
        ctx["truncate"] = 4


def _coalesced(name, f, ctx, i, st):
    ctx["coalesce"] = True


