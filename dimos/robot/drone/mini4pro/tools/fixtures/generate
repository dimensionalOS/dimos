def gcs_frames(t0):
    """A short burst of QGC->vehicle traffic: the M2/M4 regression corpus, in miniature."""
    mav = mav2.MAVLink(None, srcSystem=255, srcComponent=190)
    out = []
    msgs = [
        mav.heartbeat_encode(
            mav2.MAV_TYPE_GCS, mav2.MAV_AUTOPILOT_INVALID, 0, 0, mav2.MAV_STATE_ACTIVE
        ),
        mav.param_request_list_encode(1, 1),
        mav.mission_request_list_encode(1, 1, 0),
        mav.command_long_encode(1, 1, mav2.MAV_CMD_NAV_TAKEOFF, 0, 0, 0, 0, 0, 0, 0, 10.0),
        mav.command_long_encode(1, 1, mav2.MAV_CMD_COMPONENT_ARM_DISARM, 0, 1, 0, 0, 0, 0, 0, 0),
    ]
    for k, m in enumerate(msgs):
        mav.seq = k
        out.append((t0 + 0.1 * k, "down", m.pack(mav)))
    return out


def build(profile, seconds):
    desc, flight, gcs, mutate, _f, _w, _a = PROFILES[profile]
    events = []
    for name, hz in SCHEDULE.items():
        k = 0
        while k / hz < seconds:
            events.append((round(k / hz, 6), name))
            k += 1
    events.sort(key=lambda e: (e[0], e[1]))

    mav = mav2.MAVLink(None, srcSystem=1, srcComponent=1)
    seq = 0
    frames = []
    pending = None
    for i, (t, name) in enumerate(events):
        st = state_at(t, flight)
        f = fields(name, st)
        ctx = {}
        if mutate is not None and mutate(name, f, ctx, i, st) is False:
            continue
        mav.srcSystem = ctx.get("sysid", 1)
        mav.seq = seq % 256
        seq += 1 + ctx.get("seq_bump", 0)
        msg = getattr(mav, name.lower() + "_encode")(**f)
        b = bytearray(msg.pack(mav, force_mavlink1=ctx.get("v1", False)))
        if ctx.get("corrupt"):
            b[-1] ^= 0xFF
        if ctx.get("truncate"):
            b = b[: -ctx["truncate"]]
        if ctx.get("coalesce"):
            if pending is None:
                pending = bytes(b)
                continue
            b, pending = bytearray(pending + bytes(b)), None
        frames.append((t, "up", bytes(b)))
    if pending:
        frames.append((events[-1][0], "up", pending))
    if gcs:
        frames.extend(gcs_frames(1.0))
    frames.sort(key=lambda r: r[0])
    return desc, frames


def write(profile, seconds, path):
    desc, frames = build(profile, seconds)
    with open(path, "w") as out:
        out.write(
            json.dumps(
                {
                    "format": "mavcapture-1",
                    "encoding": "hex",
                    "started_unix": 0,
                    "bind": "0.0.0.0:14550",
                    "forward": None,
                    "note": f"SYNTHETIC fixture, profile {profile!r}: {desc}. "
                    f"Generated by tools/fixtures/generate — not a real aircraft capture.",
                    "argv": [profile],
                }
            )
            + "\n"
        )
        for t, direction, b in frames:
            src = "10.55.1.15:38214" if direction == "up" else "10.55.1.12:14550"
            out.write(
                json.dumps(
                    {
                        "t": round(t, 6),
                        "dir": direction,
                        "src": src,
                        "dst": "10.55.1.12:14550" if direction == "up" else "10.55.1.15:38214",
                        "len": len(b),
                        "hex": b.hex(),
                    }
                )
                + "\n"
            )
    return len(frames)


def selftest(seconds, only=None):
    tmp = Path(tempfile.mkdtemp(prefix="mavverify-selftest-"))
    width = max(len(p) for p in PROFILES)
    bad = 0
    print(f"{'profile':<{width}}  {'verdict':<7}  result")
    for profile, (_desc, _fl, _g, _m, exp_fail, exp_warn, extra) in PROFILES.items():
        if only and profile not in only:
            continue
        path = tmp / f"{profile}.jsonl"
        write(profile, seconds, path)
        cmd = [sys.executable, str(MAVVERIFY), str(path), "--json", *extra]
        r = subprocess.run(cmd, capture_output=True, text=True)
        try:
            report = json.loads(r.stdout)
        except json.JSONDecodeError:
            print(f"{profile:<{width}}  ERROR    mavverify did not produce JSON:\n{r.stderr}")
            bad += 1
            continue
        got = {(f["check"], f["severity"]) for f in report["findings"]}
        verdict = report["verdict"]
        want_verdict = "FAIL" if exp_fail else "PASS"
        problems = []
        if verdict != want_verdict:
            problems.append(f"verdict {verdict}, wanted {want_verdict}")
        for cid in exp_fail:
            if (cid, "FAIL") not in got:
                sev = next((s for c, s in got if c == cid), "absent")
                problems.append(f"{cid} was {sev}, wanted FAIL")
        for cid in exp_warn:
            if (cid, "WARN") not in got:
                sev = next((s for c, s in got if c == cid), "absent")
                problems.append(f"{cid} was {sev}, wanted WARN")
        if r.returncode != (1 if want_verdict == "FAIL" else 0):
            problems.append(f"exit code {r.returncode}")
        if problems:
            bad += 1
            print(f"{profile:<{width}}  {verdict:<7}  MISMATCH: {'; '.join(problems)}")
        else:
            caught = ", ".join(exp_fail + [w + "(warn)" for w in exp_warn]) or "nothing to catch"
            print(f"{profile:<{width}}  {verdict:<7}  ok — caught {caught}")
    print(f"\nfixtures in {tmp}")
    print("SELFTEST: " + (f"{bad} profile(s) wrong" if bad else "all profiles behaved as declared"))
    return 1 if bad else 0


def main():
    ap = argparse.ArgumentParser(
        description=__doc__.split("\n\n")[0], formatter_class=argparse.RawDescriptionHelpFormatter
    )
    ap.add_argument("--out", default=str(HERE), help="output directory (default tools/fixtures)")
    ap.add_argument("--seconds", type=float, default=8.0, help="stream duration (default 8)")
    ap.add_argument(
        "--all", action="store_true", help="write every profile, not just the clean ones"
    )
    ap.add_argument("--only", action="append", default=[], metavar="PROFILE")
    ap.add_argument("--list", action="store_true")
    ap.add_argument(
        "--selftest",
        action="store_true",
        help="generate every profile and assert mavverify's verdict on each",
    )
    args = ap.parse_args()

    if args.list:
        for p, (desc, _fl, _g, _m, ef, ew, _a) in PROFILES.items():
            marks = ", ".join(ef + [w + " (warn)" for w in ew]) or "must pass clean"
            print(f"{p:<20} {desc}\n{'':<20} expects: {marks}")
        return 0
    if args.selftest:
        return selftest(args.seconds, set(args.only) or None)

    out = Path(args.out)
    out.mkdir(parents=True, exist_ok=True)
    names = args.only or (list(PROFILES) if args.all else ["nominal", "nominal-flight"])
    for p in names:
        n = write(p, args.seconds, out / f"{p}.jsonl")
        print(f"{out / f'{p}.jsonl'}: {n} frames")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
