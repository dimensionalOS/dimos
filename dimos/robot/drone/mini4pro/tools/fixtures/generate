#!/usr/bin/env python3
"""Generate synthetic mavcapture-1 fixtures — clean, and with planted faults.

This exists to answer one question about `tools/mavverify`: does it actually
catch anything? A validator that has never been shown a bug it was pointed at is
not known to work. Every profile below is a stream built from the real values in
docs/measurements/2026-07-25-ground-probe.md, with exactly one thing broken in a
way we plausibly could break it, plus the list of check ids that MUST fail.

    tools/fixtures/generate --selftest      # generate every fault, assert mavverify catches it
    tools/fixtures/generate                 # write the two clean fixtures into tools/fixtures/
    tools/fixtures/generate --all --out /tmp/fx     # write every profile
    tools/fixtures/generate --list

Only the clean fixtures are committed; fault streams are regenerated on demand,
because they are cheaper to derive than to store.

The generator encodes with pymavlink, i.e. with the *same* library mavverify
decodes with, so it cannot prove our Kotlin encoder correct — that is the app's
job, on real hardware. What it proves is that each check fires on the fault it
claims to detect, which is the part that would otherwise be assumed.
"""

import argparse
import json
import math
from pathlib import Path
import subprocess
import sys
import tempfile

from pymavlink.dialects.v20 import ardupilotmega as mav2

HERE = Path(__file__).resolve().parent
MAVVERIFY = HERE.parent / "mavverify"

# ── measured ground truth (docs/measurements/2026-07-25-ground-probe.md) ──
LAT, LON = 37.9938612, 23.7253298
HOME_LAT, HOME_LON = 37.9938872, 23.7253295
TAKEOFF_AMSL = 103.1696  # KeyTakeoffLocationAltitude
YAW_DEG = -121.1  # KeyCompassHeading, signed [-180,180]
SATS = 17  # 14..19 observed
CELLS_MV = [4186, 4183]  # KeyCellVoltages, 2S
PACK_MV = 8371  # KeyVoltage (whole pack)
CURRENT_MA = -905  # KeyCurrent, negative while discharging
BATT_PCT = 98
BATT_TEMP_C = 37.5

SENSORS = (
    mav2.MAV_SYS_STATUS_SENSOR_3D_GYRO
    | mav2.MAV_SYS_STATUS_SENSOR_3D_ACCEL
    | mav2.MAV_SYS_STATUS_SENSOR_3D_MAG
    | mav2.MAV_SYS_STATUS_SENSOR_GPS
    | mav2.MAV_SYS_STATUS_SENSOR_ABSOLUTE_PRESSURE
    | mav2.MAV_SYS_STATUS_SENSOR_BATTERY
)  # deliberately NOT MOTOR_OUTPUTS

SCHEDULE = {  # Hz — Bridge.tick()'s divisors, i.e. mavverify's EXPECTED_RATES
    "HEARTBEAT": 1.0,
    "SYS_STATUS": 2.5,
    "GLOBAL_POSITION_INT": 5.0,
    "GPS_RAW_INT": 5.0,
    "ATTITUDE": 5.0,
    "VFR_HUD": 5.0,
    "BATTERY_STATUS": 1.0,
    # An event message, not a scheduled one — it has no entry in EXPECTED_RATES.
    # Emitted here at a slow trickle only so the stream contains one.
    "HOME_POSITION": 0.2,
}


def state_at(t, flight):
    """Physical state at time t. Ground = exactly what the probe measured."""
    if flight:
        rel = 3.0 * t  # climbing at 3 m/s
        vz_cms, vx_cms, vy_cms = -300, 500, 0
    else:
        rel = 0.0
        vz_cms = vx_cms = vy_cms = 0
    amsl = TAKEOFF_AMSL + rel
    return {
        "t": t,
        "flight": flight,
        "rel_m": rel,
        "amsl_m": amsl,
        "alt_mm": round(amsl * 1000),
        "rel_mm": round(rel * 1000),
        "vx": vx_cms,
        "vy": vy_cms,
        "vz": vz_cms,
        "yaw_deg": YAW_DEG,
        "hdg_cdeg": round(YAW_DEG % 360 * 100),
        "gs_ms": math.hypot(vx_cms, vy_cms) / 100.0,
        "climb_ms": -vz_cms / 100.0,
    }


def fields(name, st):
    """The message the app *should* send for this state, in MAVLink units."""
    tb = int(st["t"] * 1000) + 1
    if name == "HEARTBEAT":
        base = mav2.MAV_MODE_FLAG_CUSTOM_MODE_ENABLED
        if st["flight"]:
            base |= mav2.MAV_MODE_FLAG_SAFETY_ARMED
        # PX4 identity (docs/decisions/2026-07-25-autopilot-identity.md), and with
        # it a PX4 custom_mode: main 3 / sub 0 = POSCTL, what Px4Mode maps GPS_ATTI
        # to and what the real aircraft was seen sending.
        return dict(
            type=mav2.MAV_TYPE_QUADROTOR,
            autopilot=mav2.MAV_AUTOPILOT_PX4,
            base_mode=base,
            custom_mode=3 << 16,
            system_status=mav2.MAV_STATE_ACTIVE if st["flight"] else mav2.MAV_STATE_STANDBY,
        )
    if name == "SYS_STATUS":
        return dict(
            onboard_control_sensors_present=SENSORS,
            onboard_control_sensors_enabled=SENSORS,
            onboard_control_sensors_health=SENSORS,
            load=0,
            voltage_battery=PACK_MV,
            current_battery=round(-CURRENT_MA / 10),
            battery_remaining=BATT_PCT,
            drop_rate_comm=0,
            errors_comm=0,
            errors_count1=0,
            errors_count2=0,
            errors_count3=0,
            errors_count4=0,
        )
    if name == "GLOBAL_POSITION_INT":
        return dict(
            time_boot_ms=tb,
            lat=round(LAT * 1e7),
            lon=round(LON * 1e7),
            alt=st["alt_mm"],
            relative_alt=st["rel_mm"],
            vx=st["vx"],
            vy=st["vy"],
            vz=st["vz"],
            hdg=st["hdg_cdeg"],
        )
    if name == "GPS_RAW_INT":
        return dict(
            time_usec=tb * 1000,
            fix_type=3,
            lat=round(LAT * 1e7),
            lon=round(LON * 1e7),
            alt=st["alt_mm"],
            eph=100,
            epv=150,
            vel=round(st["gs_ms"] * 100),
            cog=st["hdg_cdeg"],
            satellites_visible=SATS,
        )
    if name == "ATTITUDE":
        return dict(
            time_boot_ms=tb,
            roll=0.0,
            pitch=0.0,
            yaw=math.radians(YAW_DEG),
            rollspeed=0.0,
            pitchspeed=0.0,
            yawspeed=0.0,
        )
    if name == "VFR_HUD":
        return dict(
            airspeed=st["gs_ms"],
            groundspeed=st["gs_ms"],
            heading=round(st["hdg_cdeg"] / 100) % 360,
            throttle=40 if st["flight"] else 0,
            alt=st["alt_mm"] / 1000.0,
            climb=st["climb_ms"],
        )
    if name == "BATTERY_STATUS":
        return dict(
            id=0,
            battery_function=mav2.MAV_BATTERY_FUNCTION_ALL,
            type=mav2.MAV_BATTERY_TYPE_LIPO,
            temperature=round(BATT_TEMP_C * 100),
            voltages=CELLS_MV + [65535] * (10 - len(CELLS_MV)),
            current_battery=round(-CURRENT_MA / 10),
            current_consumed=-1,
            energy_consumed=-1,
            battery_remaining=BATT_PCT,
        )
    if name == "HOME_POSITION":
        return dict(
            latitude=round(HOME_LAT * 1e7),
            longitude=round(HOME_LON * 1e7),
            altitude=round(TAKEOFF_AMSL * 1000),
            x=0.0,
            y=0.0,
            z=0.0,
            q=[1.0, 0.0, 0.0, 0.0],
            approach_x=0.0,
            approach_y=0.0,
            approach_z=0.0,
        )
    raise KeyError(name)


