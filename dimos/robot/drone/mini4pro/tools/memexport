CANDIDATE_PYTHONS = [
    os.environ.get("MEMEXPORT_PYTHON"),
    os.path.expanduser("~/coding/dimos/.venv/bin/python"),
]


def ensure_dimos(reexec=True):
    """Import DiMOS, re-execing under an interpreter that has it if this one does not.

    Noisy rather than clever: it prints which interpreter it moved to, because "the tool
    silently ran as something else" is its own class of bug.
    """
    try:
        import dimos.memory2.store.sqlite  # noqa: F401

        return
    except ImportError:
        pass
    if reexec:
        for cand in CANDIDATE_PYTHONS:
            if not cand or not os.path.exists(cand):
                continue
            if os.path.realpath(cand) == os.path.realpath(sys.executable):
                continue
            if os.system(f"{cand} -c 'import dimos.memory2' 2>/dev/null") == 0:
                sys.stderr.write(f"memexport: no dimos here; re-exec under {cand}\n")
                os.execv(cand, [cand, os.path.abspath(__file__), *sys.argv[1:]])
    sys.stderr.write(
        "memexport: dimos.memory2 is not importable.\n"
        "  It lives in DiMOS's venv:\n"
        "    ~/coding/dimos/.venv/bin/python tools/memexport ...\n"
        "  or point MEMEXPORT_PYTHON at an interpreter that has it.\n"
    )
    sys.exit(2)


