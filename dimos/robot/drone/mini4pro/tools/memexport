def main():
    here = os.path.dirname(os.path.abspath(__file__))
    repo = os.path.dirname(here)

    ap = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    ap.add_argument("paths", nargs="*", help="flight record .jsonl files or globs")
    ap.add_argument("--out", metavar="FILE", help="the store to write (default: beside the record)")
    ap.add_argument("--force", action="store_true", help="replace an existing store")
    ap.add_argument(
        "--keyframes-only",
        action="store_true",
        help="the only lossless decimation: 0.5%% of the frames, 5%% of the bytes",
    )
    ap.add_argument("--no-video", action="store_true", help="telemetry and tf only")
    ap.add_argument(
        "--gimbal",
        choices=("auto", "none"),
        default="auto",
        help="'none' omits the base_link->camera edge entirely",
    )
    ap.add_argument(
        "--pose-tolerance",
        type=float,
        default=0.25,
        metavar="S",
        help="how near a pose must be to be attached to a frame (default 0.25 s)",
    )
    ap.add_argument(
        "--no-crosscheck",
        action="store_true",
        help="skip the checks. Says so loudly, because it is the point of the tool",
    )
    ap.add_argument("--spy", metavar="STORE", help="print what a consumer sees; writes nothing")
    ap.add_argument("--selftest", action="store_true", help="planted data and planted faults")
    args = ap.parse_args()

    if args.selftest:
        ensure_dimos()
        return selftest(repo)
    if args.spy:
        ensure_dimos()
        return spy(args.spy)
    if not args.paths:
        ap.print_help()
        return 2
    ensure_dimos()

    paths = []
    for p in args.paths:
        matched = sorted(glob.glob(p))
        paths.extend(matched if matched else [p])
    for p in paths:
        if not os.path.exists(p):
            sys.exit(f"no such record: {p}")

    out = args.out or os.path.join(
        repo, "tmp", os.path.basename(paths[0]).split(".")[0] + ".mem2.db"
    )

    started = time.time()
    try:
        c, msgs = convert(paths, args)
    except VideoFault as e:
        sys.stderr.write(f"memexport: refusing to write this store.\n  {e}\n")
        return 1

    c.entries = read_records(paths)[1]
    c.gimbal_note = None
    if (
        args.gimbal != "none"
        and not c.commanded_gimbal_count
        and c.tf_edges.get("base_link->camera")
    ):
        c.gimbal_note = (
            "base_link->camera was built from the REPORTED gimbal angle, held, because no "
            "dji_call carried a commanded one (DjiOp.GIMBAL_ROTATE is never tapped). Each tf "
            "observation carries the reading's age in gimbal_age_ms."
        )
        print(f"note         {c.gimbal_note}")

    c.rows["provenance"].append(
        (
            (c.rows["pose"] or c.rows["mode"] or [(0.0,)])[0][0],
            msgs.text(provenance(c, paths, args)),
            None,
            {},
        )
    )

    store, streams, written = write_store(out, c, msgs, args)
    elapsed = time.time() - started
    report(c, written, out, elapsed)

    rc = 0
    if args.no_crosscheck:
        print(
            "\nchecks       SKIPPED by --no-crosscheck. This store has not been checked "
            "against anything."
        )
    else:
        print()
        compared, problems = check_roundtrip(streams, c)
        _say("round trip", compared, problems, "observations re-encoded to the bytes written")
        rc |= bool(problems)

        if c.rows["color_image"]:
            vc, vp = check_video_against_sidecar(streams, paths[0])
            _say("video bytes", vc, vp, "frames equal the sidecar at their own {part,off,len}")
            rc |= bool(vp)

        kc, kulp, kdiff, kp, note, kper = check_against_kotlin(paths, c, repo)
        if note:
            print(f"  kotlin       NOT RUN: {note}")
            print(
                "               The cross-check against the shipping encoder is the one that "
                "keeps three implementations honest. Not running it is not passing it."
            )
        elif kp:
            # The failing line says how many DIFFER, never how many complaints were printed.
            # Printing `len(problems)` where the sentence said "byte-identical" is what made
            # a 1512-message one-byte divergence read as "9 of 33491" (landing16, 2026-07-30).
            print(
                "  kotlin       FAILED — %d of %d messages differ from ZenohTelemetryEncoder"
                % (kdiff, kc)
            )
            for p in kp[: KOTLIN_PROBLEM_EXAMPLES + 3]:
                print(f"               {p}")
            rc |= 1
        elif kulp:
            # Never folded into the identical count: "equal" and "equal to tolerance"
            # must not print the same. See check_against_kotlin for what earns this line.
            print(
                "  kotlin       %d of %d messages byte-identical to ZenohTelemetryEncoder"
                % (kc - kulp, kc)
            )
            print(
                "               the other %d agree to a few ULP at unit scale on "
                "quaternion components (JVM vs glibc sin/cos)" % kulp
            )
        else:
            print(
                "  kotlin       %d of %d messages byte-identical to ZenohTelemetryEncoder"
                % (kc, kc)
            )
        if kper:
            # Stream by stream, ALWAYS — pass or fail. On a pass it makes a stream's
            # membership in the comparison visible (an aggregate that would read the same
            # with a stream silently absent is not an accounting of that stream); on a
            # failure it is the line that names WHICH stream broke, which is exactly what
            # the aggregate cannot say and what a diagnosis has to start from.
            print(
                "               per stream: "
                + ", ".join("%s %d/%d" % (n, ok, tot) for n, (ok, tot) in kper.items())
            )

        tc, tp, tnote = check_tf(store, c)
        if tnote:
            print(f"  tf           NOT RUN: {tnote}")
        else:
            _say("tf", tc, tp, "instants across the flight resolve world->camera_optical")
            rc |= bool(tp)

        rec, resid, n, spread = check_origin_by_subtraction(c)
        if n:
            print(
                "  origin       %d paired samples recover %.7f, %.7f — spread %.1f um, "
                "residual against the recorded origin %.1f um"
                % (n, rec[0], rec[1], spread * 1e6, resid * 1e6)
            )
            if spread > 0.01:
                print(
                    "               SPREAD OVER 1 cm. The origin is not single-valued: either "
                    "the projection is wrong or this store holds more than one flight."
                )
                rc |= 1
        else:
            print("  origin       no sample carries both a pose and a fix — nothing to subtract")

    store.stop()
    return rc


def _say(name, compared, problems, what):
    """One check's verdict.

    `what` is phrased as the success predicate ("observations re-encoded to the bytes
    written"), so the failing line has to be built the other way round: "of N ..., M did
    not". The old failing line was `"%d of %d %s" % (len(problems), compared, what)`, which
    put the *complaint count* where the reader reads the *success count* — "9 of 33491
    messages byte-identical" for a run in which 33482 were byte-identical and nine
    complaints had been printed (landing16, 2026-07-30). A number that means the opposite of
    what its sentence says is worse than no number.
    """
    if problems:
        print("  %-12s FAILED — of %d %s, %d did not" % (name, compared, what, len(problems)))
        for p in problems[:5]:
            print(f"               {p}")
    else:
        print("  %-12s %d of %d %s" % (name, compared, compared, what))


if __name__ == "__main__":
    sys.exit(main())
