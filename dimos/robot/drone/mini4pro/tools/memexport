MIN_SOLVE_PIXELS = 60.0  # vision/TagPose.MIN_SOLVE_PIXELS
MAX_AMBIGUITY_RATIO = 0.5  # vision/TagPose.MAX_AMBIGUITY_RATIO


def trusted_solve(px, solve):
    """`vision/TagPose.trusted`, mirrored: the solve dict when believable, else None.

    `solve` is `{qx,qy,qz,qw,tx,ty,tz,e1,e2,tag_m}` floats or None. `e2` may be +inf —
    no second PnP minimum, the UNAMBIGUOUS case (ratio 0), not a missing value.
    """
    if solve is None:
        return None
    finite = [solve[k] for k in ("qx", "qy", "qz", "qw", "tx", "ty", "tz")]
    if not all(math.isfinite(v) for v in finite):
        return None
    if not math.isfinite(solve["e1"]) or solve["e1"] < 0.0:
        return None
    if math.isnan(solve["e2"]):
        return None
    if not math.isfinite(solve["tag_m"]) or solve["tag_m"] <= 0.0:
        return None
    if solve["tz"] <= 0.0:
        return None
    if not math.isfinite(px) or px < MIN_SOLVE_PIXELS:
        return None
    e1, e2 = solve["e1"], solve["e2"]
    if e2 == float("inf"):
        ratio = 0.0
    elif e2 <= 0.0:
        ratio = 1.0
    else:
        ratio = e1 / e2
    if ratio > MAX_AMBIGUITY_RATIO:
        return None
    return solve


def _yaml_block(path, key):
    """The float list under `key:`/`data:` in a ROS CameraInfo YAML, or None.

    A block scanner, not a YAML parser: it wants one flat `- <float>` sequence under one named
    mapping and gives up on anything else. That is all the schema this is checking against
    contains, and PyYAML is not in this project's shell — adding a dependency so that a
    self-test can read nine numbers would be the wrong trade.
    """
    try:
        with open(path) as fh:
            lines = fh.read().splitlines()
    except OSError:
        return None
    out, inside, seen_data = [], False, False
    for line in lines:
        stripped = line.strip()
        if not inside:
            if stripped == key + ":":
                inside = True
            continue
        if stripped == "data:":
            seen_data = True
            continue
        if stripped.startswith("- ") and seen_data:
            try:
                out.append(float(stripped[2:]))
            except ValueError:
                return None
            continue
        if stripped.startswith("#") or not stripped:
            continue
        if seen_data:
            break  # first non-item line after the sequence ends it
        if ":" in stripped and not stripped.startswith("-"):
            continue  # rows:/cols: before data:
        break
    return out if out else None


