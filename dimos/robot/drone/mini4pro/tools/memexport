# --spy: the same table, from the store's own side
# ─────────────────────────────────────────────────────────────────────────────


def spy(path):
    """What a DiMOS consumer sees. §7.3: this table must match the publisher's."""
    from dimos.memory2.store.sqlite import SqliteStore

    if not os.path.exists(path):
        sys.exit(f"no such store: {path}")
    store = SqliteStore(path=path, must_exist=True)
    names = store.list_streams()
    print(f"{os.path.abspath(path)}\n")
    print("  %-14s %8s  %-17s %-17s %s" % ("stream", "rows", "first", "last", "sha256 of payloads"))
    for name in names:
        try:
            st = store.stream(name)
        except Exception as e:
            print("  %-14s  cannot open: %s" % (name, e))
            continue
        rows = sorted(st.to_list(), key=lambda o: o.ts)
        h = hashlib.sha256()
        for o in rows:
            try:
                h.update(o.data.lcm_encode())
            except Exception:
                h.update(repr(o.data).encode())
        first = f"{rows[0].ts:.3f}" if rows else "—"
        last = f"{rows[-1].ts:.3f}" if rows else "—"
        print("  %-14s %8d  %-17s %-17s %s" % (name, len(rows), first, last, h.hexdigest()[:16]))
    prov = [o for o in store.stream("provenance").to_list()] if "provenance" in names else []
    if prov:
        body = json.loads(prov[0].data.data)
        print("\n  converter    {}".format(body.get("converter")))
        print("  session      {}".format((body.get("header") or {}).get("session")))
        print("  complete     {}".format(body.get("recording_complete")))
        for cav in body.get("caveats", []):
            print(f"  caveat       {cav}")
    store.stop()
    return 0


# ─────────────────────────────────────────────────────────────────────────────
# --selftest: planted data, and planted faults
#
# The discipline this project holds itself to: *a check that has never been shown
# to catch a planted fault is not known to work*. Every assertion below either
# names a metre, a millisecond or an axis, or shows a refusal firing.
# ─────────────────────────────────────────────────────────────────────────────


PLANT_LAT = 60.0  # far from the equator on purpose: cos(60) = 0.5 exactly, so a
PLANT_LON = 20.0  # dropped cos(latitude) doubles the easting rather than nudging it
PLANT_START_MS = 1785000000123


def _plant_record(tmpdir, samples, gimbal=None, frames=None, session="20260101-000000", extra=None):
    """Write a synthetic `mini4pro-flightlog-1` record with exactly the values we planted."""
    path = os.path.join(tmpdir, f"{session}.001.jsonl")
    with open(path, "w") as f:
        f.write(
            json.dumps(
                {
                    "t": 0.0,
                    "k": "header",
                    "format": RECORD_FORMAT,
                    "schema": 1,
                    "session": session,
                    "part": 1,
                    "started_unix_ms": PLANT_START_MS,
                    "started_mono_ns": 1,
                    "meta": {"recorder": {"state_hz": 5}},
                }
            )
            + "\n"
        )
        f.write(json.dumps({"t": 0.0, "k": "dji_field", "f": "fcConnected", "v": "true"}) + "\n")
        f.write(json.dumps({"t": 0.0, "k": "dji_field", "f": "motorsOn", "v": "true"}) + "\n")
        f.write(json.dumps({"t": 0.0, "k": "dji_field", "f": "flightMode", "v": "GPS_ATTI"}) + "\n")
        f.write(json.dumps({"t": 0.0, "k": "dji_field", "f": "batteryPercent", "v": "62"}) + "\n")
        f.write(json.dumps({"t": 0.0, "k": "dji_field", "f": "gpsSignalLevel", "v": "5"}) + "\n")
        f.write(json.dumps({"t": 0.0, "k": "dji_field", "f": "satelliteCount", "v": "14"}) + "\n")
        for g in gimbal or []:
            f.write(json.dumps(dict(g, k="gimbal")) + "\n")
        for s in samples:
            f.write(json.dumps(dict(s, k="dji_state")) + "\n")
        for fr in frames or []:
            f.write(json.dumps(dict(fr, k="frame")) + "\n")
        for e in extra or []:
            f.write(json.dumps(e) + "\n")
    return path


def _sample(
    t, dlat=0.0, dlon=0.0, alt=0.0, roll=0.0, pitch=0.0, yaw=0.0, vn=0.0, ve=0.0, vd=0.0, ages=None
):
    return {
        "t": t,
        "lat": PLANT_LAT + dlat,
        "lon": PLANT_LON + dlon,
        "relalt": alt,
        "roll": roll,
        "pitch": pitch,
        "yaw": yaw,
        "vn": vn,
        "ve": ve,
        "vd": vd,
        "age": ages if ages is not None else {"pos": 10, "relalt": 10, "att": 10, "vel": 10},
    }


class _Args:
    keyframes_only = False
    no_video = False
    gimbal = "auto"
    pose_tolerance = 0.25
    force = True


def selftest(repo):
    """Planted data, planted faults — and the mutations that were measured against it.

    The house mutation protocol applies to this file too: a property this selftest claims to
    hold is only held if breaking it goes red. One mutation at a time, whole selftest per
    mutant, counts MEASURED (2026-07-30, `tools/memexport --selftest`, plus the flight-record
    cross-check where the mutation is about the cross-check itself).

    | # | mutation applied to `tools/memexport`                                       | RED |
    |---|-----------------------------------------------------------------------------|-----|
    | 1 | `setpoint`: `-math.radians(q)` → `-(q / 180.0 * math.pi)` — the defect itself | 1 |
    | 2 | `setpoint`: `-math.radians(q)` → `math.radians(q)` — drop the negation        | 2 |
    | 3 | `first_diff`: drop the length and the two bytes, return `str(i)` as before    | 0 |
    | 4 | cross-check: `per_stream[name] = (s_compared - s_ulp, s_compared)` — stop subtracting the differing messages | 0 |

    Mutation 1 is also the one measured against real flight records, which is where it was
    found: with it applied, `landing16/20260730-161329.001.jsonl` reports **246 of 35038**
    messages differing and `landing17/20260730-172355.001.jsonl` **361 of 47915**, every one
    of them a `setpoint` and every one of them at byte 83 of 84. Without it, both are clean.

    **Survivors 3 and 4 are real and are recorded, not hidden.** Both are properties of how
    the checker *reports*, and this selftest exercises the converter, never the report — it
    never constructs a failing comparison, so nothing here can observe how a failure prints.
    They are held today only by the flight records: mutations 1+4 applied together make
    landing16 print `per stream: … setpoint 1513/1513` on a run whose own aggregate line says
    246 messages differ (measured 2026-07-30) — the same self-contradiction, in the same
    report, that `9 of 33491` was. Closing them properly means a planted mismatching frame
    file driven through `check_against_kotlin`, which needs the runner stubbed out and is a
    bigger change than this fix; until then the KDoc on each states what it must print and
    why, and mutation 1 is what guards the bytes.
    """
    import tempfile

    failures = []

    def check(name, ok, detail=""):
        if ok:
            print(f"  ok    {name}")
        else:
            print(f"  FAIL  {name}   {detail}")
            failures.append(name)

    print("selftest — planted data, one case per axis\n")

    with tempfile.TemporaryDirectory() as tmp:
        # ── 1. one metre per axis, planted and read back ────────────────────
        #
        # A degree of latitude is METRES_PER_DEG metres of north; a degree of longitude at
        # 60N is half that of east. Separate cases per axis because a swapped X/Y and a
        # dropped cos(latitude) both produce entirely plausible-looking output, and a
        # single diagonal case would let one hide the other.
        north_deg = 25.0 / METRES_PER_DEG  # 25 m north
        east_deg = 40.0 / (METRES_PER_DEG * math.cos(math.radians(PLANT_LAT)))  # 40 m east
        samples = [
            _sample(0.0),  # the origin itself
            _sample(0.2, dlat=north_deg),  # +25 m north only
            _sample(0.4, dlon=east_deg),  # +40 m east only
            _sample(0.6, alt=12.5),  # +12.5 m up only
        ]
        path = _plant_record(tmp, samples)
        header, entries, _ = read_records([path])
        s = build_samples(header, entries)
        origin = takeoff_origin(s)
        d = derive(s, origin)

        got = [x.position for x in d]
        check("origin sample is (0, 0, 0)", all(abs(v) < 1e-9 for v in got[0]), str(got[0]))
        check(
            "+25 m north lands on ENU y, not x",
            abs(got[1][1] - 25.0) < 1e-6 and abs(got[1][0]) < 1e-9,
            f"east={got[1][0]:.6f} north={got[1][1]:.6f}",
        )
        check(
            "+40 m east lands on ENU x, not y",
            abs(got[2][0] - 40.0) < 1e-6 and abs(got[2][1]) < 1e-9,
            f"east={got[2][0]:.6f} north={got[2][1]:.6f}",
        )
        check("+12.5 m up lands on ENU z, positive", abs(got[3][2] - 12.5) < 1e-9, str(got[3]))

        # The cos(latitude) itself, stated as the number it is: at 60N one degree of
        # longitude is exactly half a degree of latitude in metres. Dropping the factor
        # doubles the easting, which is 21% at this project's own site and 100% here.
        e_raw, _ = enu_metres(PLANT_LAT, PLANT_LON, PLANT_LAT, PLANT_LON + 1.0)
        check(
            "cos(latitude) is applied to easting",
            abs(e_raw - METRES_PER_DEG * 0.5) < 1e-6,
            f"1 deg lon at 60N = {e_raw:.3f} m, expected {METRES_PER_DEG * 0.5:.3f}",
        )

        # ── 2. the millisecond ──────────────────────────────────────────────
        #
        # `t = 0.2` on a record started at ...123 ms is ...323 ms and nothing else. The
        # store's ts, the LCM header's stamp and this arithmetic must be the same number.
        msgs = Messages()
        ts = s[1].unix
        check(
            "t=0.200 stamps at started_unix_ms + 200 ms exactly",
            ts == (PLANT_START_MS + 200) / 1000.0,
            f"{ts!r}",
        )
        pose_msg = msgs.pose(ts, got[1], enu_quaternion(0, 0, 0))
        back = msgs.PoseStamped.lcm_decode(pose_msg.lcm_encode())
        check(
            "the payload's own header stamp equals the store ts",
            abs(back.ts - ts) < 5e-7,
            f"{back.ts!r} vs {ts!r}",
        )
        check(
            "round-tripped position is the planted metre",
            abs(back.position.y - 25.0) < 1e-6,
            str(back.position),
        )

        # Rounding: Java's Math.round, not Python's banker's rounding. An exact half must
        # go up, and `round()` would send 0.5 to 0.
        check(
            "an exact half millisecond rounds up, not to even",
            unix_seconds(0, 0.0005) == 0.001 and unix_seconds(0, 0.0015) == 0.002,
            f"{unix_seconds(0, 0.0005)!r} {unix_seconds(0, 0.0015)!r}",
        )

        # ── 3. the frame tree, at a tilted airframe ─────────────────────────
        #
        # This is the subtlest thing in the contract: the gimbal report is
        # earth-referenced, so the edge must compose the airframe's attitude away. Plant a
        # 30-degree roll and a 20-degree pitch under a nadir gimbal and require the camera
        # to still point at the ground. Writing the reported angle straight into the edge
        # fails this by 30 degrees.
        tilt = _sample(0.0, roll=30.0, pitch=20.0, yaw=137.0)
        tpath = _plant_record(
            tmp,
            [tilt],
            gimbal=[{"t": 0.0, "p": -90.0, "r": 0.0, "y": 137.0, "age": 5000}],
            session="20260101-000001",
        )
        th, te, _ = read_records([tpath])
        ts_ = build_samples(th, te)
        td = derive(ts_, takeoff_origin(ts_))[0]
        src, gtags = gimbal_source(ts_[0], {})
        q_edge = camera_edge(ts_[0], td.orientation, src)
        # Compose the edge back out and look at where the camera's +x (its view axis at
        # pitch 0, forward) ends up in the world.
        world_from_camera = q_mul(td.orientation, q_edge)
        view = q_rotate(world_from_camera, (1.0, 0.0, 0.0))
        check(
            "a nadir gimbal points down in world despite 30 deg of roll",
            abs(view[0]) < 1e-9 and abs(view[1]) < 1e-9 and abs(view[2] + 1.0) < 1e-9,
            "camera +x in world = ({:.6f}, {:.6f}, {:.6f})".format(*view),
        )
        # ... and the planted fault: the reported angle straight into the edge.
        naive = enu_quaternion(0.0, -90.0, 137.0)
        naive_view = q_rotate(q_mul(td.orientation, naive), (1.0, 0.0, 0.0))
        off_deg = math.degrees(math.acos(max(-1.0, min(1.0, -naive_view[2]))))
        check(
            "planted fault: the uncomposed edge misses the ground by tens of degrees",
            off_deg > 20.0,
            f"off by {off_deg:.1f} deg",
        )
        check(
            "the reported gimbal's age travels with the edge",
            gtags.get("gimbal_age_ms") == 5000 and gtags.get("gimbal_src") == "reported",
            str(gtags),
        )

        # The optical edge, which is exact and free: +z of camera_optical must be the
        # camera's forward axis, +y its down.
        ox = q_rotate(OPTICAL_Q, (0.0, 0.0, 1.0))
        oy = q_rotate(OPTICAL_Q, (0.0, 1.0, 0.0))
        check("camera_optical +z is the camera's forward axis", abs(ox[0] - 1.0) < 1e-9, str(ox))
        check("camera_optical +y is the camera's down axis", abs(oy[2] + 1.0) < 1e-9, str(oy))

        # ── 4. the causal rule ──────────────────────────────────────────────
        #
        # Fault 5 of the contract, and the one a converter can commit and a live publisher
        # cannot: filling a gap from both sides. A sample before the first position must
        # produce no pose at all — not an interpolation, and not a zero.
        blind = [
            {
                "t": 0.0,
                "lat": None,
                "lon": None,
                "relalt": 0.0,
                "roll": 0.0,
                "pitch": 0.0,
                "yaw": 0.0,
                "vn": 0.0,
                "ve": 0.0,
                "vd": 0.0,
                "age": {"pos": 10, "relalt": 10, "att": 10, "vel": 10},
            },
            _sample(0.2, dlat=north_deg),
        ]
        bpath = _plant_record(tmp, blind, session="20260101-000002")
        bh, be, _ = read_records([bpath])
        bs = build_samples(bh, be)
        bd = derive(bs, takeoff_origin(bs))
        check(
            "no pose before the first position — the gap is not filled from the right",
            "pose" not in bd[0].channels and "pose" in bd[1].channels,
            str(bd[0].reasons),
        )

        # And fault 4: `odom` may never publish from a held velocity. A stale VELOCITY must
        # withhold odom while pose sails on.
        stale_vel = [_sample(0.0, ages={"pos": 10, "relalt": 10, "att": 10, "vel": 9000})]
        vpath = _plant_record(tmp, stale_vel, session="20260101-000003")
        vh, ve_, _ = read_records([vpath])
        vs = build_samples(vh, ve_)
        vd = derive(vs, takeoff_origin(vs))[0]
        check(
            "planted fault: a 9 s old velocity withholds odom and not pose",
            "odom" not in vd.channels and "pose" in vd.channels,
            str(vd.reasons),
        )

        # ... and the liveness gate is about the link, not about the data. With
        # fcConnected false every dense stream stops, even though every reading is fresh.
        dead = os.path.join(tmp, "dead.001.jsonl")
        with open(vpath) as fh, open(dead, "w") as out:
            for line in fh:
                out.write(
                    line.replace(
                        '"f": "fcConnected", "v": "true"', '"f": "fcConnected", "v": "false"'
                    )
                )
        dh, de, _ = read_records([dead])
        ds = build_samples(dh, de)
        dd = derive(ds, takeoff_origin(ds))[0]
        check(
            "planted fault: a dead link stops pose even with fresh readings",
            "pose" not in dd.channels and dd.reasons["pose"] == "LINK_DOWN",
            str(dd.reasons),
        )

        # ── 5. video, and the two refusals ──────────────────────────────────
        sps = bytes([0, 0, 0, 1, 0x67, 0x42, 0x00, 0x1E, 0xFF])
        pps = bytes([0, 0, 0, 1, 0x68, 0xCE, 0x38, 0x80])
        # slice_header: first_mb_in_slice=0 (bit '1'), slice_type=7 (I) -> ue(7)='0001000'
        idr = bytes([0, 0, 0, 1, 0x65]) + bytes([0b10001000, 0x80, 0x00])
        # slice_type=0 (P) -> ue(0)='1'
        inter = bytes([0, 0, 0, 1, 0x41]) + bytes([0b11000000, 0x80, 0x00])
        # slice_type=1 (B) -> ue(1)='010'
        bframe = bytes([0, 0, 0, 1, 0x41]) + bytes([0b10100000, 0x80, 0x00])
        keyblob = sps + pps + idr

        check(
            "a well-formed keyframe passes the conformance check",
            check_frame({"n": 1, "key": True}, keyblob) == [7, 8, 5],
        )
        check(
            "an inter frame is a single slice NAL",
            check_frame({"n": 2, "key": False}, inter) == [1],
        )
        check(
            "planted fault: a B slice is refused",
            _raises(VideoFault, check_frame, {"n": 3, "key": False}, bframe),
        )
        check(
            "planted fault: a keyframe stripped of its SPS is refused",
            _raises(VideoFault, check_frame, {"n": 4, "key": True}, pps + idr),
        )

        # The whole video path, end to end, against a planted sidecar.
        vsession = "20260101-000004"
        blob = keyblob + inter
        with open(os.path.join(tmp, f"{vsession}.v001.h264"), "wb") as fh:
            fh.write(blob)
        vframes = [
            {
                "t": 0.10,
                "n": 1,
                "part": 1,
                "off": 0,
                "len": len(keyblob),
                "key": True,
                "pts": 111,
                "w": 1920,
                "h": 1080,
                "mime": "H264",
            },
            {
                "t": 0.14,
                "n": 2,
                "part": 1,
                "off": len(keyblob),
                "len": len(inter),
                "key": False,
                "pts": 151,
                "w": 1920,
                "h": 1080,
                "mime": "H264",
            },
        ]
        vpath2 = _plant_record(
            tmp,
            samples,
            frames=vframes,
            session=vsession,
            gimbal=[{"t": 0.0, "p": -90.0, "r": 0.0, "y": 0.0, "age": 10}],
        )
        args = _Args()
        c, msgs2 = convert([vpath2], args)
        check(
            "the sidecar's bytes arrive verbatim, keyframe first",
            len(c.rows["color_image"]) == 2
            and bytes(c.rows["color_image"][0][1].data) == keyblob
            and bytes(c.rows["color_image"][1][1].data) == inter,
            "%d frames" % len(c.rows["color_image"]),
        )
        check(
            "a video frame is stamped from the record's clock, not from `pts`",
            c.rows["color_image"][0][0] == (PLANT_START_MS + 100) / 1000.0,
            "{!r}".format(c.rows["color_image"][0][0]),
        )
        check(
            "`pts` is carried in tags and never stamped with",
            c.rows["color_image"][0][3]["pts"] == 111,
        )
        check(
            "the video's frame_id is the optical leaf the schema defines for itself",
            c.rows["color_image"][0][1].frame_id == FRAME_CAMERA_OPTICAL,
        )

        # ── 5b. camera_info ─────────────────────────────────────────────────
        ci = c.rows["camera_info"]
        check(
            "camera_info is emitted, in the OPTICAL frame and not the camera frame",
            len(ci) == 1 and ci[0][1].frame_id == FRAME_CAMERA_OPTICAL,
            "%d rows, frame_id %r" % (len(ci), ci[0][1].frame_id if ci else None),
        )
        info = ci[0][1]
        check(
            "width and height come from the record's own frame lines",
            info.width == 1920 and info.height == 1080,
            "%dx%d" % (info.width, info.height),
        )
        K = list(info.K)
        check(
            "K is [fx 0 cx; 0 fy cy; 0 0 1] with the principal point at the centre",
            abs(K[1]) < 1e-12
            and abs(K[3]) < 1e-12
            and K[2] == 960.0
            and K[5] == 540.0
            and K[8] == 1.0
            and abs(K[0] - K[4]) < 1e-12,
            str(K),
        )
        # The measured focal length, and not the spec figure a consumer would otherwise
        # invent. 13.2 % apart, which at a true 3 m is the difference between 3.0 and 2.6.
        check(
            "fx is the fitted focal length, ~1457 px at 1920",
            abs(K[0] - 1457.1) < 0.5,
            f"{K[0]:.2f} px",
        )
        spec = FOCAL_OVER_WIDTH_FROM_SPEC * 1920
        check(
            "planted fault: the published-spec focal length is 13% away and would be caught",
            abs(K[0] - spec) / K[0] > 0.10,
            f"{K[0]:.2f} vs spec {spec:.2f}",
        )
        check(
            "distortion is bounded but not calibrated: D is empty, no model is claimed",
            list(info.D) == [] and info.distortion_model == "",
            f"D={list(info.D)!r} model={info.distortion_model!r}",
        )
        check(
            "planted fault: five zeros with plumb_bob would be a claim, and is not what we write",
            not (len(list(info.D)) == 5 and info.distortion_model == "plumb_bob"),
        )
        # ── the same camera, described in two files ──────────────────────────
        #
        # `calib/mini4pro_gimbal_1080.yaml` carries these numbers again, in ROS's CameraInfo
        # schema, for consumers that load a file instead of subscribing. Two places holding
        # one measurement is how measurements drift: tomorrow's chessboard will rewrite the
        # YAML through dimos' own writer, and nothing would otherwise notice that this module
        # still hands out the fitted focal length.
        #
        # Parsed by hand rather than with PyYAML, which is not in this project's shell. The
        # schema is fixed and flat, so a block scanner is enough and is cheaper than a
        # dependency that exists only for a self-test.
        yaml_path = os.path.join(
            os.path.dirname(os.path.abspath(__file__)), "..", "calib", "mini4pro_gimbal_1080.yaml"
        )
        yk = _yaml_block(yaml_path, "camera_matrix")
        yd = _yaml_block(yaml_path, "distortion_coefficients")
        check(
            "calib/mini4pro_gimbal_1080.yaml exists and states a camera matrix",
            yk is not None and len(yk) == 9,
            f"{yk!r}",
        )
        if yk and len(yk) == 9:
            check(
                "the YAML's fx, fy agree with the focal length published here",
                abs(yk[0] - K[0]) < 0.05 and abs(yk[4] - K[0]) < 0.05,
                f"yaml fx={yk[0]:.2f} fy={yk[4]:.2f} vs {K[0]:.2f}",
            )
            check(
                "the YAML's principal point agrees with the one published here",
                yk[2] == K[2] and yk[5] == K[5],
                f"yaml ({yk[2]:.1f}, {yk[5]:.1f}) vs ({K[2]:.1f}, {K[5]:.1f})",
            )
            check(
                "planted fault: a YAML drifting by 1 % on fx would be caught",
                abs(yk[0] * 1.01 - K[0]) >= 0.05,
            )
        # The YAML commits to five zeros where the wire leaves D empty, because dimos'
        # load_camera_info indexes distortion_coefficients.data directly and an empty list
        # would reach cv2.undistort as a broken model rather than an absent one. Different
        # answers, one measurement — so assert the difference is the intended one and not a
        # third opinion about the lens.
        check(
            "the YAML commits to zero distortion where the wire declines to, and only that",
            yd == [0.0] * 5,
            f"{yd!r}",
        )

        check(
            "R is the identity — exact for an unrectified monocular camera, not an assumption",
            list(info.R) == [1, 0, 0, 0, 1, 0, 0, 0, 1],
            str(list(info.R)),
        )
        check(
            "P is K with a zero fourth column",
            list(info.P) == [K[0], 0, K[2], 0, 0, K[4], K[5], 0, 0, 0, 1, 0],
            str(list(info.P)),
        )
        check(
            "every camera_info says calibrated: false, because K[0] is not zero to say it",
            all(
                t.get("calibrated") is False and t.get("intrinsics") == "fitted"
                for _, _, _, t in ci
            ),
            str(ci[0][3]),
        )

        # The record states w/h **only on change plus once at the start** — 1 of 2104 lines
        # on the reference recording — so the resolution is held forward and republished at
        # >=1 Hz. Nothing before the first statement, because absence is not a guess.
        held_frames = (
            [{"t": 0.00, "n": 1, "part": 1, "off": 0, "len": 4}]  # silent
            + [{"t": 0.10, "n": 2, "part": 1, "off": 0, "len": 4, "w": 1920, "h": 1080}]
            + [
                {"t": 0.10 + 0.04 * i, "n": 3 + i, "part": 1, "off": 0, "len": 4}
                for i in range(1, 80)
            ]  # 3.2 s
        )
        hrows, hchanges, _m = camera_info_rows(
            [dict(f, k="frame") for f in held_frames], PLANT_START_MS
        )
        check(
            "nothing is published before a resolution has ever been stated",
            hrows and hrows[0][0] == (PLANT_START_MS + 100) / 1000.0,
            str(hrows[:1]),
        )
        gaps = [b[0] - a[0] for a, b in itertools.pairwise(hrows)]
        check(
            "a held resolution is republished at >=1 Hz, once every second and not oftener",
            len(hrows) == 4 and all(0.99 <= g <= 1.05 for g in gaps) and not hchanges,
            "%d rows, gaps %s" % (len(hrows), [f"{g:.2f}" for g in gaps]),
        )
        check(
            "every republished row carries the held resolution, not a re-guess",
            {r[1] for r in hrows} == {(1920, 1080)},
            str({r[1] for r in hrows}),
        )

        # A resolution change is a different camera, and must appear at the instant it
        # happens rather than be averaged into one matrix.
        changed_frames = [
            dict(vframes[0], t=0.10, w=1920, h=1080),
            dict(vframes[1], t=0.14, w=1280, h=720),
        ]
        cpath = _plant_record(
            tmp,
            samples,
            frames=changed_frames,
            session=vsession + "r",
            gimbal=[{"t": 0.0, "p": -90.0, "r": 0.0, "y": 0.0, "age": 10}],
        )
        os.link(
            os.path.join(tmp, f"{vsession}.v001.h264"),
            os.path.join(tmp, f"{vsession}r.v001.h264"),
        )
        cc, _ = convert([cpath], _Args())
        widths = [t["width"] for _, _, _, t in cc.rows["camera_info"]]
        check(
            "a mid-record resolution change emits its own camera_info at that instant",
            widths == [1920, 1280]
            and len(cc.resolution_changes) == 1
            and abs(cc.rows["camera_info"][1][0] - (PLANT_START_MS + 140) / 1000.0) < 1e-9,
            f"widths={widths} changes={cc.resolution_changes}",
        )
        check(
            "the focal length follows the width rather than being pinned to 1920",
            abs(cc.rows["camera_info"][1][1].K[0] - FOCAL_OVER_WIDTH * 1280) < 1e-9,
            "{:.2f}".format(cc.rows["camera_info"][1][1].K[0]),
        )

        # planted fault: an offset past the end of the part.
        bad_frames = [dict(vframes[0], off=len(blob) - 4)]
        bpath2 = _plant_record(tmp, samples, frames=bad_frames, session=vsession + "x")
        # point it at the same sidecar name so the bytes exist but are the wrong length
        os.link(
            os.path.join(tmp, f"{vsession}.v001.h264"),
            os.path.join(tmp, f"{vsession}x.v001.h264"),
        )
        check(
            "planted fault: a frame whose bytes run past the end of its part is refused",
            _raises(VideoFault, convert, [bpath2], _Args()),
        )

        # ── 6. the whole thing, into a store, and back out ──────────────────
        store_path = os.path.join(tmp, "selftest.db")
        c, msgs3 = convert([vpath2], _Args())
        c.entries = read_records([vpath2])[1]
        c.gimbal_note = None
        c.rows["provenance"].append(
            (c.rows["pose"][0][0], msgs3.text(provenance(c, [vpath2], _Args())), None, {})
        )
        store, streams, written = write_store(store_path, c, msgs3, _Args())
        compared, problems = check_roundtrip(streams, c)
        check(
            "every observation re-encodes to the bytes that went in (%d compared)" % compared,
            not problems,
            "; ".join(problems[:3]),
        )
        vcompared, vproblems = check_video_against_sidecar(streams, vpath2)
        check(
            "every stored frame equals the sidecar's bytes (%d compared)" % vcompared,
            not vproblems,
            "; ".join(vproblems[:3]),
        )
        rec, resid, n, spread = check_origin_by_subtraction(c)
        check(
            "the origin recovered by subtracting gps_location from pose is one constant",
            n > 0 and spread < 1e-3,
            "n=%d spread=%.6f m" % (n, spread),
        )
        tfok, tfproblems, tfnote = check_tf(store, c)
        check(
            "DiMOS's own StreamTF resolves world->camera_optical out of this store",
            tfnote is None and tfok > 0 and not tfproblems,
            tfnote or "; ".join(tfproblems[:2]),
        )
        # ... and the same check with the camera edge withheld must *not* resolve, or it
        # was never testing the chain at all.
        gone = _Args()
        gone.gimbal = "none"
        cg, _ = convert([vpath2], gone)
        check(
            "planted fault: with no camera edge the chain does not resolve",
            not cg.tf_edges.get("base_link->camera"),
            str(dict(cg.tf_edges)),
        )
        check(
            "every stream exists in the store, including the empty ones",
            set(ALL_STREAMS) <= set(store.list_streams()),
            str(sorted(set(ALL_STREAMS) - set(store.list_streams()))),
        )

        # planted fault 1: swap X and Y in the pose column and watch the subtraction break.
        swapped = Conversion()
        swapped.origin = c.origin
        swapped.rows["gps_location"] = c.rows["gps_location"]
        swapped.rows["pose"] = [
            (ts, p, (pose[1], pose[0], *tuple(pose[2:])), t) for ts, p, pose, t in c.rows["pose"]
        ]
        _, _, sn, sspread = check_origin_by_subtraction(swapped)
        check(
            "planted fault: swapped X/Y breaks the origin subtraction by metres",
            sn > 0 and sspread > 1.0,
            "spread=%.3f m over %d samples" % (sspread, sn),
        )

        # ── the quaternion tolerance, shown to be exactly as narrow as stated ──
        #
        # Five plants: the tolerance admits a few-ULP-at-unit-scale disagreement inside a
        # quaternion, and ONLY that — beyond the tolerance fails, a bit-level disagreement
        # outside a quaternion fails even when it is far smaller than the tolerance, and a
        # NaN never matches a number. Each fault must fire or the tolerance is wider than
        # its docstring. The tolerated values are the measured JVM-vs-glibc pair from the
        # yaw-over-tag flight, not synthetic ones.
        from dimos.msgs.geometry_msgs.Point import Point as _Pt
        from dimos.msgs.geometry_msgs.PoseStamped import PoseStamped as _PS
        from dimos.msgs.geometry_msgs.Quaternion import Quaternion as _Q

        ref = _PS(ts=1.0, frame_id="drone/world")
        ref.position = _Pt(1.25, -2.5, 3.75)
        ref.orientation = _Q(
            0.004391716062693248, -0.0016725289399545016, -0.6775161975411673, 0.7354928399014689
        )

        def _variant(**kw):
            v = _PS.lcm_decode(ref.lcm_encode())
            for k, val in kw.items():
                obj, attr = (v.orientation, k[1:]) if k.startswith("q") else (v.position, k[1:])
                setattr(obj, attr, val)
            return v.lcm_encode()

        check(
            "the measured JVM z (1 ULP of 0.68) is tolerated",
            _agrees_to_quat_ulp(ref, _variant(qz=-0.6775161975411674)),
        )
        check(
            "the measured JVM y (2 ULP of 0.0017, 4.3e-19 absolute) is tolerated",
            _agrees_to_quat_ulp(ref, _variant(qy=-0.001672528939954502)),
        )
        check(
            "planted fault: a quaternion component off by 1e-15 fails",
            not _agrees_to_quat_ulp(ref, _variant(qz=ref.orientation.z + 1e-15)),
        )
        check(
            "planted fault: 1 ULP on a position component fails",
            not _agrees_to_quat_ulp(ref, _variant(px=math.nextafter(ref.position.x, math.inf))),
        )
        check(
            "planted fault: NaN against a number in a quaternion fails",
            not _agrees_to_quat_ulp(ref, _variant(qw=math.nan)),
        )

        # ── the detections stream, held to the Kotlin encoder by its own fixtures ──
        #
        # The Kotlin cross-check cannot cover `detections` from a replay (no reader), so
        # this is the plant that stands in for it: rebuild the fixtures the Kotlin
        # encoder's LcmFixtureTest asserts byte-for-byte, from this converter's own
        # builders, with the fixtures' planted values. Passing means converter == fixture
        # == Kotlin encoder == DiMOS lcm_encode, the full square. The gates get their own
        # plants because the fixtures only exercise the publishing path.
        #
        # **Both halves are planted**, the wire message and the element inside it. The
        # array is what the channel carries and is what a subscriber decodes; the element
        # is where every field decision lives, and a wrapper that quietly rebuilt its
        # contents would still match an array fixture built the same wrong way. Two
        # fixtures, one built from `detection` and one from `detection_element`, is what
        # makes that impossible.
        fixture_dir = os.path.join(repo, "android", "app", "src", "test", "resources", "lcm")
        planted = dict(tag_id=7, margin=41.75, x=-0.375, y=0.8125, z=3.5, metric=False)
        stamp = msgs.LcmTime(sec=1753622400, nsec=987654321)
        det = msgs.detection(stamp, 4242, **planted)
        element = msgs.detection_element(stamp, 4242, **planted)
        for name, msg in (
            ("vision_msgs_Detection3DArray", det),
            ("vision_msgs_Detection3D", element),
        ):
            with open(os.path.join(fixture_dir, name + ".bin"), "rb") as fh:
                check(
                    f"{name} encodes byte-identically to the Kotlin encoder's fixture",
                    msg.lcm_encode() == fh.read(),
                )
        check(
            "the array's header is the element's, restated not invented",
            det.detections_length == 1
            and det.header.seq == element.header.seq
            and det.header.stamp.sec == element.header.stamp.sec
            and det.header.stamp.nsec == element.header.stamp.nsec
            and det.header.frame_id == element.header.frame_id,
        )
        tag_line = {
            "id": 7,
            "margin": 41.75,
            "w": 1920,
            "h": 1080,
            "x": -0.375,
            "y": 0.8125,
            "z": 3.5,
            "metric": False,
        }
        ok_det, ok_why = detection_row(msgs, dict(tag_line), 100.0, 1)
        check("a sighting with a range publishes", ok_det is not None, str(ok_why))
        for fault, patch in (
            ("z=0 (range unknown) is withheld", {"z": 0.0}),
            ("NaN x is withheld", {"x": float("nan")}),
            ("no frame geometry is withheld", {"w": 0}),
        ):
            bad_det, why = detection_row(msgs, {**tag_line, **patch}, 100.0, 1)
            check("planted fault: " + fault, bad_det is None, str(why))

        # ── the pose solve, held to the Kotlin encoder the same way ──
        #
        # The solved fixture rebuilt from this converter's own builders (converter ==
        # fixture == Kotlin encoder == DiMOS lcm_encode, the same square as above), then
        # the gates planted one fault at a time: each must degrade the message to the
        # LEGACY bytes — not withhold it, not partially solve it. The legacy-equality
        # plants are the backward-compat contract in executable form: a record from before
        # the fields produces the same bytes it produced before they existed.
        solved_planted = dict(
            qx=0.20056212,
            qy=-0.09442657,
            qz=0.47555491,
            qw=0.85078055,
            tx=0.0625,
            ty=-0.03125,
            tz=3.46875,
            e1=1.5e-7,
            e2=6.5e-7,
            tag_m=0.075,
        )
        solved_det = msgs.detection_element(
            msgs.LcmTime(sec=1753622400, nsec=987654321),
            9,
            7,
            41.75,
            -0.375,
            0.8125,
            3.5,
            False,
            dict(solved_planted),
        )
        with open(os.path.join(fixture_dir, "vision_msgs_Detection3D_solved.bin"), "rb") as fh:
            check(
                "the SOLVED element encodes byte-identically to the Kotlin fixture",
                solved_det.lcm_encode() == fh.read(),
            )
        solved_arr = msgs.detection(
            msgs.LcmTime(sec=1753622400, nsec=987654321),
            9,
            7,
            41.75,
            -0.375,
            0.8125,
            3.5,
            False,
            dict(solved_planted),
        )
        with open(os.path.join(fixture_dir, "vision_msgs_Detection3DArray_solved.bin"), "rb") as fh:
            check(
                "the SOLVED array encodes byte-identically to the Kotlin fixture",
                solved_arr.lcm_encode() == fh.read(),
            )
        # The id is bare on both (Ivan 2026-07-29), so the NaN convention is now the ONLY
        # carrier of the solved fact — load-bearing, and pinned as such: a solved message
        # has a real box and orientation, an unsolved one is NaN there, and their ids are
        # identical.
        unsolved_det = msgs.detection_element(
            msgs.LcmTime(sec=1, nsec=0), 1, 7, 41.75, -0.375, 0.8125, 3.5, False, None
        )
        check(
            "the id is the bare label on solved and unsolved alike",
            solved_det.id == "tag36h11:7" and unsolved_det.id == "tag36h11:7",
            f"{solved_det.id!r} {unsolved_det.id!r}",
        )
        check(
            "the solved fact travels structurally: NaN box unsolved, real box solved",
            math.isnan(unsolved_det.bbox.size.x)
            and math.isnan(unsolved_det.results[0].pose.pose.orientation.w)
            and solved_det.bbox.size.x == 0.075
            and not math.isnan(solved_det.results[0].pose.pose.orientation.w),
        )

        solved_line = {**tag_line, "px": 80.0, **solved_planted}
        legacy_bytes = detection_row(msgs, dict(tag_line, px=80.0), 100.0, 1)[0].lcm_encode()
        good = detection_row(msgs, dict(solved_line), 100.0, 1)[0]
        check(
            "a whole solve above both gates publishes a solved message",
            good.detections[0].bbox.size.z == 0.0 and good.detections[0].bbox.size.x == 0.075,
        )
        check(
            "the solve does not move the published position",
            good.detections[0].results[0].pose.pose.position.x == -0.375
            and good.detections[0].results[0].pose.pose.position.z == 3.5,
        )
        for fault, patch in (
            ("below the pixel gate (14 px at the 8 m arming altitude)", {"px": 14.0}),
            ("just under the pixel gate", {"px": 59.9}),
            ("ambiguous (e1/e2 = 0.94, the measured outlier median)", {"e1": 9.4e-7, "e2": 1.0e-6}),
            ("partial solve (NaN qw)", {"qw": float("nan")}),
            ("partial solve (missing tz)", {"tz": None}),
            ("tag behind the camera", {"tz": -3.0}),
            ("no tag size", {"tag_m": 0.0}),
        ):
            got = detection_row(msgs, {**solved_line, **patch}, 100.0, 1)[0]
            check(
                "planted gate fault degrades to the LEGACY bytes: " + fault,
                got is not None and got.lcm_encode() == legacy_bytes,
            )
        check(
            "a record from before the fields produces the legacy bytes unchanged",
            detection_row(msgs, dict(tag_line, px=80.0), 100.0, 1)[0].lcm_encode() == legacy_bytes,
        )
        inf_line = {**solved_line, "e2": "Infinity"}  # as json.loads hands back the format
        got_inf = detection_row(msgs, inf_line, 100.0, 1)[0]
        check(
            'e2="Infinity" (no second minimum) is unambiguous and publishes solved',
            not math.isnan(got_inf.detections[0].bbox.size.x),
        )

        # ── the setpoint stream: one case per axis, the two signs, and the two gates ──
        #
        # Planted one axis at a time for section 1's reason: a swapped X/Y and a flipped
        # sign both produce plausible-looking output, and a diagonal case lets one hide
        # the other. The values are already at the record's precision, as real lines are.
        def sp(t, **kw):
            return {
                "t": t,
                "k": "stick_cmd",
                "seq": int(t * 10),
                "sp": {
                    "frame": kw.pop("frame", "NED_VELOCITY"),
                    "vn": kw.pop("vn", 0),
                    "ve": kw.pop("ve", 0),
                    "vd": kw.pop("vd", 0),
                    "yawrate": kw.pop("yawrate", 0),
                    "units": "m/s;deg",
                },
                "path": "advanced_param",
                **kw,
            }

        sp_lines = [
            sp(0.1, vn=1.5, accepted=True),  # north only
            sp(0.2, ve=2.25, accepted=True),  # east only
            sp(0.3, vd=1.5, accepted=True),  # down only
            sp(0.4, yawrate=90, accepted=True),  # yaw rate only
            sp(0.5, accepted=True),  # all zeros — a command
            sp(0.6, vn=1.0),  # shadow: accepted absent
            sp(0.7, vn=1.0, frame="BODY_VELOCITY", accepted=True),  # unconvertible frame
            sp(0.8, vn=0.5, accepted=False),  # refused send WAS a send
            # landing16's own yaw rate, planted because 90 deg/s cannot see this bug:
            # 90/180 is an exact halving so `deg/180*PI` and `deg*(PI/180)` agree, and every
            # flown record before landing16 commanded yawrate 0. −84.54 is one of the inputs
            # where the two expressions differ in the last bit. See SETPOINT_YAWRATE_ULP.
            sp(0.9, yawrate=SETPOINT_YAWRATE_ULP_DEG, accepted=True),
        ]
        # ... and the tag stream's world half beside it, on the same planted record. The
        # fix values are deliberately unrelated to anything derivable from the camera-frame
        # x/y/z on the same line — the artifact plant: a converter that re-derived the fix
        # consumer-style could not reproduce them.
        tag = {
            "id": 7,
            "margin": 41.8,
            "w": 1920,
            "h": 1080,
            "cx": 900.0,
            "cy": 500.0,
            "px": 80.0,
            "ham": 0,
            "x": -0.375,
            "y": 0.8125,
            "z": 3.5,
            "metric": False,
        }
        tag_lines = [
            dict(tag, t=0.15, n=12.345, e=-4.567, from_h=7.5, bearing_assumed=True),
            dict(
                tag,
                t=0.25,
                n=1.0,
                e=2.0,
                from_h=1.2,
                fix_metric=True,
                range_m=1.9,
                range_src="solve",
                bearing_assumed=True,
                pitch_reported=True,
            ),
            dict(tag, t=0.35),  # no fix at all
            {
                **{k: v for k, v in tag.items()},
                "t": 0.45,
                "n": 3.0,
                "e": 4.0,
                "from_h": 2.0,
                "range_src": "size",
                "bearing_assumed": True,
            },
        ]
        # ... and the wind stream on the same planted record: landing14's own ramp endpoints
        # (22 and 91 dm/s), a zero (a calm day IS a measurement), and a value-less line (DJI
        # withdrawing the reading — landing14's last wind line). Values as the record writes
        # them: JSON strings of DJI's integers.
        wind_lines = [
            {"t": 0.12, "k": "dji_field", "f": "windSpeedDmS", "v": "0"},
            {"t": 0.22, "k": "dji_field", "f": "windSpeedDmS", "v": "22", "prev": "0"},
            {"t": 0.32, "k": "dji_field", "f": "windSpeedDmS", "v": "91", "prev": "22"},
            {"t": 0.42, "k": "dji_field", "f": "windSpeedDmS", "prev": "91"},
        ]
        spath = _plant_record(
            tmp,
            [_sample(0.0)],
            session="20260101-000009",
            extra=sp_lines + [dict(e, k="tag") for e in tag_lines] + wind_lines,
        )
        sc, smsgs = convert([spath], _Args())
        rows = sorted(sc.rows["setpoint"], key=lambda r: r[0])
        check(
            "six real sends publish; shadow and BODY frame are refused by name",
            len(rows) == 7
            and sc.reasons["setpoint"]["not_sent"] == 1
            and sc.reasons["setpoint"]["setpoint_frame_unsupported"] == 1,
            str(dict(sc.reasons["setpoint"])),
        )
        tw = [r[1] for r in rows]
        check(
            "+1.5 m/s north lands on ENU linear.y, alone",
            tw[0].linear.y == 1.5 and tw[0].linear.x == 0.0 and tw[0].linear.z == 0.0,
            str(tw[0].linear),
        )
        check(
            "+2.25 m/s east lands on ENU linear.x, alone",
            tw[1].linear.x == 2.25 and tw[1].linear.y == 0.0,
            str(tw[1].linear),
        )
        check(
            "+1.5 m/s DOWN lands on ENU linear.z as -1.5 — the sign that ends in the ground",
            tw[2].linear.z == -1.5,
            str(tw[2].linear),
        )
        check(
            "+90 deg/s clockwise yaw is ENU angular.z = -pi/2 rad/s, exactly",
            tw[3].angular.z == -(90.0 / 180.0 * math.pi),
            repr(tw[3].angular.z),
        )
        # ── the degree→radian expression, pinned to the JVM and not to itself ──
        #
        # The +90 check above is the shape that let the real bug through for two flights:
        # it re-derives the expectation with the SAME Python expression the converter uses,
        # so any expression at all satisfies it, and it picks the one value where the two
        # candidate expressions agree anyway. This pin is the opposite on both counts — the
        # expected bytes come from a JVM running the shipping `-Math.toRadians(qr)`, and the
        # planted rate is one the two expressions disagree on. The last assertion is the
        # important one: it proves the plant is still discriminating, so this test cannot
        # quietly stop testing if someone edits the constant.
        z_bytes = struct.pack(">d", tw[6].angular.z).hex()
        check(
            "-84.54 deg/s yaw encodes as the JVM's -Math.toRadians, bit for bit",
            z_bytes == SETPOINT_YAWRATE_ULP_JVM_HEX,
            z_bytes,
        )
        check(
            "the retired `deg/180*PI` spelling really does differ here (the plant bites)",
            struct.pack(">d", -(SETPOINT_YAWRATE_ULP_DEG / 180.0 * math.pi)).hex()
            != SETPOINT_YAWRATE_ULP_JVM_HEX,
        )
        check(
            "a zero setpoint is a command and publishes",
            tw[4].linear.x == 0.0 and tw[4].linear.y == 0.0 and tw[4].linear.z == 0.0,
        )
        check(
            "angular.x/y are NaN — no roll/pitch rate is ever commanded",
            math.isnan(tw[0].angular.x) and math.isnan(tw[0].angular.y),
        )
        check(
            "a refused send was still a send and publishes",
            any(t["accepted"] is False for _, _, _, t in rows),
        )
        check(
            "the frame is drone/world and the stamp is the record's own millisecond",
            tw[0].frame_id == FRAME_WORLD and rows[0][0] == (PLANT_START_MS + 100) / 1000.0,
            f"{tw[0].frame_id} {rows[0][0]!r}",
        )
        # ── the wind stream: the conversion, the zero, and the withdrawn reading ──
        wrows = sorted(sc.rows["wind"], key=lambda r: r[0])
        check(
            "three wind deliveries publish; the value-less line is wind_missing, not 0.0",
            len(wrows) == 3 and sc.reasons["wind"]["wind_missing"] == 1,
            str(dict(sc.reasons["wind"])),
        )
        # Byte pins against DiMOS's own generated encoder output — the same golden hexes
        # ZenohWindTest pins on the Kotlin side, so the two mirrors are held to one wire.
        # 91 dm/s -> 9.1 m/s: the landing14 value this stream exists for; a broken /10
        # (0x42b60000 = 91.0f) and a double-width encode both fail here.
        check(
            "0 dm/s is a calm day and encodes as 0.0f (12 bytes)",
            wrows[0][1].lcm_encode().hex() == "0adc26b8f0546dd300000000",
            wrows[0][1].lcm_encode().hex(),
        )
        check(
            "22 dm/s -> 2.2 m/s, byte-identical to the generated encoder",
            wrows[1][1].lcm_encode().hex() == "0adc26b8f0546dd3400ccccd",
            wrows[1][1].lcm_encode().hex(),
        )
        check(
            "91 dm/s -> 9.1 m/s — landing14's number, never 91.0 or 0.91",
            wrows[2][1].lcm_encode().hex() == "0adc26b8f0546dd34111999a",
            wrows[2][1].lcm_encode().hex(),
        )
        check(
            "the wind stamp is the record's own millisecond and the dm/s rides the tags",
            wrows[1][0] == (PLANT_START_MS + 220) / 1000.0 and wrows[1][3]["dms"] == 22,
            f"{wrows[1][0]!r} {wrows[1][3]!r}",
        )
        fixrows = sorted(sc.rows["tag_fix"], key=lambda r: r[0])
        check(
            "three fixes publish, the fixless sighting is fix_unavailable",
            len(fixrows) == 3 and sc.reasons["tag_fix"]["fix_unavailable"] == 1,
            str(dict(sc.reasons["tag_fix"])),
        )
        f0 = fixrows[0][1].detections[0]
        check(
            "the fix is the record's OWN n/e — east on x, north on y, never re-derived",
            f0.results[0].pose.pose.position.x == -4.567
            and f0.results[0].pose.pose.position.y == 12.345,
            str((f0.results[0].pose.pose.position.x, f0.results[0].pose.pose.position.y)),
        )
        check(
            "z is the datum-plane assumption (0.0), not the baro height on the line",
            f0.results[0].pose.pose.position.z == 0.0 and f0.header.frame_id == FRAME_WORLD,
        )
        check(
            "a legacy bearing fix's id is the bare label — absent rung means unrecorded",
            f0.id == "tag36h11:7",
            f0.id,
        )
        f1 = fixrows[1][1].detections[0]
        check(
            "metric-fix provenance carries the rung and the pitch belief, minimally",
            f1.id == "tag36h11:7;range=solve;pitch=reported",
            f1.id,
        )
        f2 = fixrows[2][1].detections[0]
        check(
            "a size-scaled bearing fix carries range=size", f2.id == "tag36h11:7;range=size", f2.id
        )
        check(
            "the world fix's orientation and box are refused entire (NaN)",
            math.isnan(f0.results[0].pose.pose.orientation.w) and math.isnan(f0.bbox.size.x),
        )
        check(
            "from_h and range_m ride the row tags, queryable without decoding",
            fixrows[1][3]["from_h"] == 1.2 and fixrows[1][3]["range_m"] == 1.9,
            str(fixrows[1][3]),
        )

        # planted fault 15: two flights in one store show as two origins.
        far = Conversion()
        far.origin = c.origin
        far.rows["gps_location"] = c.rows["gps_location"] + [
            (ts + 1000, p, pose, t) for ts, p, pose, t in c.rows["gps_location"]
        ]
        shifted = []
        for ts, p, pose, t in c.rows["pose"]:
            shifted.append((ts + 1000, p, (pose[0] + 6.0, pose[1], pose[2], *tuple(pose[3:])), t))
        far.rows["pose"] = c.rows["pose"] + shifted
        _, _, fn, fspread = check_origin_by_subtraction(far)
        check(
            "planted fault: a second flight's origin shows as a second origin",
            fspread > 1.0,
            "spread=%.3f m over %d samples" % (fspread, fn),
        )

        store.stop()

    print()
    if failures:
        print("selftest FAILED: %d of the planted checks did not hold" % len(failures))
        for f in failures:
            print("  " + f)
        return 1
    print("selftest ok — every check above was shown to hold, and every planted fault to fire")
    return 0


def _raises(exc, fn, *a, **kw):
    try:
        fn(*a, **kw)
    except exc:
        return True
    except SystemExit:
        return False
    return False


