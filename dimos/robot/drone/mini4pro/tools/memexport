# The causal derivation
# ─────────────────────────────────────────────────────────────────────────────


class Sample:
    """One `dji_state` line, with everything true of the aircraft at that instant."""

    __slots__ = ("fold", "gimbal", "gimbal_t", "state", "t", "unix")

    def __init__(self, t, unix, state, fold, gimbal, gimbal_t):
        self.t = t
        self.unix = unix
        self.state = state
        self.fold = fold
        self.gimbal = gimbal  # the last reported gimbal line at or before `t`, or None
        self.gimbal_t = gimbal_t

    # ── the four gated inputs ──────────────────────────────────────────────

    def age_ms(self, signal):
        return (self.state.get("age") or {}).get(AGE_MEMBER[signal])

    def fresh(self, signal):
        a = self.age_ms(signal)
        return a is not None and a <= STALE_AFTER_MS[signal]

    @property
    def link_alive(self):
        """`fcConnected` — about the *link*, not about any datum on it.

        This is the whole of the dense-stream gate. Quiet-because-unchanged and
        quiet-because-dead look identical to any per-key freshness test, because every data
        key falls silent together; only a signal about the link can separate them.
        """
        return self.fold.get("fcConnected") is True

    def allows(self, signal, held):
        return self.link_alive if held else self.fresh(signal)

    def coordinate(self):
        return coordinate_or_none(num(self.state.get("lat")), num(self.state.get("lon")))

    def relalt(self):
        v = num(self.state.get("relalt"))
        return v if finite(v) else None

    def rpy(self):
        r = num(self.state.get("roll"))
        p = num(self.state.get("pitch"))
        y = num(self.state.get("yaw"))
        return (r, p, y) if all(finite(v) for v in (r, p, y)) else None

    def ned_velocity(self):
        vn = num(self.state.get("vn"))
        ve = num(self.state.get("ve"))
        vd = num(self.state.get("vd"))
        return (vn, ve, vd) if all(finite(v) for v in (vn, ve, vd)) else None

    # ── the derived quantities ─────────────────────────────────────────────

    def local_position(self, origin, held):
        """ENU metres from the takeoff origin, or None. Mirrors `localPositionOrNull`."""
        if origin is None:
            return None
        here = self.coordinate()
        if here is None:
            return None
        if not self.allows("POSITION", held):
            return None
        up = self.relalt()
        if up is None:
            return None
        if not self.allows("ALTITUDE", held):
            return None
        east, north = enu_metres(origin[0], origin[1], here[0], here[1])
        return (east, north, up)

    def orientation(self, held):
        rpy = self.rpy()
        if rpy is None or not self.allows("ATTITUDE", held):
            return None
        return enu_quaternion(*rpy)

    def velocity_enu(self):
        """**An aged velocity is not a measured zero.** Fresh or nothing, always."""
        v = self.ned_velocity()
        if v is None or not self.fresh("VELOCITY"):
            return None
        vn, ve, vd = v
        return (ve, vn, -vd)  # ENU x=east=NED y, y=north=NED x, z=up=−down

    def nav_sat_status(self):
        """DJI's signal level and satellite count → `NavSatStatus.status`, a *signed* int8.

        A level of 2 is a marginal 2D solution — enough for a position, not enough to assert
        one — and reports no fix here rather than being rounded up, on the same thresholds
        `TelemetryEncoder.fixType` uses, so the two wires never disagree about whether this
        aircraft has a fix.
        """
        level = self.fold.get("gpsSignalLevel")
        sats = self.fold.get("satelliteCount")
        fixed = level is not None and level >= 3 and (sats is None or sats >= MIN_SATS_FOR_FIX)
        return 0 if fixed else -1


def build_samples(header, entries):
    """Fold the slow fields and the gimbal forward, and pair them with each `dji_state`.

    Fields stamped at or before a sample were already true *in* it: `StateDelta` derives
    them from the state it was handed and writes them after the sample line at the same `t`.
    Folding in file order alone would put every slow value one sample late.

    Nothing here reads a later entry, which is the whole of §3.3.
    """
    started = (header or {}).get("started_unix_ms")
    fold = {}
    gimbal, gimbal_t = None, None
    samples = []
    pending = []  # entries at this `t` not yet folded, kept so `<=` means what it says
    states = [e for e in entries if e.get("k") == "dji_state"]
    slow = [e for e in entries if e.get("k") in ("dji_field", "gimbal")]
    i = 0
    for s in states:
        while i < len(slow) and slow[i]["t"] <= s["t"]:
            e = slow[i]
            if e["k"] == "dji_field":
                binding = FIELD_MAP.get(e.get("f"))
                if binding is not None:
                    attr, kind = binding
                    fold[attr] = parse_value(e.get("v"), kind)
            else:
                gimbal, gimbal_t = e, e["t"]
            i += 1
        samples.append(
            Sample(s["t"], unix_seconds(started, s["t"]), s, dict(fold), gimbal, gimbal_t)
        )
    del pending
    return samples


def takeoff_origin(samples):
    """The local frame's origin: the first fix taken while DJI said the motors were on.

    Read off the record rather than assumed, and **fresh**, not held: a datum recorded from
    a cached fix anchors the whole flight's local frame to wherever the aircraft was the
    last time the GPS spoke, and every local coordinate afterwards inherits that error with
    no way to see it. Falls back to the first usable fix so a ground session still has a
    frame. Returns `(lat, lon, takeoff_altitude_or_None, t)`.

    The origin is **a constant of the flight, not a reading**: captured once, held until the
    aircraft lands, never re-read and never expired. Applying a staleness limit to a
    constant is a category error, and one this project has actually made.
    """
    for require_motors in (True, False):
        for s in samples:
            if require_motors and s.fold.get("motorsOn") is not True:
                continue
            c = s.coordinate()
            if c is None or not s.fresh("POSITION"):
                continue
            return (c[0], c[1], s.fold.get("takeoffAltitudeAmsl"), s.t)
    return None


class Derived:
    """One sample's worth of publishing decisions — what went out and what did not."""

    __slots__ = ("channels", "orientation", "position", "reasons", "sample")

    def __init__(self, sample):
        self.sample = sample
        self.channels = {}  # channel -> the values a message needs
        self.reasons = {}  # channel -> why not, when absent
        self.position = None
        self.orientation = None


def derive(samples, origin):
    """Run the publishing rules over the samples, causally and in order.

    Every decision here is one a live publisher could take with no knowledge of the future.
    """
    out = []
    for s in samples:
        d = Derived(s)

        held_pos = s.local_position(origin, held=True)
        held_ori = s.orientation(held=True)
        d.position, d.orientation = held_pos, held_ori

        # pose — dense. Position, altitude and attitude held under the liveness gate,
        # because this is the channel a landing relies on and a 22 s hole in it is what
        # gating on data freshness actually produced.
        if held_pos is not None and held_ori is not None:
            d.channels["pose"] = (held_pos, held_ori)
        else:
            d.reasons["pose"] = _why(s, origin, held=True)

        # odom — sparse, and that is the honest answer. Every input fresh, velocity
        # included. No holding, no covariance inflation, no pretending.
        fresh_pos = s.local_position(origin, held=False)
        fresh_ori = s.orientation(held=False)
        vel = s.velocity_enu()
        if fresh_pos is not None and fresh_ori is not None and vel is not None:
            d.channels["odom"] = (fresh_pos, fresh_ori, vel)
        else:
            r = _why(s, origin, held=False)
            d.reasons["odom"] = (
                r
                if r != "PUBLISHED"
                else ("VELOCITY_MISSING" if s.ned_velocity() is None else "VELOCITY_STALE")
            )

        # gps_location — the same position under a different projection, so the same gate.
        # There is no defensible reason for the two to disagree about publishability.
        here = s.coordinate()
        up = s.relalt()
        if here is not None and up is not None and s.link_alive:
            d.channels["gps_location"] = (here[0], here[1], up, s.nav_sat_status())
        else:
            d.reasons["gps_location"] = _why_position(s, held=True)

        if held_ori is not None:
            d.channels["imu"] = held_ori
        else:
            d.reasons["imu"] = _why_attitude(s, held=True)

        pct = s.fold.get("batteryPercent")
        if isinstance(pct, int) and 0 <= pct <= 100:
            d.channels["battery"] = pct
        else:
            d.reasons["battery"] = "BATTERY_MISSING"

        mode = s.fold.get("flightMode")
        if mode and mode.strip():
            d.channels["mode"] = mode
        else:
            d.reasons["mode"] = "MODE_MISSING"

        out.append(d)
    return out


def _why_position(s, held):
    if s.coordinate() is None:
        return "POSITION_INVALID"
    if not s.allows("POSITION", held):
        return "LINK_DOWN" if held else "POSITION_STALE"
    if s.relalt() is None:
        return "ALTITUDE_MISSING"
    if not s.allows("ALTITUDE", held):
        return "LINK_DOWN" if held else "ALTITUDE_STALE"
    return "PUBLISHED"


def _why_attitude(s, held):
    if s.rpy() is None:
        return "ATTITUDE_MISSING"
    if not s.allows("ATTITUDE", held):
        return "LINK_DOWN" if held else "ATTITUDE_STALE"
    return "PUBLISHED"


def _why(s, origin, held):
    if origin is None:
        return "NO_ORIGIN"
    r = _why_position(s, held)
    return r if r != "PUBLISHED" else _why_attitude(s, held)


