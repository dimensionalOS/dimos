def sha256_of(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def nearest_pose(pose_rows, ts, tolerance):
    """The pose observation nearest `ts` within `tolerance`, or None.

    A tolerance rather than an interpolation: at this flight's measured p90 speed 0.25 s is
    0.65 m, which is inside what the mission legs actually arrived to, and it still refuses
    to fabricate a position if a future flight loses the link mid-air.
    """
    import bisect

    if not pose_rows:
        return None
    i = bisect.bisect_left(pose_rows, (ts,))
    best = None
    for j in (i - 1, i):
        if 0 <= j < len(pose_rows):
            dt = abs(pose_rows[j][0] - ts)
            if dt <= tolerance and (best is None or dt < best[0]):
                best = (dt, pose_rows[j])
    return None if best is None else best[1]


class Conversion:
    """Everything one record becomes, and the numbers to report about it."""

    def __init__(self):
        self.rows = collections.defaultdict(list)  # stream -> [(ts, payload, pose, tags)]
        self.reasons = collections.defaultdict(collections.Counter)
        self.notes = []
        self.tf_edges = collections.Counter()
        self.video_types = collections.Counter()
        # The `warnings` header's own counter, mirroring the live publisher's `warningsSeen`:
        # one per message offered, so a subscriber (or a reader of the store) can see a gap.
        self.warnings_seq = 0
        self.resolution_changes = []


def convert(paths, args):
    """The whole derivation, in memory. Writing is a separate step so a fault aborts first."""
    header, entries, bad = read_records(paths)
    if header is None:
        sys.exit("no header line in %s — not a flight record?" % (paths[0] if paths else "?"))
    if header.get("format") != RECORD_FORMAT:
        sys.exit(
            "{}: format is {!r}, not {!r}".format(paths[0], header.get("format"), RECORD_FORMAT)
        )

    samples = build_samples(header, entries)
    if not samples:
        sys.exit(
            "no dji_state entries — nothing to convert. A session recorded before MSDK "
            "registration has no DJI half at all; check for an sdk_attached event."
        )

    origin = takeoff_origin(samples)
    derived = derive(samples, origin)
    msgs = Messages()
    c = Conversion()
    c.header, c.samples, c.origin, c.bad_lines = header, samples, origin, bad

    started = header.get("started_unix_ms")

    # ── telemetry ──────────────────────────────────────────────────────────
    for d in derived:
        s = d.sample
        ts = s.unix
        ages = s.state.get("age") or {}
        # The four delivery ages travel with every held pose. Under the liveness gate they
        # matter *more* than before, not less: a held pose is exactly as good as the age of
        # the reading behind it, and the age is the only thing that says which.
        pose_tags = {f"age_{k}_ms": int(v) for k, v in ages.items() if v is not None}
        for ch, value in d.channels.items():
            if ch == "pose":
                position, orientation = value
                c.rows["pose"].append(
                    (
                        ts,
                        msgs.pose(ts, position, orientation),
                        tuple(position) + tuple(orientation),
                        dict(pose_tags),
                    )
                )
            elif ch == "odom":
                position, orientation, velocity = value
                c.rows["odom"].append(
                    (
                        ts,
                        msgs.odom(ts, position, orientation, velocity),
                        tuple(position) + tuple(orientation),
                        {},
                    )
                )
            elif ch == "gps_location":
                lat, lon, alt, status = value
                c.rows["gps_location"].append(
                    (ts, msgs.gps(ts, lat, lon, alt, status), d.position, {"fix": status})
                )
            elif ch == "imu":
                c.rows["imu"].append((ts, msgs.imu(ts, value), d.position, {}))
            elif ch == "battery":
                c.rows["battery"].append(
                    (ts, msgs.battery(ts, s.fold), d.position, {"percent": value})
                )
            elif ch == "mode":
                c.rows["mode"].append((ts, msgs.mode(value), d.position, {"mode": value}))
        for ch, reason in d.reasons.items():
            c.reasons[ch][reason] += 1

    # ── tf ─────────────────────────────────────────────────────────────────
    commanded = commanded_gimbal(entries)
    tf_rows, c.tf_edges = build_tf(derived, commanded, args.gimbal)
    for ts, edges, tags, position in tf_rows:
        tags = dict(tags)
        tags["edges"] = len(edges)
        c.rows["tf"].append((ts, msgs.tf(ts, edges), position, tags))
    c.commanded_gimbal_count = len(commanded)

    # ── the narrative streams ──────────────────────────────────────────────
    pose_index = sorted((ts, pose) for ts, _, pose, _ in c.rows["pose"])

    # ── camera_info ────────────────────────────────────────────────────────
    ci_rows, c.resolution_changes, mimes = camera_info_rows(entries, started)
    # `CompressedVideo.format` is written as "h264" and the conformance checks read H.264
    # NAL types. A record that says otherwise is not a record this tool understands, and
    # storing its bytes under an h264 label would be a consumer's problem rather than ours.
    unexpected = [m for m in mimes if m.upper().replace(".", "") not in ("H264", "VIDEOAVC")]
    if unexpected and not args.no_video:
        raise VideoFault(
            f"the sidecar declares mime {unexpected}, not H264. Every byte-level check here reads "
            "H.264 NAL types and the store would label the frames 'h264'."
        )
    for ts, (w, h) in ci_rows:
        pose = nearest_pose(pose_index, ts, args.pose_tolerance)
        c.rows["camera_info"].append(
            (
                ts,
                msgs.camera_info(ts, w, h),
                pose[1] if pose else None,
                {
                    "width": w,
                    "height": h,
                    "fx": round(FOCAL_OVER_WIDTH * w, 3),
                    # The qualification travels with every observation, because K[0] is non-zero
                    # and ROS's own "uncalibrated" flag is therefore not available to say it.
                    "intrinsics": "fitted",
                    "calibrated": False,
                    # "bounded", not "unmeasured": nothing was found, and the size of the nothing is
                    # carried alongside so a consumer can decide whether zero is good enough for it.
                    "distortion": "bounded-none",
                    "distortion_corner_px": DISTORTION_CORNER_SHIFT_PX,
                    "distortion_corner_ci_px": list(DISTORTION_CORNER_SHIFT_CI_PX),
                    "source": FOCAL_SOURCE,
                    "distortion_source": DISTORTION_SOURCE,
                },
            )
        )
    det_seq = 0
    fix_seq = 0
    for e in entries:
        k = e.get("k")
        ts = unix_seconds(started, e["t"])
        pose = nearest_pose(pose_index, ts, args.pose_tolerance)
        pose = pose[1] if pose else None
        if k == "tag":
            det, why = detection_row(msgs, e, ts, det_seq + 1)
            if det is None:
                c.reasons["detections"][why] += 1
            else:
                det_seq += 1
                c.reasons["detections"]["published"] += 1
                c.rows["detections"].append(
                    (
                        ts,
                        det,
                        pose,
                        {
                            "tag_id": e.get("id"),
                            "px": e.get("px"),
                            "hamming": e.get("ham"),
                            "margin": e.get("margin"),
                            "metric": bool(e.get("metric")),
                            "latched": bool(e.get("latched")),
                            # Whether the pose gates passed — mirrors the `;pose=solved` id marker,
                            # queryable without string-parsing the message.
                            "pose_solved": trusted_solve(
                                float(e.get("px") or float("nan")), solve_of(e)
                            )
                            is not None,
                        },
                    )
                )
            # The same line's world-frame half, onto `tag_fix`. The gate is
            # `ZenohEmission.tagFixReason`'s: a fix (`n`/`e`) is present and finite, or the
            # record itself had no place to offer and the sighting travels on `detections`
            # alone. The numbers on the wire are the line's own — never re-derived here.
            n, ee = num(e.get("n")), num(e.get("e"))
            if n is None or ee is None or not (math.isfinite(n) and math.isfinite(ee)):
                c.reasons["tag_fix"]["fix_unavailable"] += 1
            else:
                fix_seq += 1
                c.reasons["tag_fix"]["published"] += 1
                c.rows["tag_fix"].append(
                    (
                        ts,
                        msgs.tag_fix(
                            msgs.lcm_stamp(ts),
                            fix_seq,
                            e.get("id"),
                            float(e.get("margin") or 0.0),
                            n,
                            ee,
                            bool(e.get("fix_metric")),
                            e.get("range_src"),
                            bool(e.get("pitch_reported")),
                        ),
                        pose,
                        {
                            "tag_id": e.get("id"),
                            # The numbers the id's tokens qualify, queryable without decoding:
                            # the aircraft's baro height at the fix and the solved range when the
                            # fix is metric — landing07-B measured the two disagreeing by ~1.2 m,
                            # which is why both travel.
                            "from_h": e.get("from_h"),
                            "range_m": e.get("range_m"),
                            "fix_metric": bool(e.get("fix_metric")),
                            "range_src": e.get("range_src"),
                            "bearing_assumed": bool(e.get("bearing_assumed")),
                            "pitch_reported": bool(e.get("pitch_reported")),
                            "latched": bool(e.get("latched")),
                        },
                    )
                )
        elif k == "stick_cmd":
            # The commanded velocity, onto `setpoint`. Gates mirror
            # `ZenohEmission.setpointReason`, in its order: a shadow line (`accepted`
            # absent — never handed to the SDK) is NOT_SENT and stays off the bus however
            # well-formed it is; then the frame, then completeness. Zeros publish — a zero
            # setpoint is a command, and absence on this stream must mean no command flowed.
            sp = e.get("sp") or {}
            accepted = e.get("accepted")
            vn, ve_, vd = num(sp.get("vn")), num(sp.get("ve")), num(sp.get("vd"))
            yr = num(sp.get("yawrate"))
            if accepted is None:
                c.reasons["setpoint"]["not_sent"] += 1
            elif not sp or sp.get("frame") is None:
                c.reasons["setpoint"]["setpoint_incomplete"] += 1
            elif sp.get("frame") != "NED_VELOCITY":
                c.reasons["setpoint"]["setpoint_frame_unsupported"] += 1
            elif any(v is None or not math.isfinite(v) for v in (vn, ve_, vd, yr)):
                c.reasons["setpoint"]["setpoint_incomplete"] += 1
            else:
                c.reasons["setpoint"]["published"] += 1
                c.rows["setpoint"].append(
                    (
                        ts,
                        msgs.setpoint(ts, vn, ve_, vd, yr),
                        pose,
                        {
                            "src": (e.get("src") or {}).get("name"),
                            "accepted": bool(accepted),
                            "seq": e.get("seq"),
                        },
                    )
                )
        elif k == "dji_field" and e.get("f") == "windSpeedDmS":
            # DJI's own wind estimate, onto `wind` — one message per record line, and the
            # line exists only when the value changed (KeyWindSpeed is change-driven; the
            # recorder's on-change dedup already ran when the line was written). So this
            # stream is on-delivery by construction: never resampled, never held, and its
            # silence means UNCHANGED, not stale. The gate mirrors `ZenohEmission.windReason`:
            # a value, or nothing — a value-less line is DJI *withdrawing* the reading
            # (landing14's last wind line), and writing 0.0 for it would fabricate a calm.
            try:
                dms = int(e.get("v"))
            except (TypeError, ValueError):
                dms = None
            if dms is None:
                c.reasons["wind"]["wind_missing"] += 1
            else:
                c.reasons["wind"]["published"] += 1
                # The tag keeps the record's own integer beside the converted float, so the
                # dm/s provenance stays queryable without decoding the payload.
                c.rows["wind"].append((ts, msgs.wind(dms), pose, {"dms": dms}))
        elif k == "event":
            text = "{}: {}".format(e.get("code"), e.get("msg") or "")
            c.rows["status"].append(
                (
                    ts,
                    msgs.text(text.strip().rstrip(":")),
                    pose,
                    {"code": e.get("code"), "sev": e.get("sev") or "info"},
                )
            )
        elif k in ("dji_warn", "dji_health"):
            # Every DJI warning, from every source, onto `warnings` -- one message per
            # *change*, exactly as the live bus publishes it, because the line itself is
            # written on change only (`warn/WarningMonitor` owns that diff and the record is
            # downstream of it). Nothing is re-decided here; see `Msgs.warning`.
            c.warnings_seq += 1
            c.reasons["warnings"]["published"] += 1
            c.rows["warnings"].append(
                (
                    ts,
                    msgs.warning(e, ts, c.warnings_seq),
                    pose,
                    {
                        "src": e.get("src") or "health",
                        "code": e.get("code"),
                        "sev": e.get("sev") or "warn",
                        "fwd": bool(e.get("fwd")),
                    },
                )
            )
        elif k == "dji_call" and e.get("phase") != "ask":
            # DJI's verdict, and `none` — no callback ever arrived — is a verdict too, and
            # the measured behaviour of this airframe rather than a defensive possibility.
            text = "{} {}{}".format(
                e.get("op"),
                e.get("phase"),
                (" " + e["err"]) if e.get("err") else "",
            )
            c.rows["command_ack"].append(
                (
                    ts,
                    msgs.text(text),
                    pose,
                    {
                        "op": e.get("op"),
                        "phase": e.get("phase"),
                        "seq": e.get("seq"),
                        "ms": e.get("ms"),
                    },
                )
            )

    # ── video ──────────────────────────────────────────────────────────────
    c.video_missing = set()
    if not args.no_video:
        convert_video(paths[0], c, msgs, args, pose_index)

    return c, msgs


def solve_of(e):
    """The raw pose solve off one `tag` line, or None on a line that predates it.

    All-or-nothing on `qx..tz, e1, tag_m` — `TagTap` writes them as a group, so a partial
    group is a truncated line, and reading half of one would manufacture a partial solve
    the gates exist to refuse. `e2` is coerced through `float()` because the format writes
    a non-finite as the STRING "Infinity" (no second PnP minimum — the unambiguous case,
    59 % of measured solves) and `json.loads` hands it back as a string.
    """
    keys = ("qx", "qy", "qz", "qw", "tx", "ty", "tz", "e1", "tag_m")
    if any(e.get(k) is None for k in keys):
        return None
    solve = {k: float(e[k]) for k in keys}
    e2 = e.get("e2")
    solve["e2"] = float("nan") if e2 is None else float(e2)
    return solve


def detection_row(msgs, e, ts, seq):
    """The publishing gate for one `tag` line: `(message, None)` or `(None, why)`.

    The gates mirror `ZenohTelemetryEncoder.detectionOrNull`, in its order. The one that
    fires in practice is the range: `z` **is** the range along the optical axis, and 0.0 is
    the value the detector substitutes when the tag's apparent size implied none — a
    sighting with no range is withheld, never published at the camera's own origin. `seq`
    counts published messages from 1, exactly as the live channel's counter does; a
    withheld sighting consumes no seq on either side.

    The pose solve rides the same rule the encoder applies: `trusted_solve` (pixel size and
    ambiguity, the measured gates) decides whether the orientation and the box are real,
    and a line without the fields — every record before 2026-07-28 — produces the legacy
    message, byte for byte. That absence-is-legacy path IS the backward-compat contract.
    """
    if e.get("w", 0) <= 0 or e.get("h", 0) <= 0:
        return None, "no_geometry"
    x, y, z = e.get("x"), e.get("y"), e.get("z")
    if x is None or y is None or not (math.isfinite(x) and math.isfinite(y)):
        return None, "no_geometry"
    if z is None or not math.isfinite(z) or z <= 0.0:
        return None, "range_unknown"
    solve = trusted_solve(float(e.get("px") or float("nan")), solve_of(e))
    return msgs.detection(
        msgs.lcm_stamp(ts), seq, e["id"], e["margin"], x, y, z, bool(e.get("metric")), solve
    ), None


def camera_info_rows(entries, started):
    """When a `camera_info` is due, and at what resolution. `(rows, changes, mimes)`.

    Driven by the `frame` lines' own `w`/`h`, never by an assumption. **The record states
    them only on change, plus once at the start** — `LogEntry.Frame` is explicit that a
    resolution change *"invalidates the camera intrinsics every downstream pose solution
    rests on, so it has to be a discrete timestamped line rather than something a reader
    infers by diffing two frames it happened to look at."* Measured on the reference
    recording: 1 of 2104 `frame` lines carries `w`/`h`.

    So the resolution is **held forward**, like every other change-driven value in this
    file, and a frame line that states a *different* one emits immediately and is reported
    as a change rather than averaged into one matrix. Until a resolution has been stated
    once there is nothing to hold and nothing is published — absence, not a guess.

    Between changes the rule is `docs/zenoh-topics.md`'s for a slowly-varying stream: on
    change, ≥1 Hz. Deliberately not "once at the start" — a store is compared against a live
    publisher, and on a bus "once" is invisible to everyone who joined afterwards. No frames
    means no rows, including across a gap where the operator had video switched off: with no
    image there is nothing for a camera matrix to describe.
    """
    frames = sorted((e for e in entries if e.get("k") == "frame"), key=lambda e: e["t"])
    rows, changes, mimes = [], [], collections.Counter()
    held, last_t = None, None
    for fr in frames:
        if fr.get("mime"):
            mimes[fr["mime"]] += 1
        w, h = fr.get("w"), fr.get("h")
        stated = (int(w), int(h)) if w and h else None
        if stated is not None and stated != held:
            if held is not None:
                changes.append((fr["t"], held, stated))
            held = stated
            due = True
        elif held is None:
            continue
        else:
            due = last_t is None or (fr["t"] - last_t) >= CAMERA_INFO_PERIOD_S
        if due:
            rows.append((unix_seconds(started, fr["t"]), held))
            last_t = fr["t"]
    return rows, changes, mimes


def commanded_gimbal(entries):
    """Commanded gimbal pitch by `t`, from `dji_call` asks — normally empty, see the header.

    `DjiOp.GIMBAL_ROTATE` exists and nothing taps it, so this returns `{}` for every record
    written to date. Implemented anyway because the contract specifies it and because the
    day the tap lands, the converter should already prefer it.
    """
    out = {}
    for e in entries:
        if e.get("k") != "dji_call" or e.get("phase") != "ask":
            continue
        if e.get("op") != "gimbal_rotate":
            continue
        args = e.get("args") or {}
        pitch = num(args.get("pitch"))
        if finite(pitch):
            out[e["t"]] = (pitch, e["t"])
    return out


def convert_video(record_path, c, msgs, args, pose_index):
    """The sidecar's own bytes, unmodified, one `CompressedVideo` per access unit."""
    ve = load_videoexport()
    session, frames = ve.read_index(record_path)
    if not frames:
        c.notes.append("no `frame` entries — video was never recorded this session")
        return
    directory = os.path.dirname(os.path.abspath(record_path))
    started = c.header.get("started_unix_ms")

    if args.keyframes_only:
        # The only lossless decimation an inter-frame codec has: each keyframe is a
        # self-contained (SPS, PPS, IDR) needing nothing before it. Any other rate is a
        # re-encode wearing a filter's clothes, and this tool refuses to offer one.
        frames = [f for f in frames if f.get("key")]

    handles, sizes = {}, {}
    try:
        for fr in frames:
            part = fr["part"]
            if part not in handles:
                path = ve.part_path(directory, session, part)
                if not os.path.exists(path):
                    # Not an error: the sidecar prunes oldest-first, so an index line can
                    # outlive its bytes. Knowing a frame existed is evidence even when the
                    # picture is gone.
                    handles[part] = None
                    c.video_missing.add(part)
                else:
                    handles[part] = open(path, "rb")
                    sizes[part] = os.path.getsize(path)
            fh = handles[part]
            if fh is None:
                continue
            if fr["off"] < 0 or fr["off"] + fr["len"] > sizes[part]:
                raise VideoFault(
                    "frame %s claims bytes [%d, %d) of part %d, which is %d bytes long. A "
                    "part-2 offset applied to part 1 looks exactly like this."
                    % (fr["n"], fr["off"], fr["off"] + fr["len"], part, sizes[part])
                )
            fh.seek(fr["off"])
            blob = fh.read(fr["len"])
            if len(blob) != fr["len"]:
                raise VideoFault("frame %s: short read from part %d" % (fr["n"], part))
            types = check_frame(fr, blob)
            c.video_types[tuple(types)] += 1
            ts = unix_seconds(started, fr["t"])
            pose = nearest_pose(pose_index, ts, args.pose_tolerance)
            tags = {
                "n": fr["n"],
                "part": part,
                "off": fr["off"],
                "len": fr["len"],
                "key": bool(fr.get("key")),
            }
            if fr.get("pts") is not None:
                # DJI's own `presentationTimeMs`, verbatim, on whatever clock it turns out
                # to be. Carried, never stamped with.
                tags["pts"] = fr["pts"]
            c.rows["color_image"].append(
                (ts, msgs.video(ts, blob), pose[1] if pose else None, tags)
            )
    finally:
        for fh in handles.values():
            if fh is not None:
                fh.close()


def provenance(c, paths, args):
    """One observation stating what this store is, what it came from, and what it assumes.

    A store that states its own assumptions does not depend on `docs/mem2-converter.md`
    being read by whoever opens it in a year.
    """
    sources = []
    for p in paths:
        sources.append(
            {"file": os.path.basename(p), "sha256": sha256_of(p), "bytes": os.path.getsize(p)}
        )
    directory = os.path.dirname(os.path.abspath(paths[0]))
    session = (c.header or {}).get("session")
    for part in (
        sorted({t["part"] for _, _, _, t in c.rows["color_image"]}) if c.rows["color_image"] else []
    ):
        sc = os.path.join(directory, "%s.v%03d.h264" % (session, part))
        if os.path.exists(sc):
            sources.append(
                {
                    "file": os.path.basename(sc),
                    "sha256": sha256_of(sc),
                    "bytes": os.path.getsize(sc),
                }
            )

    stats = [e for e in c.entries if e.get("k") == "stats"]
    drops = [e for e in c.entries if e.get("k") == "drop"]
    dropped = sum(int(s.get("dropped") or 0) for s in stats)
    complete = not drops and dropped == 0 and c.bad_lines == 0

    caveats = [
        "drone/world is GPS-anchored horizontally and barometric vertically: x and y are "
        "bounded and non-accumulating, z drifts (measured -2.3 m in 12 min, stationary).",
        "Nothing is smoothed. There is no VIO, no wheel odometry and no state estimator "
        "anywhere in this system, so a GPS jump appears undamped in local position.",
        "Altitude is height above THIS flight's takeoff point everywhere, including inside "
        "gps_location where ROS asks for a WGS-84 ellipsoid height.",
        "base_link->camera translation is (0.08, 0, 0) m, measured with a ruler. "
        + CAMERA_OFFSET_UNMEASURED
        + ", and base_link's origin is taken to be the body "
        "centre without that having been established.",
        "One flight per store. Local coordinates are metres from this flight's takeoff "
        "point and mean nothing against another flight's origin.",
        CAMERA_INFO_CAVEAT,
        "Timestamps are millisecond-quantised because the live publisher's wall clock is; "
        "absolute accuracy is System.currentTimeMillis() on a phone and is not checked.",
        "tag_fix positions are anchored to DJI's home point, re-recorded at every takeoff "
        "at the wandering GPS reading, while drone/world's datum is latched once per "
        "session — measured 0.41-1.37 m apart across landing10's five takeoffs. The offset "
        "is NOT corrected; it is the same GPS-anchoring error drone/world already carries.",
        "tag_fix z is 0: the tag is ASSUMED on the datum plane (it may be standing on "
        "something; nothing measured it) — every message's id says z=datum_plane.",
        "setpoint is the commanded velocity actually sent (zeros included, shadow-mode "
        "would-be commands excluded); absence means no command flowed, not silence.",
        "wind is DJI's own estimate, quantised at source to dm/s and converted once to m/s; "
        "one observation per change-driven key delivery. Silence means the value was "
        "UNCHANGED, never that the reading is stale — do not freshness-gate this stream.",
        "warnings carries every DJI warning change (device health, wind, and every later "
        "source) exactly as the operator's ground station got it — the level, the sentence "
        "and the severity are the flight's own decisions, copied rather than re-derived. "
        "One message per change, never per sample; a warning still standing at the end of "
        "the session has no closing message, because none was said.",
    ]
    if c.gimbal_note:
        caveats.append(c.gimbal_note)

    body = {
        "converter": CONVERTER,
        "record_format": RECORD_FORMAT,
        "sources": sources,
        "header": c.header,
        "counts": {k: len(v) for k, v in sorted(c.rows.items())},
        "withheld": {k: dict(v) for k, v in sorted(c.reasons.items())},
        "tf_edges": dict(c.tf_edges),
        "camera_info": {
            "focal_over_width": FOCAL_OVER_WIDTH,
            "fits_px_at_%d" % int(FOCAL_FIT_WIDTH): list(FOCAL_FITS_PX_AT_1920),
            "source": FOCAL_SOURCE,
            "calibrated": False,
            "distortion_model": "",
            "resolution_changes": [
                {"t": t, "from": list(a), "to": list(b)} for t, a, b in c.resolution_changes
            ],
        },
        "origin": None
        if c.origin is None
        else {
            "lat": c.origin[0],
            "lon": c.origin[1],
            "takeoff_altitude_m": c.origin[2],
            "t": c.origin[3],
        },
        "recording_complete": complete,
        "bad_lines": c.bad_lines,
        "dropped_entries": dropped,
        "drop_entries": drops,
        "pruned_video_parts": sorted(c.video_missing),
        "options": {
            "keyframes_only": bool(args.keyframes_only),
            "video": not args.no_video,
            "gimbal": args.gimbal,
            "pose_tolerance_s": args.pose_tolerance,
        },
        "caveats": caveats,
        "converted_unix": time.time(),
    }
    return json.dumps(body, sort_keys=True, default=str)


def write_store(path, c, msgs, args):
    """Create every stream, sort each one, and insert. Sorting is not lookahead — §5.4."""
    from dimos.memory2.store.sqlite import SqliteStore

    if os.path.exists(path):
        if not args.force:
            sys.exit(f"{path} already exists. One flight per store; pass --force to replace it.")
        os.remove(path)
        for suffix in ("-wal", "-shm"):
            if os.path.exists(path + suffix):
                os.remove(path + suffix)

    store = SqliteStore(path=path)
    types = msgs.types()
    streams = {}
    # Every stream is created even when empty, so "nothing happened" and "this converter
    # cannot express it" are different things in the store rather than only in the docs.
    for name in ALL_STREAMS:
        streams[name] = store.stream(name, types[name])

    written = {}
    for name in ALL_STREAMS:
        rows = c.rows.get(name, [])
        # `Stream.align`'s two-pointer merge assumes ascending ts and `Replay.observable`
        # inserts a spurious loop gap when it sees ts < prev, so a stream goes in sorted
        # even though the record's own order is queue order.
        rows = sorted(rows, key=lambda r: r[0])
        st = streams[name]
        for ts, payload, pose, tags in rows:
            st.append(payload, ts=ts, pose=pose, tags=tags)
        written[name] = len(rows)
    return store, streams, written


