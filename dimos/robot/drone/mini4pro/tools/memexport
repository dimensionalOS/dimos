def report(c, written, path, elapsed):
    print()
    print(f"streams      {os.path.abspath(path)}")
    print("  %-14s %8s  %-11s %s" % ("stream", "rows", "span (s)", "notes"))
    total = 0
    for name in ALL_STREAMS:
        rows = sorted(c.rows.get(name, []), key=lambda r: r[0])
        n = written.get(name, 0)
        total += n
        span = "—" if len(rows) < 2 else "%.1f" % (rows[-1][0] - rows[0][0])
        why = ", ".join(
            "%s %d" % (k.lower(), v)
            for k, v in c.reasons.get(name, collections.Counter()).most_common(3)
        )
        if not rows:
            why = why or "nothing in the record produces this"
        print("  %-14s %8d  %-11s %s" % (name, n, span, why))
    size = os.path.getsize(path) / 1e6 if os.path.exists(path) else 0.0
    print("  %-14s %8d" % ("total", total))
    print()
    print(f"db           {size:.1f} MB, written in {elapsed:.1f} s")
    if c.origin:
        print(
            "origin       {:.7f}, {:.7f} at t={:.3f} — takeoff altitude {}".format(
                c.origin[0],
                c.origin[1],
                c.origin[3],
                "unknown" if c.origin[2] is None else f"{c.origin[2]:.3f} m (pressure, not AMSL)",
            )
        )
    else:
        print(
            "origin       NONE — no fix good enough to anchor a local frame; every local "
            "channel is withheld"
        )
    if c.tf_edges:
        print(
            "tf edges     {}".format(
                ", ".join("%s %d" % (k, v) for k, v in sorted(c.tf_edges.items()))
            )
        )
    if c.video_types:
        print(
            "video NALs   {}".format(
                ", ".join(
                    "%s x%d" % ("+".join(str(t) for t in k), v)
                    for k, v in c.video_types.most_common()
                )
            )
        )
    if c.rows.get("camera_info"):
        seen = sorted({(t["width"], t["height"]) for _, _, _, t in c.rows["camera_info"]})
        print(
            "camera_info  {}, f = {:.4f} * W (fitted, NOT calibrated) — {}".format(
                ", ".join("%dx%d" % r for r in seen), FOCAL_OVER_WIDTH, FOCAL_SOURCE
            )
        )
        print("             distortion unmeasured: D is empty, distortion_model is empty")
        for t, a, b in c.resolution_changes:
            print(
                "             RESOLUTION CHANGED at t=%.3f: %dx%d -> %dx%d. The intrinsics "
                "before and after are different cameras." % ((t, *a, *b))
            )
    for note in c.notes:
        print(f"note         {note}")


