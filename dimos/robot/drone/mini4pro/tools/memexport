def load_videoexport():
    """`tools/videoexport`'s index reader, imported rather than reimplemented.

    The two must agree about what a frame's bytes are, and the cheapest way to guarantee
    that is for there to be one implementation.
    """
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "videoexport")
    loader = importlib.machinery.SourceFileLoader("videoexport", path)
    spec = importlib.util.spec_from_loader("videoexport", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def nal_units(data):
    """Annex-B NAL payloads in `data`, as `(nal_type, payload_offset)` pairs."""
    out = []
    n = len(data)
    i = 0
    while i + 3 < n:
        if data[i] == 0 and data[i + 1] == 0:
            if data[i + 2] == 1:
                start = i + 3
            elif data[i + 2] == 0 and i + 3 < n and data[i + 3] == 1:
                start = i + 4
            else:
                i += 1
                continue
            if start < n:
                out.append((data[start] & 0x1F, start))
            i = start + 1
            continue
        i += 1
    return out


def _rbsp(data, offset, limit=24):
    """The next few bytes of RBSP after `offset`, with emulation-prevention bytes removed."""
    out = bytearray()
    zeros = 0
    i = offset
    while i < len(data) and len(out) < limit:
        b = data[i]
        if zeros >= 2 and b == 0x03:
            zeros = 0
            i += 1
            continue
        out.append(b)
        zeros = zeros + 1 if b == 0 else 0
        i += 1
    return bytes(out)


class _Bits:
    def __init__(self, data):
        self.d, self.p = data, 0

    def bit(self):
        byte = self.d[self.p >> 3]
        b = (byte >> (7 - (self.p & 7))) & 1
        self.p += 1
        return b

    def ue(self):
        """Exp-Golomb unsigned. Raises IndexError when the buffer runs out, which the
        caller treats as "cannot tell", not as "fine"."""
        n = 0
        while self.bit() == 0:
            n += 1
            if n > 31:
                raise ValueError("exp-golomb ran away")
        v = 1
        for _ in range(n):
            v = (v << 1) | self.bit()
        return v - 1


SLICE_TYPE_NAMES = {
    0: "P",
    1: "B",
    2: "I",
    3: "SP",
    4: "SI",
    5: "P",
    6: "B",
    7: "I",
    8: "SP",
    9: "SI",
}


def slice_type_of(data, offset):
    """The slice type letter of a coded slice NAL, or None when it cannot be read.

    `slice_header` begins `first_mb_in_slice ue(v)` then `slice_type ue(v)`. Two exp-Golomb
    reads, and the only reason to do them at all: **Foxglove's `CompressedVideo` does not
    support B-frames**, because they need lookahead. Zero were measured on this firmware,
    which is exactly why the check has to be shown to fire on a planted one rather than
    assumed to work.
    """
    try:
        bits = _Bits(_rbsp(data, offset + 1))
        bits.ue()
        return SLICE_TYPE_NAMES.get(bits.ue())
    except (IndexError, ValueError):
        return None


class VideoFault(Exception):
    """A frame the schema does not permit. Aborts the conversion, never a warning."""


def check_frame(fr, blob):
    """Everything that must be true of one access unit before a row is written.

    Refusals, not warnings: a consumer decoding our stream incorrectly is worse than a
    conversion that failed, and a store is a thing people trust afterwards.
    """
    nals = nal_units(blob)
    if not nals:
        raise VideoFault("frame {}: no NAL start code — not an Annex-B access unit".format(fr["n"]))
    types = [t for t, _ in nals]
    if fr.get("key"):
        if 7 not in types:
            raise VideoFault(
                "frame {} is a keyframe with no SPS (NAL 7); saw {}. Every keyframe message "
                "must carry its own SPS or a subscriber joining there cannot decode.".format(
                    fr["n"], types
                )
            )
    for t, off in nals:
        if t in (1, 5):
            st = slice_type_of(blob, off)
            if st == "B":
                raise VideoFault(
                    "frame {} contains a B slice. foxglove_msgs.CompressedVideo does not "
                    "support B-frames — they need lookahead. This firmware emitted none when "
                    "the contract was measured; if it now does, the video path needs a "
                    "decision rather than a conversion.".format(fr["n"])
                )
            if st is None:
                raise VideoFault("frame %s: could not read a slice type from NAL %d" % (fr["n"], t))
    return types


