# The frame tree
# ─────────────────────────────────────────────────────────────────────────────


def camera_edge(sample, world_from_base, source):
    """`drone/base_link` → `drone/camera` — a **joint** rotation, not DJI's number.

    Returns `(quaternion, tags)` or None. `source` is the earth-referenced camera attitude
    in DJI's own convention as `(roll, pitch, yaw)` degrees, from whichever of the commanded
    or the reported angle is available.

    The airframe's attitude is composed away because DJI's gimbal report is
    earth-referenced: commanded to −90° the camera points at the ground regardless of how
    the aircraft is leaning, so the angle is measured from the horizon rather than from the
    airframe, and an edge between two body frames is not that.

    Note the consequence, which must not be conflated with the airframe property that
    the gimbal has no usable roll axis: **the joint roll here is approximately minus the
    aircraft's roll**, because that is exactly what the stabiliser is doing. Zero in the
    report, non-zero in the edge.
    """
    if world_from_base is None or source is None:
        return None
    world_from_camera = enu_quaternion(*source)
    q = q_mul(q_conj(world_from_base), world_from_camera)
    return q


def gimbal_source(sample, commanded):
    """The earth-referenced camera attitude to build the edge from, and where it came from.

    Returns `((roll, pitch, yaw), tags)` or `(None, tags)`. The commanded angle is preferred
    per §2.2 and is exact and always fresh; the reported one is change-driven and goes
    silent exactly when the camera is held still, which is what a nadir descent consists of.
    So when the reported angle is used its **age travels with it**, in the tags, where a
    consumer can see that a held reading is behind the edge.
    """
    if commanded:
        pitch, _at = commanded
        return (0.0, pitch, sample.state_yaw()), {"gimbal_src": "commanded"}
    g = sample.gimbal
    if g is None:
        return None, {"gimbal_src": "none"}
    pitch = num(g.get("p"))
    roll = num(g.get("r"))
    yaw = num(g.get("y"))
    if not finite(pitch) or not finite(yaw):
        return None, {"gimbal_src": "none"}
    tags = {"gimbal_src": "reported"}
    if g.get("age") is not None:
        # The reading's own delivery age at the moment it was written, plus however long we
        # have been holding it since. Both halves matter and neither is guessable from the
        # other.
        tags["gimbal_age_ms"] = int(g["age"]) + round((sample.t - sample.gimbal_t) * 1000)
    return (roll if finite(roll) else 0.0, pitch, yaw), tags


def _state_yaw(self):
    rpy = self.rpy()
    return rpy[2] if rpy else 0.0


Sample.state_yaw = _state_yaw


def build_tf(derived, commanded_by_t, gimbal_mode):
    """One `TFMessage` per state tick, carrying every edge valid at that instant.

    One message rather than three because the three are a snapshot of one tree at one
    timestamp, and a consumer that has to re-join them across messages is doing a merge that
    can be stale in one edge and fresh in another.

    The fixed `camera` → `camera_optical` edge is in every message. It could in principle be
    latched and published once, but "once" has no meaning on a bus a subscriber can join at
    any moment; at ~100 bytes it is not worth optimising, and republishing means a late
    joiner can resolve the whole chain within one tick.
    """
    rows = []
    counts = collections.Counter()
    for d in derived:
        s = d.sample
        edges = []
        if d.position is not None and d.orientation is not None:
            edges.append((FRAME_WORLD, FRAME_BASE_LINK, d.position, d.orientation))
            counts["world->base_link"] += 1
        tags = {}
        if gimbal_mode != "none":
            src, gtags = gimbal_source(s, commanded_by_t.get(s.t))
            tags.update(gtags)
            q = camera_edge(s, d.orientation, src)
            if q is not None:
                edges.append((FRAME_BASE_LINK, FRAME_CAMERA, CAMERA_OFFSET_M, q))
                counts["base_link->camera"] += 1
        edges.append((FRAME_CAMERA, FRAME_CAMERA_OPTICAL, (0.0, 0.0, 0.0), OPTICAL_Q))
        counts["camera->camera_optical"] += 1
        rows.append((s.unix, edges, tags, d.position))
    return rows, counts


