# The checks
# ─────────────────────────────────────────────────────────────────────────────


def payload_stamp(name, obj):
    """The instant the *payload itself* claims, or None for a type that carries none.

    Read out of the decoded message rather than off the row, because the whole point is to
    catch the two disagreeing. `std_msgs.String` has no header at all, which is why `status`
    and friends are not in this check and their `ts` rests on the row alone.
    """
    if name == "tf":
        return obj.transforms[0].ts if obj.transforms else None
    if name == "battery":
        return obj.header.stamp.sec + obj.header.stamp.nsec / 1e9
    return getattr(obj, "ts", None)


def check_roundtrip(streams, c):
    """Read every observation back, re-encode, and compare with what went in.

    Video is compared against the *sidecar's* bytes rather than against a re-derivation,
    which is stronger and is the advantage of not decoding.
    """
    problems = []
    compared = 0
    for name in ALL_STREAMS:
        expect = sorted(c.rows.get(name, []), key=lambda r: r[0])
        if not expect:
            continue
        got = sorted(streams[name].to_list(), key=lambda o: o.ts)
        if len(got) != len(expect):
            problems.append("%s: %d rows back, %d written" % (name, len(got), len(expect)))
            continue
        for (ts, payload, _, tags), obs in zip(expect, got, strict=False):
            compared += 1
            if obs.ts != ts:
                problems.append(f"{name} at {ts:.6f}: ts came back {obs.ts:.6f}")
                break
            want = payload.lcm_encode()
            back = obs.data.lcm_encode()
            if back != want:
                problems.append(
                    "%s at %.6f: %d bytes in, %d out, first differing byte %s"
                    % (name, ts, len(want), len(back), first_diff(want, back, ("in", "out")))
                )
                break
            # The store's `ts` and the payload's own stamp must be the same instant, to the
            # millisecond the format quantises to. They come from different places and a
            # shared mutable default in a generated binding is enough to separate them.
            stamp = payload_stamp(name, obs.data)
            if stamp is not None and abs(stamp - ts) > 5e-7:
                problems.append(f"{name} at {ts:.6f}: the payload's own stamp says {stamp:.6f}")
                break
            if name == "color_image":
                if bytes(obs.data.data) != bytes(payload.data):
                    problems.append(f"{name} at {ts:.6f}: payload bytes differ")
                    break
                for key in ("n", "part", "off", "len", "key"):
                    if obs.tags.get(key) != tags.get(key):
                        problems.append(
                            f"{name} at {ts:.6f}: tag {key} came back {obs.tags.get(key)!r}, wrote {tags.get(key)!r}"
                        )
                        break
    return compared, problems


def check_video_against_sidecar(streams, record_path):
    """Every stored frame's bytes must equal the `len` bytes at `off` in part `part`.

    The store holds the sidecar's own bytes, so this is exact and has no tolerance in it.
    """
    ve = load_videoexport()
    session, _ = ve.read_index(record_path)
    directory = os.path.dirname(os.path.abspath(record_path))
    handles = {}
    problems, compared = [], 0
    try:
        for obs in streams["color_image"].to_list():
            part = obs.tags["part"]
            if part not in handles:
                p = ve.part_path(directory, session, part)
                handles[part] = open(p, "rb") if os.path.exists(p) else None
            fh = handles[part]
            if fh is None:
                continue
            fh.seek(obs.tags["off"])
            want = fh.read(obs.tags["len"])
            compared += 1
            if bytes(obs.data.data) != want:
                problems.append("frame {} does not match the sidecar".format(obs.tags["n"]))
                if len(problems) > 5:
                    break
    finally:
        for fh in handles.values():
            if fh is not None:
                fh.close()
    return compared, problems


def check_tf(store, c, probes=25):
    """`StreamTF.from_store` must resolve `drone/world` → `drone/camera_optical`.

    Not our own reader: `dimos.memory2.tf.StreamTF` is the thing a consumer will actually
    use, and `dimos/protocol/tf/test_tf.py` already asserts that a live buffer, a
    `MemoryStore` stream and a `SqliteStore` stream answer identically — so a store this
    resolves through is one a DiMOS consumer resolves through.

    Probed at instants spread across the flight rather than at one, because the fixed
    `camera` → `camera_optical` edge published once and then never again would still answer
    at t=0 and nowhere else. A subscriber joins whenever it likes.
    """
    try:
        from dimos.memory2.tf import StreamTF
    except ImportError as e:
        return 0, [], f"dimos.memory2.tf is not importable: {e}"
    tf = StreamTF.from_store(store, stream="tf")
    if tf is None:
        return 0, ["no tf stream in the store"], None
    rows = sorted(
        (ts, {(t.frame_id, t.child_frame_id) for t in payload.transforms})
        for ts, payload, _, _ in c.rows["tf"]
    )
    if not rows:
        return 0, [], "the tf stream is empty"
    problems = []

    # The fixed edge, republished. It could in principle be latched and sent once, and
    # "once" has no meaning on a bus a subscriber joins whenever it likes — so require it
    # in **every one-second window**, which is the property a late joiner depends on.
    fixed = [ts for ts, edges in rows if (FRAME_CAMERA, FRAME_CAMERA_OPTICAL) in edges]
    for a, b in itertools.pairwise(fixed):
        if b - a > 1.0:
            problems.append(
                f"the fixed camera->camera_optical edge is absent for {b - a:.1f} s "
                f"after {a:.3f}; a subscriber joining there stays blind"
            )
            break

    # The chain, probed only where the tree actually has all its edges. Where `pose` is
    # withheld there is no `world->base_link` to chain through and the absence is the
    # information, not a fault — so requiring a resolution there would be requiring the
    # converter to invent one.
    whole = [
        ts
        for ts, edges in rows
        if {
            (FRAME_WORLD, FRAME_BASE_LINK),
            (FRAME_BASE_LINK, FRAME_CAMERA),
            (FRAME_CAMERA, FRAME_CAMERA_OPTICAL),
        }
        <= edges
    ]
    if not whole:
        return (
            0,
            problems,
            (
                "no sample published all three edges, so the chain is not "
                "resolvable anywhere in this record"
            ),
        )
    ok = 0
    step = max(1, len(whole) // probes)
    for ts in whole[::step]:
        if tf.get(FRAME_WORLD, FRAME_CAMERA_OPTICAL, ts, 0.5) is None:
            problems.append(
                f"world->camera_optical does not resolve at {ts:.3f}, where all "
                "three edges were published"
            )
            if len(problems) > 4:
                break
        else:
            ok += 1
    return ok, problems, None


def check_origin_by_subtraction(c):
    """`gps_location` minus `pose` must be one constant — the deleted `datum` channel's job.

    A swapped X/Y breaks this by metres; a dropped `cos(latitude)` by 21% of the easting at
    this site; a second flight in the store by a median 2.5 m; a mid-flight re-capture of
    the origin by a visible step. All four are invisible to any byte comparison, which is
    why this check is worth the arithmetic.
    """
    poses = {ts: p for ts, _, p, _ in c.rows["pose"]}
    residuals = []
    recovered = []
    for ts, payload, _, _ in c.rows["gps_location"]:
        p = poses.get(ts)
        if p is None:
            continue
        # Undo the projection: the origin implied by this sample alone.
        east, north = p[0], p[1]
        lat = payload.latitude - north / METRES_PER_DEG
        lon = payload.longitude - east / (METRES_PER_DEG * math.cos(math.radians(lat)))
        recovered.append((lat, lon))
        if c.origin is not None:
            de, dn = enu_metres(c.origin[0], c.origin[1], lat, lon)
            residuals.append(math.hypot(de, dn))
    if not recovered:
        return None, 0.0, 0, 0.0
    mean_lat = sum(a for a, _ in recovered) / len(recovered)
    mean_lon = sum(b for _, b in recovered) / len(recovered)
    spread = 0.0
    for lat, lon in recovered:
        de, dn = enu_metres(mean_lat, mean_lon, lat, lon)
        spread = max(spread, math.hypot(de, dn))
    return (mean_lat, mean_lon), max(residuals or [0.0]), len(recovered), spread


def first_diff(a, b, labels=("ours", "theirs")):
    """Where two encodings first disagree, said so a reader can find the *field*.

    A bare offset is not enough to act on. "bytes differ at 83" cost a day of diagnosis
    on landing16 (2026-07-30) because nothing in the line said 83 was the last byte of an
    84-byte message — i.e. the low byte of the final double, i.e. a one-ULP disagreement
    in `twist.angular.z` and not a structural divergence. So the offset travels with the
    length and with both bytes: `83/84 ours 0x85 theirs 0x86` reads as "the last byte of
    the last field, off by one", which is the whole diagnosis.
    """
    for i in range(min(len(a), len(b))):
        if a[i] != b[i]:
            return "%d/%d %s 0x%02x %s 0x%02x" % (i, len(a), labels[0], a[i], labels[1], b[i])
    return "length only (%s %d, %s %d)" % (labels[0], len(a), labels[1], len(b))


def _quaternions(obj):
    """Every `geometry_msgs.Quaternion` reachable from a message, in a deterministic order.

    Walks attributes by sorted name so that walking two decodings of the same type visits
    their quaternions in the same order — which is what lets [_agrees_to_quat_ulp] pair
    them up positionally. dimos messages keep some fields as properties over internal
    storage rather than in `__dict__` (`PoseStamped.orientation` is one), so this walks
    `dir()` and not `vars()`.
    """
    out = []

    def walk(o):
        if isinstance(o, (list, tuple)):
            for v in o:
                walk(v)
            return
        if type(o).__name__ == "Quaternion":
            out.append(o)
            return
        # Only message objects are entered. Anything else — numpy arrays with their
        # self-referential `.T`, floats, strings — is a leaf, or the walk never ends.
        if not type(o).__module__.startswith("dimos."):
            return
        for a in sorted(dir(o)):
            if a.startswith("_"):
                continue
            try:
                v = getattr(o, a)
            except Exception:
                continue
            if not callable(v):
                walk(v)

    walk(obj)
    return out


# A few ULP at unit scale, and the scale is the point. The error in a quaternion component
# is inherited from sin/cos values of magnitude ~1 and from the cancellation in
# `sr*cp*cy - cr*sp*sy`, so it is an *absolute* error of a few 2^-53 — measured on the
# yaw-over-tag flight: 1.1e-16 on a component of 0.68 (1 ULP of itself) and 4.3e-19 on a
# component of 0.0017 (2 ULP of itself). A per-result-ULP tolerance would have to grow
# without bound as a component crosses zero, which is why this is not one.
QUAT_COMPONENT_TOL = 4 * 2.0**-53


def _agrees_to_quat_ulp(payload, theirs_bytes):
    """True iff the encodings differ only inside quaternion components, within [QUAT_COMPONENT_TOL].

    The verdict is delivered by the encoder itself rather than by field-walking arithmetic:
    every tolerated component is copied from our message onto theirs, theirs is re-encoded,
    and the bytes must then be identical. So a difference anywhere *else* — another field, a
    length, a stamp — still fails exactly as before, because nothing outside a quaternion is
    ever touched. `struct.pack` equality is the float comparison so that NaN payloads (which
    this project uses deliberately) compare by bit pattern rather than by IEEE `==`.
    """
    # Both sides through a decode, so they have the same shape. A constructed message and a
    # decoded one expose different derived properties (a decoded position grows a
    # `.quaternion` of its own), and the walker must see the same quaternions in the same
    # order on both sides. A derived quaternion cannot smuggle tolerance in: correcting it
    # mutates a throwaway object, and the verdict below re-encodes the message's real fields.
    theirs = type(payload).lcm_decode(theirs_bytes)
    ours = type(payload).lcm_decode(payload.lcm_encode())
    ours_q, theirs_q = _quaternions(ours), _quaternions(theirs)
    if len(ours_q) != len(theirs_q):
        return False
    for m, t in zip(ours_q, theirs_q, strict=False):
        for a in ("x", "y", "z", "w"):
            mv, tv = getattr(m, a), getattr(t, a)
            if struct.pack(">d", mv) == struct.pack(">d", tv):
                continue
            if math.isfinite(mv) and math.isfinite(tv) and abs(mv - tv) <= QUAT_COMPONENT_TOL:
                setattr(t, a, mv)
            else:
                return False
    return theirs.lcm_encode() == payload.lcm_encode()


def check_against_kotlin(paths, c, repo, quiet=False):
    """Every message the shipping Kotlin encoder would have published must be ours, exactly —
    except that a quaternion component may disagree in its last bit.

    This is the check the whole contract turns on. `tools/kotlinframes/run` executes
    `ZenohReplay` and `ZenohTelemetryEncoder` bytecode — not a description of them, not a
    second Python copy of their rules — over the same record, and prints the frames it would
    have sent. Anything on both sides must be byte-identical.

    **The one tolerance, and why it is exactly this narrow.** JVM `Math.sin`/`cos` and
    glibc's disagree in the last bit for some inputs — both are within their documented
    0.5–1 ULP bounds and neither is wrong — so the two implementations of `enuQuaternion`
    cannot be byte-equal on every attitude even though the code is line-for-line the same.
    Found 2026-07-28 on the yaw-over-tag flight: 4 of 15,108 messages differed, every
    difference inside a quaternion component, and a JVM probe running the shipping
    `enuQuaternion` on the failing attitude reproduced the Kotlin bytes exactly while CPython
    from the same inputs reproduced ours. The same morning's other flight passed 14,655/14,655
    because DJI quantises attitude to 0.1° and none of its values hit a divergent input —
    which is why this check could pass for a day while carrying an unachievable requirement.
    The tolerance is [QUAT_COMPONENT_TOL] absolute, quaternion components only — see the
    constant for why absolute-at-unit-scale is the metric and per-result ULPs are not.
    Anything outside a quaternion still has to be byte-exact.

    Returns `(compared, ulp_ok, differed, problems, note, per_stream)`; `per_stream` maps each
    checked stream to `(byte_identical, compared)` so the report can account stream by stream —
    the `detections`/`tag_fix`/`setpoint`/`wind` streams must be *visibly* in the comparison, not
    merely inside an aggregate that would look the same without them. `ulp_ok` counts messages
    that needed the tolerance, because "equal" and "equal to tolerance" must never print the
    same. A missing toolchain is a `note`, not a pass: "the check did not run" and "the check
    passed" must never print the same either.

    ## Why `differed` is counted separately, and why the whole comparison always runs

    Until 2026-07-30 this returned only `problems` (a list of human-readable complaints) and
    stopped as soon as it had nine of them, and the report printed `len(problems)` where the
    sentence said "byte-identical". A single-field, single-stream, one-ULP divergence on
    landing16 therefore printed as **"FAILED — 9 of 33491 messages byte-identical"**, which
    reads as "everything is broken" and is not what was measured: the truth was 246 of 35038
    (all of them `setpoint`, 1267 of that stream's 1513 still identical, every other stream
    perfect), and even the 33491 was wrong — it was only the messages reached before the
    early return. Both halves were bugs of the same kind: a count that means one thing
    printed as if it meant another, and an early return that made the real count unknowable
    and left `per_stream` truncated — the streams after the failing one never got an entry,
    and the failing stream's entry was never written at all, so the one line that could have
    named `setpoint` was also the one line that was missing.

    So: the loop never returns early, `differed` is the real number of compared messages that
    are not byte-identical and not inside the tolerance, `problems` keeps at most
    [KOTLIN_PROBLEM_EXAMPLES] *examples* plus every structural complaint, and `per_stream`
    subtracts the differing messages as well as the tolerated ones — an accounting that
    claimed a failing stream was fully identical would be the same class of lie.
    """
    runner = os.path.join(repo, "tools", "kotlinframes", "run")
    if not os.path.exists(runner):
        return 0, 0, 0, [], "tools/kotlinframes/run is missing", {}
    out = os.path.join(repo, "tmp", "memexport-kotlin-frames.jsonl")
    os.makedirs(os.path.dirname(out), exist_ok=True)
    proc = subprocess.run([runner, out, *list(paths)], capture_output=True, text=True)
    if proc.returncode != 0:
        return (
            0,
            0,
            0,
            [],
            "kotlinframes failed: {}".format((proc.stderr.strip().splitlines() or [""])[-1]),
            {},
        )

    theirs = collections.defaultdict(dict)
    with open(out) as fh:
        next(fh)
        for line in fh:
            f = json.loads(line)
            theirs[f["ch"]][round(f["unix"], 6)] = f["hex"]

    problems, compared, ulp_ok, differed = [], 0, 0, 0
    examples = 0
    per_stream = {}
    for name in KOTLIN_CHECKED_STREAMS:
        mine = {round(ts, 6): payload for ts, payload, _, _ in c.rows.get(name, [])}
        theirs_ch = theirs.get(name, {})
        if len(mine) != len(theirs_ch):
            problems.append(
                "%s: %d messages here, %d from the Kotlin encoder"
                % (name, len(mine), len(theirs_ch))
            )
        only_mine = sorted(set(mine) - set(theirs_ch))[:3]
        only_theirs = sorted(set(theirs_ch) - set(mine))[:3]
        if only_mine:
            problems.append(f"{name}: published at {only_mine} and the Kotlin encoder did not")
        if only_theirs:
            problems.append(f"{name}: the Kotlin encoder published at {only_theirs} and we did not")
        s_compared = s_ulp = s_bad = 0
        for ts in sorted(set(mine) & set(theirs_ch)):
            compared += 1
            s_compared += 1
            mine_hex = mine[ts].lcm_encode().hex()
            if mine_hex == theirs_ch[ts]:
                continue
            # A mismatch so deep the other side's bytes do not even decode as this type
            # (a drifted fingerprint is the known way) is a byte difference, not a crash:
            # the report below must say WHERE, not die inside the tolerance probe.
            try:
                tolerated = _agrees_to_quat_ulp(mine[ts], bytes.fromhex(theirs_ch[ts]))
            except Exception:
                tolerated = False
            if tolerated:
                ulp_ok += 1
                s_ulp += 1
                continue
            differed += 1
            s_bad += 1
            if examples < KOTLIN_PROBLEM_EXAMPLES:
                examples += 1
                problems.append(
                    f"{name} at {ts:.3f}: bytes differ at {first_diff(bytes.fromhex(mine_hex), bytes.fromhex(theirs_ch[ts]))}"
                )
        per_stream[name] = (s_compared - s_ulp - s_bad, s_compared)
    return compared, ulp_ok, differed, problems, None, per_stream


