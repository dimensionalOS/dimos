def main():
    here = os.path.dirname(os.path.abspath(__file__))
    repo = os.path.dirname(here)

    ap = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    ap.add_argument("paths", nargs="*", help="flight record .jsonl files or globs")
    ap.add_argument("--gaps", action="store_true", help="sampling gaps and signal ages")
    ap.add_argument("--fields", action="store_true", help="what the fold found, and missed")
    ap.add_argument("--frames", metavar="FILE", help="write the encoded LCM frames")
    ap.add_argument("--coverage", action="store_true", help="what a record cannot replay")
    ap.add_argument("--selftest", action="store_true", help="check against the committed fixture")
    ap.add_argument("--dimos-lcm", default=os.path.expanduser("~/coding/dimos-lcm"))
    args = ap.parse_args()

    if args.selftest:
        return selftest(repo)
    if args.coverage and not args.paths:
        print(COVERAGE)
        return 0
    if not args.paths:
        ap.print_help()
        return 2

    paths = []
    for p in args.paths:
        matched = sorted(glob.glob(p))
        paths.extend(matched if matched else [p])

    header, entries, bad = read_records(paths)
    samples, unmapped = build_samples(entries)
    if not samples:
        print("no dji_state entries — nothing to replay.")
        print("A session recorded before MSDK registration has no DJI half at all;")
        print("check for an sdk_attached event.")
        return 1

    origin = takeoff_origin(samples)
    tally, decisions = run(samples, origin)

    print_summary(header, entries, samples, tally, origin, unmapped, bad)
    if args.gaps:
        print_gaps(samples, entries)
    if args.fields:
        print_fields(samples, unmapped)
    if args.coverage:
        print(COVERAGE)

    if args.frames:
        mods, err = load_lcm(args.dimos_lcm)
        if mods is None:
            print(f"frames NOT written: {err}")
            print("  --frames encodes with DiMOS's own generated bindings so the bytes are")
            print("  literally what DiMOS would receive. Point --dimos-lcm at the checkout,")
            print("  or run tools/lcmfixtures/generate.py first to confirm it is usable.")
            return 1
        if origin is None:
            print("frames NOT written: no origin, so no local channel can be expressed.")
            return 1
        n = write_frames(args.frames, header, decisions, origin, mods)
        print("wrote %d frames to %s" % (n, args.frames))

    return 0


if __name__ == "__main__":
    sys.exit(main())
