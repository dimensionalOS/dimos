# Self-test
# ─────────────────────────────────────────────────────────────────────────────

# The numbers `OrbitReplayTest` pins on the same fixture, from the Kotlin encoder.
# This tool derives them independently; the point of the check is that two
# implementations of the same rules agree.
#
# What each one means on this flight — 1855 samples of session 20260727-102510:
#
#   odom 409       the strict conjunction. 870 ALTITUDE_STALE is KeyAltitude's cadence
#                  (bursts every 5-6 s against a 1 s limit) and not a fault; 67
#                  VELOCITY_STALE is KeyAircraftVelocity being change-driven; 509
#                  POSITION_INVALID is an aircraft with no fix at all. POSITION_STALE is
#                  pinned at 0 because KeyAircraftLocation3D delivered at rate throughout.
#   pose 1346      = 1855 - 509. Under the liveness gate every remaining withholding is
#   gps 1346       POSITION_INVALID: an aircraft with no fix, never one holding still.
#                  ALTITUDE_STALE is pinned at 0 to catch a freshness gate creeping back
#                  in, and LINK_DOWN at 0 because on this flight fcConnected went false
#                  only at t=275.41, by which time the position was already invalid.
#   imu 1377       = 1855 - 478 ATTITUDE_MISSING, the samples with no aircraft at all.
#                  ATTITUDE_STALE 0 for the same reason ALTITUDE_STALE is 0.
#   battery 1378   / mode 1377 — event-driven keys, no freshness gate, unchanged by any
#                  of this and left in as a control: if these move, something else broke.
#   gimbal 0       1855 NOT_RECORDED. The one channel a record cannot reproduce.
#
# Was, before 3b2d331: pose and gps 476, imu 1254 (123 ATTITUDE_STALE), plus a `datum`
# channel at 334 published / 1521 rate-limited. The datum channel is deleted; the rest is
# the liveness gate.
SELFTEST_FIXTURE = "android/app/src/test/resources/replay/orbit-real-air.jsonl"
SELFTEST_EXPECT = {
    "samples": 1855,
    "odom": {
        "PUBLISHED": 409,
        "ALTITUDE_STALE": 870,
        "POSITION_INVALID": 509,
        "VELOCITY_STALE": 67,
        "POSITION_STALE": 0,
    },
    "pose": {"PUBLISHED": 1346, "POSITION_INVALID": 509, "ALTITUDE_STALE": 0, "LINK_DOWN": 0},
    "gps_location": {
        "PUBLISHED": 1346,
        "POSITION_INVALID": 509,
        "ALTITUDE_STALE": 0,
        "LINK_DOWN": 0,
    },
    "imu": {"PUBLISHED": 1377, "ATTITUDE_MISSING": 478, "ATTITUDE_STALE": 0},
    "battery": {"PUBLISHED": 1378, "BATTERY_MISSING": 477},
    "mode": {"PUBLISHED": 1377, "MODE_MISSING": 478},
    "gimbal": {"NOT_RECORDED": 1855},
}


def planted_faults(samples, origin):
    """Two mutations of the fixture the gates must answer in opposite directions.

    **`LINK_DOWN` never fires on any record this project holds.** Measured across the
    fixture and both 2026-07-27 datasets: `fcConnected` does go false, but only once the
    position has already become invalid, so `POSITION_INVALID` wins the precedence every
    time and the branch that withholds a dense channel for a dead link is never reached.
    The same is true in reverse for the liveness gate's whole purpose — no real sample has
    a stale reading and a live link *and* a valid fix all at once often enough to be
    obvious in the counts.

    A check that has never been shown to catch a planted fault is not known to work, so
    both directions are planted here, in memory, on a window of samples the unmutated
    fixture publishes on every channel:

      1. the link goes down while every reading stays fresh — `pose`, `gps_location` and
         `imu` must withhold for exactly that window and for the reason `LINK_DOWN`, and
         `odom` must not move at all, because it never consulted the link.
      2. every reading goes stale while the link stays up — `odom` must lose exactly that
         window, and the three dense channels must not move at all. This is the fault that
         would silently undo 3b2d331: a freshness gate creeping back into `pose` looks
         like nothing until an aircraft holds still.

    Returns a list of failure strings.
    """
    window = [i for i, (_, _, _) in enumerate(samples)][:0]
    tally, decisions = run(samples, origin)
    window = [i for i, (row, _, _) in enumerate(decisions) if row["odom"] == "PUBLISHED"][:50]
    failures = []
    if len(window) < 50:
        return ["planted faults need 50 fully-published samples, found %d" % len(window)]
    chosen = set(window)

    def mutate(fault):
        out = []
        for i, (state, fold, changed) in enumerate(samples):
            if i in chosen:
                state, fold = fault(dict(state), dict(fold))
            out.append((state, fold, changed))
        return run(out, origin)[0]

    def link_down(state, fold):
        fold["fcConnected"] = False
        return state, fold

    def all_stale(state, fold):
        # Older than every limit in STALE_AFTER_MS, on all four ages at once.
        state["age"] = {member: 9_999_999 for member in AGE_SIGNAL}
        return state, fold

    down = mutate(link_down)
    for ch in ("pose", "gps_location", "imu"):
        if down[ch].get("LINK_DOWN", 0) != len(window):
            failures.append(
                "fault 1: %s withheld LINK_DOWN %d times, expected %d"
                % (ch, down[ch].get("LINK_DOWN", 0), len(window))
            )
        if down[ch]["PUBLISHED"] != tally[ch]["PUBLISHED"] - len(window):
            failures.append(
                "fault 1: %s published %d, expected %d — a dead link must"
                " withhold a dense channel"
                % (ch, down[ch]["PUBLISHED"], tally[ch]["PUBLISHED"] - len(window))
            )
    if down["odom"]["PUBLISHED"] != tally["odom"]["PUBLISHED"]:
        failures.append(
            "fault 1: odom moved %d -> %d — odom is gated on freshness alone"
            % (tally["odom"]["PUBLISHED"], down["odom"]["PUBLISHED"])
        )

    stale = mutate(all_stale)
    if stale["odom"]["PUBLISHED"] != tally["odom"]["PUBLISHED"] - len(window):
        failures.append(
            "fault 2: odom published %d, expected %d — odom must never carry"
            " a held reading"
            % (stale["odom"]["PUBLISHED"], tally["odom"]["PUBLISHED"] - len(window))
        )
    for ch in ("pose", "gps_location", "imu"):
        if stale[ch]["PUBLISHED"] != tally[ch]["PUBLISHED"]:
            failures.append(
                "fault 2: %s moved %d -> %d — a stale reading on a live link is"
                " quiet-because-unchanged, and the dense channels hold it"
                % (ch, tally[ch]["PUBLISHED"], stale[ch]["PUBLISHED"])
            )
    return failures


def selftest(repo):
    path = os.path.join(repo, SELFTEST_FIXTURE)
    if not os.path.exists(path):
        print(f"selftest: fixture missing at {path}")
        return 1
    header, entries, bad = read_records([path])
    samples, unmapped = build_samples(entries)
    origin = takeoff_origin(samples)
    tally, _ = run(samples, origin)

    failures = []
    if len(samples) != SELFTEST_EXPECT["samples"]:
        failures.append("samples: %d, expected %d" % (len(samples), SELFTEST_EXPECT["samples"]))
    if bad:
        failures.append("%d unparseable lines in the fixture" % bad)
    for ch, expect in SELFTEST_EXPECT.items():
        if ch == "samples":
            continue
        for reason, n in expect.items():
            got = tally[ch].get(reason, 0)
            if got != n:
                failures.append("%s %s: %d, expected %d" % (ch, reason.lower(), got, n))
    # Every sample is accounted for on every channel: a reason that stopped being
    # counted would otherwise hide behind the per-reason checks above.
    for ch in CHANNELS:
        total = sum(tally[ch].values())
        if total != len(samples):
            failures.append("%s: %d decisions over %d samples" % (ch, total, len(samples)))
    if origin is None:
        failures.append("no origin found")
    elif abs(origin["t"] - 26.61) > 0.3:
        failures.append("origin at t={:.2f}, expected 26.61".format(origin["t"]))
    else:
        failures.extend(planted_faults(samples, origin))

    if failures:
        print("selftest FAILED — this tool and OrbitReplayTest disagree:")
        for f in failures:
            print("  " + f)
        return 1
    print(
        "selftest ok: %d samples, all %d channels agree with OrbitReplayTest,"
        % (len(samples), len(CHANNELS))
    )
    print("             and both planted gate faults were caught on 50 samples.")
    return 0


