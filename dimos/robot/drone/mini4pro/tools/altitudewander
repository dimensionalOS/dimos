#!/usr/bin/env python3
"""Measure how far DJI's altitude datum wanders, across and within flight sessions.

`AircraftState.takeoffAltitudeAmsl` is the number any absolute height we could publish would rest
on. `docs/measurements/2026-07-26-amsl-datum.md` argued from ~18 hand-picked readings that it is
pressure altitude referenced to 1013.25 hPa, not AMSL. This re-asks the same question
mechanically, over every session on disk.

    tools/altitudewander tmp/phone-logs/*.jsonl            # per-session table (default)
    tools/altitudewander tmp/phone-logs/*.jsonl --between  # spread across sessions, by site
    tools/altitudewander tmp/phone-logs/*.jsonl --drift    # within-session drift, m/min
    tools/altitudewander tmp/phone-logs/*.jsonl --truth 89.5   # against a ground-truth elevation
    tools/altitudewander tmp/phone-logs/*.jsonl --repeat   # same-site pairs, by gap in time
    tools/altitudewander tmp/phone-logs/*.jsonl --pressure # against independent surface pressure
    tools/altitudewander tmp/phone-logs/*.jsonl --correlate    # against sats / level / hour
    tools/altitudewander --selftest                        # planted numbers, all recovered

Five filters run before any statistic, because each has already produced a wrong finding here:
truncated logs are classified and excluded from `--drift`; simulated intervals are cut out with a
settling allowance; a session is represented by its **last settled on-ground reading**, not its
median, because the datum is filtered; renamed copies of one recording are deduplicated by
`started_unix_ms`; and a group below `--min-samples` is reported as such rather than given a
statistic. `--include-cut` / `--include-sim` disable the first two.

Exits non-zero if any self-test assertion fails.

Full rationale: `docs/tools/altitudewander.md`. The finding:
`docs/measurements/2026-07-27-altitude-datum-wander.md`.
"""

import argparse
from collections import defaultdict
import itertools
import json
import math
import os
import statistics
import sys
import tempfile

# Same-site radius. `docs/mem2-converter.md` measures session origins on this patch of ground
# separating by a median of 2.5 m, p90 8.7 m, max 13.4 m -- so anything inside a few tens of
# metres is the same launch point, and the threshold is loose on purpose: mis-splitting one site
# into two would manufacture agreement, which is the error that matters here.
SITE_RADIUS_M = 40.0

# Below this the aircraft is treated as on the ground for "stationary" windows.
GROUND_RELALT_M = 1.0

# Simulator phases in which `takeoffAltitudeAmsl` is pinned rather than measured.
SIM_ON = ("ACTIVE", "STARTING", "STOPPING")

# How long the datum takes to relax back to the barometer after the simulator is switched off.
# Measured, not assumed: `sim-session` t=329.8 relaxes 111.13 -> 74.40 in 13 s, and
# `20260727-160758` t=0 relaxes 101.64 -> 83.14 and is within 0.3 m of its asymptote by t=33.
# 60 s is that with room to spare. A window shorter than this simply yields no samples.
SIM_SETTLE_S = 60.0

EARTH_R = 6371000.0


def metres_between(a, b):
    """Great-circle distance, metres, on a sphere. Good to ~0.2 % at these scales."""
    lat1, lon1 = math.radians(a[0]), math.radians(a[1])
    lat2, lon2 = math.radians(b[0]), math.radians(b[1])
    dlat, dlon = lat2 - lat1, lon2 - lon1
    h = math.sin(dlat / 2) ** 2 + math.cos(lat1) * math.cos(lat2) * math.sin(dlon / 2) ** 2
    return 2 * EARTH_R * math.asin(min(1.0, math.sqrt(h)))


# ── reading ───────────────────────────────────────────────────────────────────


class Session:
    """One recording session: its datum series, its origin, and how much to trust it."""

    def __init__(self, sid):
        self.sid = sid
        self.parts = []
        self.started_unix_ms = None
        self.datum = []  # (t_s, value_m) from dji_field takeoffAltitudeAmsl
        self.relalt = []  # (t_s, value_m) from dji_state
        self.fixes = []  # (t_s, lat, lon)
        self.sats = []  # (t_s, count)
        self.levels = []  # (t_s, level)
        self.sim_events = []  # (t_s, phase) parsed from sim_phase messages
        self.fc = []  # (t_s, connected) from dji_field fcConnected
        self.closed = False  # ends in recorder_stop
        self.has_stats = False
        self.last_t = 0.0
        self.dropped = 0

    # --- classification -------------------------------------------------------

    @property
    def whole(self):
        """A session is whole only if it closed itself. See the module docstring."""
        return self.closed and self.has_stats

    @property
    def sim_from(self):
        """First moment the simulator was ACTIVE, or None."""
        for t, ph in self.sim_events:
            if ph == "ACTIVE":
                return t
        return None

    @property
    def simulated(self):
        return self.sim_from is not None

    def real_intervals(self, settle=None):
        """The [start, end) windows in which the aircraft's own barometer was being reported.

        A session in which the simulator never ran is real throughout. Otherwise the phase
        timeline is walked. Two things make a window untrustworthy and both are handled here:

        * **The simulator is on.** `ACTIVE`, `STARTING` and `STOPPING` all mean the datum is
          pinned at ~100 m. `UNKNOWN` means the recorder does not know, which is not the same as
          off, so it closes a window too.
        * **The simulator has just been turned off.** Measured (`sim-session`, t = 329.8):
          the datum does not step back, it *relaxes* — 111.13, 104.86, 99.44, 94.86, 90.95 … 74.40
          over 13 s. `20260727-160758` shows the same relaxation taking 33 s to settle within
          0.3 m. So a window that opens after an observed simulator run starts `settle` seconds
          late. A window opened by the first `→ OFF` of a session that has not yet run the
          simulator carries no such pin and is not delayed.

        The head of a session that opened with the simulator already running is never counted at
        all: its datum is the previous run's 100 m still relaxing.
        """
        settle = SIM_SETTLE_S if settle is None else settle
        if not any(ph in SIM_ON for _, ph in self.sim_events):
            return [(0.0, float("inf"))]
        out = []
        open_at = None
        seen_on = False  # has the simulator been observed running yet in this session?
        for t, ph in self.sim_events:
            if ph == "OFF":
                if open_at is None:
                    open_at = t + (settle if seen_on else 0.0)
            elif ph in SIM_ON:
                if open_at is not None:
                    out.append((open_at, t))
                    open_at = None
                seen_on = True
            else:  # UNKNOWN, or anything this parser has not seen before
                if open_at is not None:
                    out.append((open_at, t))
                    open_at = None
        if open_at is not None:
            out.append((open_at, float("inf")))
        return [(a, b) for a, b in out if b > a]

    def in_real_window(self, t):
        return any(a <= t < b for a, b in self.real_intervals())

    def real_datum(self, honour_sim=True):
        if not honour_sim:
            return list(self.datum)
        return [(t, v) for (t, v) in self.datum if self.in_real_window(t)]

    def settled_datum(self):
        """The best single estimate of this session's datum: its last settled on-ground reading.

        `KeyTakeoffLocationAltitude` is not a raw barometer read-out. After any disturbance —
        the app attaching, the simulator stopping — it relaxes toward the barometric value with
        a time constant of a few seconds. Measured on `20260726-180444`, with no simulator
        involved: 79.479, 79.065, 78.713, 78.411, 78.150, 77.742, 77.450, 77.166, 76.891 over
        17 s, an unmistakable first-order settle and not weather. A *median* over such a session
        is dragged up by the transient; the last reading is past it. So `--between` reports this
        by default and prints first / median / n beside it so the transient stays visible.
        """
        pts = self.ground_datum_window()
        if not pts:
            pts = self.used_datum()
        return pts[-1][1] if pts else None

    @property
    def start_wall(self):
        return self.started_unix_ms

    def wall_of(self, t):
        if self.started_unix_ms is None:
            return None
        return self.started_unix_ms / 1000.0 + t

    # --- derived --------------------------------------------------------------

    def origin(self):
        """Median fix while on the ground, or median of all fixes if it never sat still.

        Median rather than first: the first fix of a session is the least settled one, and a
        median over the ground segment is what `docs/mem2-converter.md` compares sites with.
        """
        ground = self._ground_fixes()
        use = ground if len(ground) >= 3 else [(t, la, lo) for (t, la, lo) in self.fixes]
        if not use:
            return None
        return (statistics.median(p[1] for p in use), statistics.median(p[2] for p in use))

    def _ground_fixes(self):
        if not self.relalt:
            return list(self.fixes)
        out = []
        for t, la, lo in self.fixes:
            if abs(self._relalt_at(t)) <= GROUND_RELALT_M:
                out.append((t, la, lo))
        return out

    def _relalt_at(self, t):
        best, bt = 0.0, None
        for rt, v in self.relalt:
            if rt > t:
                break
            best, bt = v, rt
        return best if bt is not None else 0.0

    # `honour_sim` is set once by the caller; the accessors below then report the real
    # (simulator-off) samples only. Kept as state rather than a parameter so that no analysis
    # mode can forget to pass it and silently average a simulated 100 m into a barometer.
    honour_sim = True

    def used_datum(self):
        return self.real_datum(self.honour_sim)

    def datum_first(self):
        d = self.used_datum()
        return d[0][1] if d else None

    def datum_last(self):
        d = self.used_datum()
        return d[-1][1] if d else None

    def datum_median(self):
        d = self.used_datum()
        return statistics.median(v for _, v in d) if d else None

    def datum_span(self):
        d = self.used_datum()
        if not d:
            return None
        vs = [v for _, v in d]
        return max(vs) - min(vs)

    def ground_datum_window(self):
        """The datum samples taken while the aircraft was on the ground and not simulated.

        This is the drift measurement's raw material: `KeyTakeoffLocationAltitude` latches at
        takeoff (measured, `2026-07-26-amsl-datum.md`), so any sample after the aircraft leaves
        the ground is a frozen copy and would flatten the drift toward zero.
        """
        cut = self.first_airborne_t()
        best = []
        for lo, hi in self.connected_intervals():
            out = []
            for t, v in self.used_datum():
                if not (lo <= t < hi):
                    continue
                if cut is not None and t >= cut:
                    break
                if abs(self._relalt_at(t)) > GROUND_RELALT_M:
                    continue
                out.append((t, v))
            # "Longest" by elapsed time, not by sample count: the datum is change-driven, so a
            # noisy minute logs more samples than a steady hour.
            if out and (not best or out[-1][0] - out[0][0] > best[-1][0] - best[0][0]):
                best = out
        return best

    def connected_intervals(self):
        """The [start, end) windows in which the flight controller was actually attached.

        Without this, a session that sat with the aircraft off for most of an hour reads as an
        hour of rock-steady datum. Measured: `retest` reports `fcConnected false` from t = 88.6
        to t = 3223.0 -- 52 of its 54 minutes -- while the naive window called the whole span one
        stationary observation. A disconnected aircraft is not a stable barometer; it is no
        barometer.
        """
        if not self.fc:
            return [(0.0, float("inf"))]
        out = []
        open_at = None
        for t, up in self.fc:
            if up and open_at is None:
                open_at = t
            elif not up and open_at is not None:
                out.append((open_at, t))
                open_at = None
        if open_at is not None:
            out.append((open_at, float("inf")))
        return out

    def first_airborne_t(self):
        """When the aircraft first left the ground, or None if it never did.

        The drift window has to *end* here, not merely skip airborne samples. Because the datum
        latches at takeoff and stops updating, a window running from the first pre-flight reading
        to a post-landing one looks on-ground at both ends while containing an entire flight in
        between -- and every rate computed across it is divided by the wrong elapsed time.
        """
        for t, v in self.relalt:
            if abs(v) > GROUND_RELALT_M:
                return t
        return None

    def sats_median(self):
        return statistics.median(v for _, v in self.sats) if self.sats else None

    def level_median(self):
        return statistics.median(v for _, v in self.levels) if self.levels else None


def read_sessions(paths):
    """Read every file into a Session keyed by session id, merging multi-part recordings."""
    sessions = {}
    for p in sorted(paths):
        base = os.path.basename(p)
        sid = base.split(".")[0]
        s = sessions.setdefault(sid, Session(sid))
        s.parts.append(base)
        part_closed = False
        part_stats = False
        with open(p, errors="replace") as fh:
            for line in fh:
                line = line.strip()
                if not line:
                    continue
                try:
                    o = json.loads(line)
                except Exception:
                    continue  # a torn last line is exactly what truncation leaves
                k = o.get("k")
                t = o.get("t")
                if isinstance(t, (int, float)):
                    s.last_t = max(s.last_t, t)
                if k == "header":
                    if s.started_unix_ms is None or o.get("part") == 1:
                        s.started_unix_ms = o.get("started_unix_ms")
                    part_closed = False
                    part_stats = False
                elif k == "dji_field":
                    f, n = o.get("f"), o.get("n")
                    # fcConnected is a boolean field: it carries `v`, never the numeric `n`,
                    # so it has to be read before the numeric guard below.
                    if f == "fcConnected":
                        v = o.get("v")
                        if v in ("true", "false"):
                            s.fc.append((t, v == "true"))
                        continue
                    if n is None:
                        continue
                    if f == "takeoffAltitudeAmsl":
                        s.datum.append((t, float(n)))
                    elif f == "satelliteCount":
                        s.sats.append((t, float(n)))
                    elif f == "gpsSignalLevel":
                        s.levels.append((t, float(n)))
                elif k == "dji_state":
                    la, lo = o.get("lat"), o.get("lon")
                    if isinstance(la, (int, float)) and isinstance(lo, (int, float)):
                        s.fixes.append((t, float(la), float(lo)))
                    ra = o.get("relalt")
                    if isinstance(ra, (int, float)):
                        s.relalt.append((t, float(ra)))
                elif k == "event":
                    code, msg = o.get("code"), o.get("msg") or ""
                    if code == "sim_phase":
                        # Messages are "simulator phase A → B (…)"; anything else (a START
                        # request, an ACCEPTED notice) carries no phase and is ignored.
                        if "phase" in msg and "→" in msg:
                            after = msg.split("→", 1)[1].strip().split()[0].strip("().,")
                            s.sim_events.append((t, after))
                    elif code == "recorder_stop":
                        part_closed = True
                elif k == "stats":
                    part_stats = True
                    s.dropped = max(s.dropped, o.get("dropped") or 0)
        # A multi-part session is whole iff its *last* part closed itself.
        s.closed = part_closed
        s.has_stats = part_stats
    for s in sessions.values():
        s.datum.sort()
        s.relalt.sort()
        s.fixes.sort()
        s.sats.sort()
        s.levels.sort()
        s.sim_events.sort()
        s.fc.sort()
    return [sessions[k] for k in sorted(sessions)]


def dedupe(sessions):
    """One Session per recording. Returns (kept, [(dropped, kept_it_duplicated)]).

    Several files on disk are renamed copies -- often truncated prefixes -- of a recording that
    also exists under its own session id. `started_unix_ms` identifies the recording; the copy
    with the most datum samples wins, and ties go to the one that closed itself.
    """
    by_start = defaultdict(list)
    loners = []
    for s in sessions:
        if s.started_unix_ms is None:
            loners.append(s)
        else:
            by_start[s.started_unix_ms].append(s)
    kept, dropped = list(loners), []
    for _, group in sorted(by_start.items()):
        group.sort(key=lambda x: (len(x.datum), x.whole, x.last_t), reverse=True)
        kept.append(group[0])
        for other in group[1:]:
            dropped.append((other, group[0]))
    kept.sort(key=lambda s: (s.wall_of(0) or 0, s.sid))
    return kept, dropped


def group_by_site(sessions, radius=SITE_RADIUS_M):
    """Single-link clustering of session origins. Returns [(centre, [sessions])]."""
    placed = []
    for s in sessions:
        o = s.origin()
        if o is None:
            continue
        for g in placed:
            if metres_between(o, g["centre"]) <= radius:
                g["members"].append((s, o))
                lats = [p[1][0] for p in g["members"]]
                lons = [p[1][1] for p in g["members"]]
                g["centre"] = (statistics.median(lats), statistics.median(lons))
                break
        else:
            placed.append({"centre": o, "members": [(s, o)]})
    placed.sort(key=lambda g: -len(g["members"]))
    return placed


# ── filtering ─────────────────────────────────────────────────────────────────


def usable(sessions, include_sim, include_cut, need_datum=True, need_whole=True):
    """Apply the exclusions the module docstring promises, and say what was dropped.

    `need_whole` is False for the between-session comparison: what that measures is where the
    datum *started*, and a file cut short still carries its own opening readings honestly. It is
    True for drift, where a missing tail shortens the very window being measured.
    """
    out, dropped = [], []
    for s in sessions:
        if need_datum and not s.datum:
            dropped.append((s, "no takeoffAltitudeAmsl reading at all"))
        elif need_datum and not s.used_datum():
            dropped.append((s, "every reading was simulated or post-simulator-carryover"))
        elif need_whole and not s.whole and not include_cut:
            dropped.append((s, "open-or-cut (no closing recorder_stop + stats)"))
        else:
            out.append(s)
    return out, dropped


def num(v, dp=2):
    """Format a number that may be absent. A '-' is a fact; a crash is not."""
    return "-" if v is None else f"{v:.{dp}f}"


def fmt_wall(unix_s):
    if unix_s is None:
        return "?"
    import datetime

    return datetime.datetime.fromtimestamp(unix_s).strftime("%Y-%m-%d %H:%M:%S")


