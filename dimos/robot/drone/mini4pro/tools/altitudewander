def _write_synth(
    path,
    sid,
    started_unix_ms,
    datum_points,
    lat,
    lon,
    close=True,
    sim_at=None,
    sats=14,
    level=5,
    relalt_points=None,
    observe_off=True,
    sim_off_at=None,
    disconnects=None,
):
    """Write a minimal but format-faithful `mini4pro-flightlog-1` file.

    `sim_at` starts the simulator; `observe_off` decides whether the recorder saw the phase as
    OFF first (the difference between a trustworthy pre-simulator segment and a session that
    opened mid-simulation). `sim_off_at` stops it again.
    """
    with open(path, "w") as fh:

        def emit(o):
            fh.write(json.dumps(o) + "\n")

        emit(
            {
                "t": 0.0,
                "k": "header",
                "format": "mini4pro-flightlog-1",
                "schema": 1,
                "session": sid,
                "part": 1,
                "started_unix_ms": started_unix_ms,
            }
        )
        emit({"t": 0.001, "k": "event", "code": "recorder_start", "sev": "info"})
        emit({"t": 0.002, "k": "dji_field", "f": "satelliteCount", "v": str(sats), "n": sats})
        emit({"t": 0.003, "k": "dji_field", "f": "gpsSignalLevel", "v": str(level), "n": level})
        emit({"t": 0.0, "k": "dji_field", "f": "fcConnected", "v": "true"})
        for dt, up in disconnects or []:
            emit({"t": dt, "k": "dji_field", "f": "fcConnected", "v": "true" if up else "false"})
        if sim_at is not None:
            if observe_off:
                emit(
                    {
                        "t": 0.004,
                        "k": "event",
                        "code": "sim_phase",
                        "sev": "warn",
                        "msg": "simulator phase UNKNOWN → OFF (DJI reports started=false)",
                    }
                )
            emit(
                {
                    "t": sim_at,
                    "k": "event",
                    "code": "sim_phase",
                    "sev": "warn",
                    "msg": "simulator START requested at 1.0,2.0 sats=14 — DJI has not confirmed",
                }
            )
            emit(
                {
                    "t": sim_at,
                    "k": "event",
                    "code": "sim_phase",
                    "sev": "warn",
                    "msg": "simulator phase STARTING → ACTIVE (DJI reports started=true)",
                }
            )
        if sim_off_at is not None:
            emit(
                {
                    "t": sim_off_at,
                    "k": "event",
                    "code": "sim_phase",
                    "sev": "warn",
                    "msg": "simulator phase ACTIVE → OFF (DJI reports started=false)",
                }
            )
        rel = relalt_points or []
        merged = [("d", t, v) for t, v in datum_points] + [("r", t, v) for t, v in rel]
        merged.sort(key=lambda x: x[1])
        last_t = 0.0
        for kind, t, v in merged:
            last_t = t
            if kind == "d":
                emit({"t": t, "k": "dji_field", "f": "takeoffAltitudeAmsl", "v": str(v), "n": v})
            else:
                emit({"t": t, "k": "dji_state", "lat": lat, "lon": lon, "relalt": v})
        # A fix stream so origin() has something to take a median of.
        for _i in range(6):
            last_t += 0.5
            emit({"t": last_t, "k": "dji_state", "lat": lat, "lon": lon, "relalt": 0.0})
        if close:
            emit({"t": last_t + 0.01, "k": "event", "code": "recorder_stop", "sev": "info"})
            emit({"t": last_t + 0.02, "k": "stats", "written": 1, "dropped": 0, "part": 1})


def selftest(verbose=False):
    """Plant known numbers, assert this tool recovers them. Returns the failure count."""
    failures = []

    def check(name, ok, detail=""):
        if ok:
            if verbose:
                print(f"  PASS {name} {detail}")
        else:
            failures.append(f"{name}: {detail}")
            print(f"  FAIL {name} {detail}")

    tmp = tempfile.mkdtemp(prefix="altwander-")
    BASE = 1785000000000  # arbitrary epoch ms
    SITE_A = (37.99386, 23.72533)
    SITE_B = (37.99386 + 0.01, 23.72533)  # ~1.1 km away — must not merge

    # 1. A clean session with a planted linear drift of exactly +0.5 m/min over 10 min.
    pts = [(i * 30.0, 100.0 + 0.25 * i) for i in range(21)]  # 30 s steps, 0.25 m each
    _write_synth(
        f"{tmp}/20260101-000000.001.jsonl",
        "20260101-000000",
        BASE,
        pts,
        *SITE_A,
        relalt_points=[(0.0, 0.0)],
    )
    # 2. Same site, datum 40 m lower — the planted between-session spread.
    pts2 = [(i * 30.0, 60.0) for i in range(21)]
    _write_synth(
        f"{tmp}/20260101-010000.001.jsonl",
        "20260101-010000",
        BASE + 3600_000,
        pts2,
        *SITE_A,
        relalt_points=[(0.0, 0.0)],
    )
    # 3. Same site again, mid value, to give the group a median.
    pts3 = [(i * 30.0, 80.0) for i in range(21)]
    _write_synth(
        f"{tmp}/20260101-020000.001.jsonl",
        "20260101-020000",
        BASE + 7200_000,
        pts3,
        *SITE_A,
        relalt_points=[(0.0, 0.0)],
    )
    # 4. A different site 1.1 km away — must land in its own group.
    _write_synth(
        f"{tmp}/20260101-030000.001.jsonl",
        "20260101-030000",
        BASE + 10800_000,
        [(0.0, 500.0), (30.0, 500.0), (60.0, 500.0)],
        *SITE_B,
        relalt_points=[(0.0, 0.0)],
    )
    # 5. A truncated session — no recorder_stop.
    _write_synth(
        f"{tmp}/20260101-040000.001.jsonl",
        "20260101-040000",
        BASE + 14400_000,
        [(0.0, 999.0), (30.0, 999.0), (60.0, 999.0)],
        *SITE_A,
        close=False,
        relalt_points=[(0.0, 0.0)],
    )
    # 6. A simulated session with an observed OFF at t=0.004 and ACTIVE at t=5: the three
    #    readings inside that window are real barometer, the two after it are the simulator.
    _write_synth(
        f"{tmp}/20260101-050000.001.jsonl",
        "20260101-050000",
        BASE + 18000_000,
        [(1.0, 777.0), (2.0, 777.0), (3.0, 777.0), (30.0, 100.0), (60.0, 100.0)],
        *SITE_A,
        sim_at=5.0,
        relalt_points=[(0.0, 0.0)],
    )
    # 7. Airborne after t=60: the datum latches, so drift must ignore the frozen tail.
    air = [(i * 30.0, 200.0 + 0.25 * i) for i in range(3)] + [
        (90.0 + i * 30.0, 200.5) for i in range(10)
    ]
    rel = [(0.0, 0.0), (75.0, 30.0)]
    _write_synth(
        f"{tmp}/20260101-060000.001.jsonl",
        "20260101-060000",
        BASE + 21600_000,
        air,
        *SITE_A,
        relalt_points=rel,
    )

    # 8. A session that ran the simulator between t=100 and t=200. Its real barometer readings
    #    are the 60 m ones outside that window; the 100 m ones inside it are the simulator.
    mixed = (
        [(t, 60.0) for t in (0.0, 30.0, 60.0, 90.0)]
        + [(t, 100.0) for t in (110.0, 140.0, 170.0)]
        + [(t, 61.0) for t in (210.0, 240.0)]
    )
    _write_synth(
        f"{tmp}/20260101-070000.001.jsonl",
        "20260101-070000",
        BASE + 25200_000,
        mixed,
        *SITE_A,
        sim_at=100.0,
        sim_off_at=200.0,
        relalt_points=[(0.0, 0.0)],
    )
    # 9. A session that opened with the simulator already running -- no observed OFF. Its head
    #    is the previous run's pinned 100 m decaying back and must be discarded entirely.
    carry = [(0.0, 101.6), (30.0, 99.5), (60.0, 97.5)]
    _write_synth(
        f"{tmp}/20260101-080000.001.jsonl",
        "20260101-080000",
        BASE + 28800_000,
        carry,
        *SITE_A,
        sim_at=70.0,
        observe_off=False,
        relalt_points=[(0.0, 0.0)],
    )
    # 10. A renamed copy of session 3 -- same started_unix_ms, fewer samples. Must be merged.
    _write_synth(
        f"{tmp}/renamed-copy.jsonl",
        "renamed-copy",
        BASE + 7200_000,
        [(0.0, 80.0)],
        *SITE_A,
        relalt_points=[(0.0, 0.0)],
    )

    # 11. A session that sat "still" for 20 min but had the aircraft detached for 18 of them.
    #     Only the connected head may be measured, and it is 2 min long, not 20.
    det = [
        (0.0, 50.0),
        (30.0, 50.5),
        (60.0, 51.0),
        (90.0, 51.5),
        (120.0, 52.0),
        (1140.0, 52.5),
        (1170.0, 53.0),
    ]
    _write_synth(
        f"{tmp}/20260101-090000.001.jsonl",
        "20260101-090000",
        BASE + 32400_000,
        det,
        *SITE_A,
        relalt_points=[(0.0, 0.0)],
        disconnects=[(125.0, False), (1130.0, True)],
    )

    files = [os.path.join(tmp, f) for f in sorted(os.listdir(tmp))]
    ss = read_sessions(files)
    by = {s.sid: s for s in ss}
    Session.honour_sim = True

    check("reads every session", len(ss) == 11, f"got {len(ss)}")

    # Connection gating.
    det_s = by["20260101-090000"]
    dw = det_s.ground_datum_window()
    check(
        "the drift window stops at a flight-controller disconnect",
        [round(t, 1) for t, _ in dw] == [0.0, 30.0, 60.0, 90.0, 120.0],
        f"got {dw}",
    )
    dd = drift_of(det_s, 60)
    check(
        "a 20 min session with an 18 min disconnect measures 2 min, not 20",
        dd is not None and abs(dd["minutes"] - 2.0) < 1e-6,
        f"got {dd and dd['minutes']:.3f} min",
    )
    check(
        "connected_intervals splits on the disconnect",
        det_s.connected_intervals() == [(0.0, 125.0), (1130.0, float("inf"))],
        f"got {det_s.connected_intervals()}",
    )

    # Simulator windowing.
    mix = by["20260101-070000"]
    used = [v for _, v in mix.used_datum()]
    # Three, not six. The t=0.0 sample precedes the OFF observation at t=0.004, and a reading
    # taken before the recorder has seen any phase at all is not *known* to be simulator-off.
    # The t=210 and t=240 samples fall inside the 60 s settle after the simulator stopped at
    # t=200, where the datum is still relaxing off the pinned 100 m. Both exclusions are the
    # conservative direction.
    check(
        "uses only the samples known to be simulator-off and settled",
        used == [60.0, 60.0, 60.0],
        f"got {used}",
    )
    check(
        "the post-simulator settle window is honoured",
        mix.real_intervals()[1][0] == 260.0,
        f"got {mix.real_intervals()}",
    )
    check(
        "a shorter settle lets the post-simulator samples back in",
        [v for t, v in mix.datum if any(a <= t < b for a, b in mix.real_intervals(settle=5.0))]
        == [60.0, 60.0, 60.0, 61.0, 61.0],
        "",
    )
    check(
        "no settle is charged to a session that has not yet run the simulator",
        by["20260101-050000"].real_intervals()[0][0] == 0.004,
        f"got {by['20260101-050000'].real_intervals()}",
    )
    check("simulator-off samples exclude the pinned 100 m", 100.0 not in used, f"got {used}")
    cy = by["20260101-080000"]
    check(
        "discards the head of a session that opened mid-simulation",
        cy.used_datum() == [],
        f"got {cy.used_datum()}",
    )
    check("that session is still flagged sim", cy.simulated is True, "")
    check(
        "pre-simulator segment of an observed-OFF session is kept",
        [v for _, v in by["20260101-050000"].used_datum()] == [777.0, 777.0, 777.0],
        f"got {by['20260101-050000'].used_datum()}",
    )

    # The settled statistic: last on-ground reading, past the transient.
    check(
        "settled_datum is the last on-ground reading",
        by["20260101-070000"].settled_datum() == 60.0,
        f"got {by['20260101-070000'].settled_datum()}",
    )
    check(
        "settled_datum differs from the median when there is a transient",
        abs(by["20260101-000000"].settled_datum() - 105.0) < 1e-9
        and abs(by["20260101-000000"].datum_median() - 102.5) < 1e-9,
        f"settled {by['20260101-000000'].settled_datum()}, "
        f"median {by['20260101-000000'].datum_median()}",
    )
    check(
        "settled_datum ignores the latched airborne tail",
        abs(by["20260101-060000"].settled_datum() - 200.5) < 1e-9,
        f"got {by['20260101-060000'].settled_datum()}",
    )

    # Dedupe.
    kept, dups = dedupe(ss)
    check(
        "merges a renamed copy away",
        len(kept) == 10 and len(dups) == 1,
        f"kept {len(kept)}, dropped {len(dups)}",
    )
    if dups:
        check(
            "keeps the richer copy of a duplicated recording",
            dups[0][0].sid == "renamed-copy" and dups[0][1].sid == "20260101-020000",
            f"dropped {dups[0][0].sid} in favour of {dups[0][1].sid}",
        )
    check("truncated session flagged CUT", by["20260101-040000"].whole is False, "")
    check("clean session flagged whole", by["20260101-000000"].whole is True, "")
    check("simulated session flagged sim", by["20260101-050000"].simulated is True, "")
    check("non-simulated session not flagged sim", by["20260101-000000"].simulated is False, "")

    # Drift: planted +0.5 m/min exactly.
    d = drift_of(by["20260101-000000"], 60)
    check(
        "recovers planted drift rate",
        d is not None and abs(d["slope_m_per_min"] - 0.5) < 1e-6,
        f"got {d and d['slope_m_per_min']:.4f} m/min, expected +0.5",
    )
    check(
        "recovers planted end-to-end delta",
        d is not None and abs(d["endpoint_delta"] - 5.0) < 1e-6,
        f"got {d and d['endpoint_delta']:.4f} m, expected 5.0",
    )
    check(
        "recovers planted window length",
        d is not None and abs(d["minutes"] - 10.0) < 1e-6,
        f"got {d and d['minutes']:.4f} min, expected 10.0",
    )

    # The latched tail must not be counted as ground.
    d7 = drift_of(by["20260101-060000"], 30)
    check(
        "excludes airborne (latched) datum samples",
        d7 is not None and d7["n"] == 3,
        f"got n={d7 and d7['n']}, expected 3 on-ground samples",
    )
    check(
        "the drift window ends at first takeoff, not at the last on-ground sample",
        by["20260101-060000"].first_airborne_t() == 75.0,
        f"got {by['20260101-060000'].first_airborne_t()}",
    )
    check(
        "airborne session's drift is the ground segment's",
        d7 is not None and abs(d7["slope_m_per_min"] - 0.5) < 1e-6,
        f"got {d7 and d7['slope_m_per_min']:.4f}, expected +0.5",
    )

    # Grouping. Sessions 1,2,3,7 sit at site A and closed themselves; 4 is 1.1 km away.
    clean = [s for s in kept if s.whole and not s.simulated]
    groups = group_by_site(clean)
    check("splits two sites 1.1 km apart", len(groups) == 2, f"got {len(groups)}")
    big = groups[0]
    check(
        "same-site group holds every session at that site",
        len(big["members"]) == 5,
        f"got {len(big['members'])}, expected 5 (sessions 1,2,3,7,11 at site A)",
    )
    check(
        "the far site is its own group of one",
        len(groups[1]["members"]) == 1,
        f"got {len(groups[1]['members'])}",
    )

    # Exclusions.
    use, dropped = usable(kept, include_sim=False, include_cut=False)
    ids = {s.sid for s in use}
    check("keeps a sim session that has a real pre-simulator segment", "20260101-050000" in ids, "")
    check(
        "excludes a session whose every reading was simulated or carryover",
        "20260101-080000" not in ids,
        "",
    )
    check("excludes truncated by default (drift-style gate)", "20260101-040000" not in ids, "")
    check("keeps clean sessions", "20260101-000000" in ids, "")
    use_b, _ = usable(kept, include_sim=False, include_cut=False, need_whole=False)
    check(
        "--between's gate keeps the truncated session's opening readings",
        "20260101-040000" in {s.sid for s in use_b},
        "",
    )

    # Spread across the planted site-A group. Session 1 drifts 100.00 -> 105.00 in 21 even
    # steps, so its *median* is 102.50, not 100 -- the flat sessions are 60 and 80. The
    # planted range of the medians is therefore 42.50 m exactly. Asserting 40 here would be
    # asserting that the tool reports first values where it says it reports medians.
    site_a = [
        s
        for s, _ in big["members"]
        if s.sid in {"20260101-000000", "20260101-010000", "20260101-020000"}
    ]
    meds = sorted(s.datum_median() for s in site_a)
    check(
        "recovers planted between-session range",
        abs((meds[-1] - meds[0]) - 42.5) < 1e-6,
        f"got {meds[-1] - meds[0]:.4f} m, expected 42.5",
    )
    check(
        "session medians are medians, not first values",
        abs(meds[-1] - 102.5) < 1e-6,
        f"got {meds[-1]:.4f}, expected 102.5",
    )

    # Consecutive-pair maths, against a hand-checkable case: sessions 1,2,3 at site A are one
    # hour apart with settled values 105.0, 60.0, 80.0, so the pairs are (60 min, 45.0) and
    # (60 min, 20.0).
    class _A:
        pass

    a = _A()
    a.include_sim, a.include_cut, a.radius = False, True, SITE_RADIUS_M
    prs = []
    for g in group_by_site(
        [by[x] for x in ("20260101-000000", "20260101-010000", "20260101-020000")]
    ):
        mem = sorted(((x.wall_of(0), x) for x, _ in g["members"]), key=lambda r: r[0])
        for (t1, s1), (t2, s2) in itertools.pairwise(mem):
            prs.append(((t2 - t1) / 60.0, abs(s2.settled_datum() - s1.settled_datum())))
    check(
        "consecutive-pair gaps and deltas are right",
        [(round(g), round(d, 6)) for g, d in prs] == [(60, 45.0), (60, 20.0)],
        f"got {prs}",
    )

    # The barometric formula, against the published ICAO standard-atmosphere levels. These are
    # textbook numbers, not numbers this project produced.
    for p_hpa, want, tol in [
        (1013.25, 0.0, 0.01),
        (1000.0, 110.9, 0.2),
        (900.0, 988.0, 1.0),
        (700.0, 3012.0, 3.0),
        (500.0, 5574.0, 3.0),
    ]:
        got = isa_pressure_altitude(p_hpa)
        check(
            f"ISA pressure altitude at {p_hpa:.2f} hPa",
            abs(got - want) < tol,
            f"got {got:.1f} m, standard atmosphere says {want:.1f} m",
        )
    check(
        "pressure_at interpolates within the hour",
        PRESSURE_HOURLY
        and pressure_at(
            __import__("datetime")
            .datetime.strptime(PRESSURE_HOURLY[0][0], "%Y-%m-%dT%H:%M")
            .timestamp()
        )
        == PRESSURE_HOURLY[0][1],
        "",
    )

    # Distance maths.
    check(
        "metres_between is right to 1 %",
        abs(metres_between(SITE_A, SITE_B) - 1112.0) < 12.0,
        f"got {metres_between(SITE_A, SITE_B):.1f} m for 0.01 deg of latitude",
    )
    check("metres_between is zero for a point on itself", metres_between(SITE_A, SITE_A) < 1e-9, "")

    # Correlation maths, against a hand-checkable case.
    check(
        "pearson recovers +1 on a straight line",
        abs(pearson([1, 2, 3, 4], [2, 4, 6, 8]) - 1.0) < 1e-9,
        "",
    )
    check(
        "pearson recovers -1 on a falling line",
        abs(pearson([1, 2, 3, 4], [8, 6, 4, 2]) + 1.0) < 1e-9,
        "",
    )
    check("pearson returns None on a constant", pearson([1, 2, 3, 4], [5, 5, 5, 5]) is None, "")

    for f in files:
        os.unlink(f)
    os.rmdir(tmp)

    print()
    if failures:
        print(f"{len(failures)} self-test failure(s):")
        for f in failures:
            print(f"  - {f}")
    else:
        print("self-test: all planted numbers recovered")
    return len(failures)


# ── cli ───────────────────────────────────────────────────────────────────────


def main():
    ap = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    ap.add_argument("files", nargs="*", help="session JSONL file(s)")
    ap.add_argument("--sessions", action="store_true", help="per-session table (the default)")
    ap.add_argument(
        "--between",
        action="store_true",
        help="spread of the datum across sessions, grouped by launch site",
    )
    ap.add_argument(
        "--drift",
        action="store_true",
        help="within-session drift while the aircraft sat on the ground",
    )
    ap.add_argument(
        "--truth",
        type=float,
        metavar="M",
        help="compare every session's datum against this true elevation, metres",
    )
    ap.add_argument(
        "--truth-source",
        default="unstated",
        help="where --truth came from; printed with the result",
    )
    ap.add_argument(
        "--pressure",
        action="store_true",
        help="datum against independently-measured surface pressure",
    )
    ap.add_argument(
        "--repeat",
        action="store_true",
        help="how far consecutive same-site sessions' datums are apart, by gap",
    )
    ap.add_argument(
        "--correlate",
        action="store_true",
        help="datum against satellites, signal level, hour, length",
    )
    ap.add_argument(
        "--radius",
        type=float,
        default=SITE_RADIUS_M,
        help=f"same-site radius, metres (default {SITE_RADIUS_M:.0f})",
    )
    ap.add_argument(
        "--min-ground",
        type=float,
        default=120.0,
        help="shortest on-ground window --drift will report, seconds (default 120)",
    )
    ap.add_argument(
        "--stat",
        choices=("settled", "median", "first"),
        default="settled",
        help="which single number represents a session's datum (default settled: "
        "its last on-ground reading, past the post-disturbance transient)",
    )
    ap.add_argument(
        "--min-samples",
        type=int,
        default=2,
        help="sessions a site needs before a spread is reported (default 2)",
    )
    ap.add_argument("--include-sim", action="store_true", help="do not exclude simulated sessions")
    ap.add_argument(
        "--include-cut",
        action="store_true",
        help="do not exclude sessions with no closing recorder_stop",
    )
    ap.add_argument("--selftest", action="store_true", help="planted numbers, all recovered")
    ap.add_argument(
        "--quiet",
        action="store_true",
        help="do not list the renamed duplicates that were merged away",
    )
    ap.add_argument("--verbose", action="store_true")
    args = ap.parse_args()

    if args.selftest:
        return 1 if selftest(args.verbose) else 0
    if not args.files:
        ap.error("no files given (or pass --selftest)")

    sessions = read_sessions(args.files)
    Session.honour_sim = not args.include_sim
    sessions, dups = dedupe(sessions)
    if dups and not args.quiet:
        print(f"{len(dups)} file(s) are renamed copies of another session and were merged away:")
        for d, keeper in dups:
            print(
                f"  {d.sid:<24} == {keeper.sid}   "
                f"({len(d.datum)} vs {len(keeper.datum)} datum samples)"
            )
        print()
    if args.between:
        return mode_between(sessions, args)
    if args.drift:
        return mode_drift(sessions, args)
    if args.truth is not None:
        return mode_truth(sessions, args)
    if args.pressure:
        return mode_pressure(sessions, args)
    if args.repeat:
        return mode_repeat(sessions, args)
    if args.correlate:
        return mode_correlate(sessions, args)
    mode_sessions(sessions, args)
    return 0


if __name__ == "__main__":
    sys.exit(main())
