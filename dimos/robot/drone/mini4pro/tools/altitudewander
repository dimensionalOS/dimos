def mode_repeat(sessions, args):
    """How far apart two sessions' datums are, as a function of the gap between them.

    This is the measurement that separates "the datum jumps at random between power cycles"
    from "the datum tracks something that changes over hours". If consecutive sessions minutes
    apart agree to a fraction of a metre while sessions hours apart differ by tens, then the
    quantity is not jumping — it is following a slow external variable, and every power cycle in
    between is innocent.
    """
    use, _ = usable(sessions, args.include_sim, args.include_cut, need_whole=False)
    pts = []
    for g in group_by_site(use, args.radius):
        mem = sorted(
            ((s.wall_of(0), s) for s, _ in g["members"] if s.wall_of(0)), key=lambda r: r[0]
        )
        for (t1, s1), (t2, s2) in itertools.pairwise(mem):
            v1, v2 = s1.settled_datum(), s2.settled_datum()
            if v1 is None or v2 is None:
                continue
            pts.append(((t2 - t1) / 60.0, abs(v2 - v1), s1, s2))
    if not pts:
        print("no two sessions at the same site to compare")
        return 1
    pts.sort()
    print(f"{len(pts)} consecutive same-site pair(s), ordered by the gap between them\n")
    hdr = f"{'gap (min)':>10} {'|delta| (m)':>12} {'m/h':>8}  earlier -> later"
    print(hdr)
    print("-" * (len(hdr) + 30))
    for gap, d, s1, s2 in pts:
        rate = d / (gap / 60.0) if gap > 0 else float("nan")
        print(f"{gap:>10.1f} {d:>12.2f} {rate:>8.2f}  {s1.sid} -> {s2.sid}")
    for lo, hi, label in [
        (0, 5, "under 5 min"),
        (5, 60, "5 min to 1 h"),
        (60, 6 * 60, "1 h to 6 h"),
        (6 * 60, 1e9, "over 6 h"),
    ]:
        band = [d for gap, d, _, _ in pts if lo <= gap < hi]
        if band:
            print(
                f"\n{label:<14} n={len(band):<3} |delta| min {min(band):.2f}  "
                f"median {statistics.median(band):.2f}  max {max(band):.2f}"
            )
        else:
            print(f"\n{label:<14} no pairs")
    return 0


def pearson(xs, ys):
    n = len(xs)
    if n < 3:
        return None
    mx, my = sum(xs) / n, sum(ys) / n
    num = sum((x - mx) * (y - my) for x, y in zip(xs, ys, strict=False))
    dx = math.sqrt(sum((x - mx) ** 2 for x in xs))
    dy = math.sqrt(sum((y - my) ** 2 for y in ys))
    if dx == 0 or dy == 0:
        return None
    return num / (dx * dy)


def mode_correlate(sessions, args):
    use, _ = usable(sessions, args.include_sim, args.include_cut, need_whole=False)
    rows = []
    for s in use:
        v = s.settled_datum()
        if v is None or s.wall_of(0) is None:
            continue
        import datetime

        dt = datetime.datetime.fromtimestamp(s.wall_of(0))
        rows.append(
            {
                "sid": s.sid,
                "datum": v,
                "sats": s.sats_median(),
                "level": s.level_median(),
                "hour": dt.hour + dt.minute / 60.0,
                "epoch_h": s.wall_of(0) / 3600.0,
                "length_s": s.last_t,
            }
        )
    if len(rows) < 3:
        print(f"{len(rows)} usable session(s) — too few to correlate anything")
        return 1
    print(f"{len(rows)} session(s)\n")
    print(f"{'against':<24} {'n':>4} {'pearson r':>10}")
    print("-" * 40)
    for name, key in [
        ("satelliteCount (median)", "sats"),
        ("gpsSignalLevel (median)", "level"),
        ("hour of day", "hour"),
        ("absolute time", "epoch_h"),
        ("session length (s)", "length_s"),
    ]:
        pairs = [(r[key], r["datum"]) for r in rows if r.get(key) is not None]
        r = pearson([p[0] for p in pairs], [p[1] for p in pairs])
        print(f"{name:<24} {len(pairs):>4} {(f'{r:+.3f}' if r is not None else 'n/a'):>10}")
    print(
        "\nWeather is the obvious confound and is not recorded by this bridge. A correlation "
        "with\n'absolute time' is therefore ambiguous between a clock-like sensor drift and the "
        "pressure\nchanging over the same hours; this tool cannot separate them and does not "
        "try."
    )
    return 0


