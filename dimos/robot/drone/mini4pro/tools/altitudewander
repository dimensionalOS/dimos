def isa_pressure_altitude(p_hpa):
    """ICAO-standard pressure altitude, metres, for a station pressure in hPa.

    h = (T0/L) * (1 - (p/p0)^(R*L/g)) with the ISA constants T0 = 288.15 K, L = 0.0065 K/m,
    R = 287.053 J/(kg K), g = 9.80665 m/s^2 -- i.e. the altitude at which the standard
    atmosphere has this pressure, referenced to 1013.25 hPa. Checked in --selftest against the
    published standard-atmosphere levels.
    """
    return 44330.77 * (1.0 - (p_hpa / 1013.25) ** 0.190263)


def pressure_at(unix_s):
    """Linear interpolation of the hourly series at a local wall-clock instant."""
    import datetime

    dt = datetime.datetime.fromtimestamp(unix_s)
    key = dt.strftime("%Y-%m-%dT%H:00")
    idx = {t: i for i, (t, _) in enumerate(PRESSURE_HOURLY)}
    i = idx.get(key)
    if i is None:
        return None
    p0 = PRESSURE_HOURLY[i][1]
    if i + 1 >= len(PRESSURE_HOURLY):
        return p0
    p1 = PRESSURE_HOURLY[i + 1][1]
    frac = (dt.minute * 60 + dt.second) / 3600.0
    return p0 + (p1 - p0) * frac


def mode_pressure(sessions, args):
    """Test the one hypothesis the recorded data plus free weather data can settle.

    If `takeoffAltitudeAmsl` is ICAO pressure altitude rather than an elevation, then
    DJI_reading - PA(ISA at the site) is the aircraft's height above the model's ground, and is
    therefore *constant* while the raw reading swings by tens of metres. If it is an elevation,
    the residual is what swings. This is the same argument as
    `docs/measurements/2026-07-26-amsl-datum.md`, run over every session rather than 18 rows.
    """
    use, _ = usable(sessions, args.include_sim, args.include_cut, need_whole=False)
    hdr = (
        f"{'session':<22} {'start (local)':<20} {'DJI (m)':>8} {'p_sfc':>8} "
        f"{'PA(ISA)':>8} {'residual':>9}"
    )
    print(hdr)
    print("-" * len(hdr))
    raws, res = [], []
    for s in sorted(use, key=lambda x: x.wall_of(0) or 0):
        v = s.settled_datum()
        w = s.wall_of(0)
        if v is None or w is None:
            continue
        pr = pressure_at(w)
        if pr is None:
            print(f"{s.sid:<22} {fmt_wall(w):<20} {v:>8.2f}   no pressure row for this hour")
            continue
        pa = isa_pressure_altitude(pr)
        raws.append(v)
        res.append(v - pa)
        print(f"{s.sid:<22} {fmt_wall(w):<20} {v:>8.2f} {pr:>8.2f} {pa:>8.2f} {v - pa:>+9.2f}")
    if len(res) < 3:
        print("\ntoo few sessions to compare")
        return 1
    print(
        f"\nDJI raw:   {min(raws):.2f} .. {max(raws):.2f}  = {max(raws) - min(raws):.2f} m "
        f"of spread, sd {statistics.stdev(raws):.2f} m"
    )
    print(
        f"residual:  {min(res):+.2f} .. {max(res):+.2f}  = {max(res) - min(res):.2f} m "
        f"of spread, sd {statistics.stdev(res):.2f} m, mean {statistics.mean(res):+.2f} m"
    )
    var_removed = 1.0 - (statistics.variance(res) / statistics.variance(raws))
    print(
        f"\nsubtracting the independently-measured pressure altitude removes "
        f"{100 * var_removed:.1f} % of the variance."
    )
    print(
        f"implied site elevation: {PRESSURE_GRID_ELEV_M:.0f} m grid + "
        f"{statistics.mean(res):.2f} m mean residual = "
        f"{PRESSURE_GRID_ELEV_M + statistics.mean(res):.1f} m "
        f"(sd {statistics.stdev(res):.2f} m)"
    )
    print(
        "\nThe hourly series is a model reanalysis on a coarse grid, not a barometer at the "
        "site.\nIt can carry an argument about tens of metres; it cannot settle one about "
        "one metre."
    )
    return 0


