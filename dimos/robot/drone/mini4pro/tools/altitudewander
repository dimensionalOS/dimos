def drift_of(s, min_seconds):
    """Least-squares slope of the ground-segment datum, m/min, plus the raw endpoints."""
    pts = s.ground_datum_window()
    if len(pts) < 3:
        return None
    t0, t1 = pts[0][0], pts[-1][0]
    if t1 - t0 < min_seconds:
        return None
    n = len(pts)
    mt = sum(p[0] for p in pts) / n
    mv = sum(p[1] for p in pts) / n
    num = sum((p[0] - mt) * (p[1] - mv) for p in pts)
    den = sum((p[0] - mt) ** 2 for p in pts)
    if den == 0:
        return None
    slope_per_s = num / den
    vs = [p[1] for p in pts]
    return {
        "n": n,
        "t0": t0,
        "t1": t1,
        "minutes": (t1 - t0) / 60.0,
        "slope_m_per_min": slope_per_s * 60.0,
        "endpoint_delta": pts[-1][1] - pts[0][1],
        "peak_to_peak": max(vs) - min(vs),
        "first": pts[0][1],
        "last": pts[-1][1],
    }


def relalt_ground_drift(s, t0, t1):
    """What `relativeAltitude` -- the number we actually publish -- did over the same window.

    The comparison matters: the datum's wander is only interesting if the channel it would be
    added to is steadier than it. `relalt` is dense (the state stream, ~5 Hz) rather than
    change-driven, so this is a real sample count, not a change count.
    """
    pts = [(t, v) for (t, v) in s.relalt if t0 <= t <= t1]
    if len(pts) < 10:
        return None
    vs = [v for _, v in pts]
    n = len(pts)
    mt = sum(p[0] for p in pts) / n
    mv = sum(vs) / n
    den = sum((p[0] - mt) ** 2 for p in pts)
    slope = (sum((p[0] - mt) * (p[1] - mv) for p in pts) / den) if den else 0.0
    return {
        "n": n,
        "peak_to_peak": max(vs) - min(vs),
        "slope_m_per_min": slope * 60.0,
        "endpoint_delta": vs[-1] - vs[0],
    }


