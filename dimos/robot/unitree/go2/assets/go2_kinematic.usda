    def Scope "Physics"
    {
        def Material "PhysicsMaterial" (
            apiSchemas = ["PhysicsMaterialAPI", "NewtonMaterialAPI"]
        )
        {
            float newton:contactDamping = 100
            float newton:contactStiffness = 2500
            float newton:rollingFriction = 0.0001
            float newton:torsionalFriction = 0.005
            float physics:dynamicFriction = 0.6
            float physics:staticFriction = 0.6
        }

        def Material "PhysicsMaterial_1" (
            apiSchemas = ["PhysicsMaterialAPI", "NewtonMaterialAPI"]
        )
        {
            float newton:contactDamping = 100
            float newton:contactStiffness = 2500
            float newton:rollingFriction = 0.01
            float newton:torsionalFriction = 0.02
            float physics:dynamicFriction = 0.8
            float physics:staticFriction = 0.8
        }

        def MjcActuator "x"
        {
            custom token mjc:forceLimited = "true"
            custom double mjc:forceRange:max = 400
            custom double mjc:forceRange:min = -400
            custom rel mjc:target = </go2/Geometry/x_link/x>
        }

        def MjcActuator "y"
        {
            custom token mjc:forceLimited = "true"
            custom double mjc:forceRange:max = 400
            custom double mjc:forceRange:min = -400
            custom rel mjc:target = </go2/Geometry/y_link/y>
        }

        def MjcActuator "yaw"
        {
            custom token mjc:forceLimited = "true"
            custom double mjc:forceRange:max = 20
            custom double mjc:forceRange:min = -20
            custom rel mjc:target = </go2/Geometry/base_link/yaw>
        }
    }
}

def PhysicsScene "PhysicsScene" (
    apiSchemas = ["NewtonSceneAPI", "MjcSceneAPI"]
)
{
    uniform token mjc:compiler:angle = "radian"
    uniform token mjc:option:cone = "elliptic"
    uniform double mjc:option:impratio = 100
    uniform int newton:maxSolverIterations = 100
    uniform int newton:timeStepsPerSecond = 500
    vector3f physics:gravityDirection = (0, 0, -1)
    float physics:gravityMagnitude = 9.81
}
