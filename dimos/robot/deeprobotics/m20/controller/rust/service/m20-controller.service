# The M20 controller on AOS like rl_deploy.service: holds the robot whether or not a run is up (install.sh installs it).
[Unit]
Description=M20 controller (dimos pure-Rust rl_deploy replacement)
After=network-online.target dimos-host-router.service
Conflicts=rl_deploy.service

[Service]
User=user
SupplementaryGroups=dialout video
Environment=HOME=/home/user
ExecStart=/var/opt/robot/data/dimos_host/dimos/robot/deeprobotics/m20/controller/rust/result/bin/m20_controller_module
StandardInput=file:/var/opt/robot/data/m20_controller/launch.json
# the motor bus (raw eth1), the 1 kHz loop's SCHED_FIFO and pinning ([realtime] in m20_controller.toml)
AmbientCapabilities=CAP_NET_RAW CAP_SYS_NICE
LimitRTPRIO=99
LimitMEMLOCK=infinity
# a stop lies a standing robot down (safety.shutdown_lie_down_max_s 11 s) and damps 0.5 s before it exits
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
