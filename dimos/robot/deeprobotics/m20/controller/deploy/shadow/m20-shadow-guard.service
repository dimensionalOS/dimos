[Unit]
Description=M20 shadow guard: stops m20-shadow if rl_deploy's send timeouts rise faster than their background rate
PartOf=m20-shadow.service
After=m20-shadow.service

[Service]
# rate, slack and post-restart settle time: guard_* in shadow.toml
ExecStart=/var/opt/robot/data/m20_shadow/bin/guard.sh /var/opt/robot/data/m20_shadow/shadow.toml
CPUAffinity=1 2 3
Nice=10
Restart=no
