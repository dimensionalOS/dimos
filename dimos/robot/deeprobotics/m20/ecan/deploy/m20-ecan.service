#
# The M20's joint state and batteries off the motor bus, on the vendor AOS board: reads the frames the ecan_tap.so
# shim streams out of rl_deploy (install it with ../tap/record.sh install) and publishes JointState / BatteryState on
# zenoh. Sends nothing to the motor bus. Without the shim it waits and warns. The module reads its config as one
# line of stdin, so the file's newlines are dropped on the way in.
[Unit]
Description=DimOS M20 joint state + battery from the motor bus (rl_deploy shim -> zenoh)
After=network-online.target rl_deploy.service
Wants=network-online.target

[Service]
Type=simple
User=root
Nice=10
CPUAffinity=1-3
ExecStart=/bin/sh -c 'tr -d "\\n" < /etc/dimos-m20-ecan/config.json | /usr/local/bin/m20_ecan'
Environment=DIMOS_TRANSPORT=zenoh
Environment=RUST_LOG=info
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
