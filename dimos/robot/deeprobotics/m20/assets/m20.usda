over "Flattened_Prototype_4"
{
    def Shader "PreviewSurface"
    {
        uniform token info:id = "UsdPreviewSurface"
        color3f inputs:diffuseColor.connect = </Flattened_Prototype_4.inputs:color>
        float inputs:metallic.connect = </Flattened_Prototype_4.inputs:metallic>
        float inputs:opacity.connect = </Flattened_Prototype_4.inputs:opacity>
        float inputs:roughness.connect = </Flattened_Prototype_4.inputs:roughness>
        token outputs:surface
    }

    def Shader "OpenPBR"
    {
        uniform token info:id = "ND_open_pbr_surface_surfaceshader"
        color3f inputs:base_color.connect = </Flattened_Prototype_4.inputs:color>
        float inputs:base_metalness.connect = </Flattened_Prototype_4.inputs:metallic>
        float inputs:geometry_opacity.connect = </Flattened_Prototype_4.inputs:opacity>
        float inputs:specular_roughness.connect = </Flattened_Prototype_4.inputs:roughness>
