<?xml version="1.0"?>
<robot name="DUAL_UF_ROBOT">
  <group name="left_arm">
    <chain base_link="left/link_base" tip_link="left/link6"/>
  </group>
  <group name="right_arm">
    <chain base_link="right/link_base" tip_link="right/link6"/>
  </group>
  <group name="both_arms">
    <joint name="left/joint1"/>
    <joint name="left/joint2"/>
    <joint name="left/joint3"/>
    <joint name="left/joint4"/>
    <joint name="left/joint5"/>
    <joint name="left/joint6"/>
    <joint name="right/joint1"/>
    <joint name="right/joint2"/>
    <joint name="right/joint3"/>
    <joint name="right/joint4"/>
    <joint name="right/joint5"/>
    <joint name="right/joint6"/>
  </group>
</robot>
