# Copy to dimos/experimental/frank/.env (gitignored). Loaded by up.py, loop.py, speak.py, and the Pi Cerebras provider.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional: override Pi's saved default model for Frank.
# FRANK_MODEL=cerebras/gemma-4-31b
# CEREBRAS_API_KEY=

# Optional: hosted vision for the robot stack instead of the local Qwen/Moondream defaults.
# FRANK_VL_MODEL=cerebras
# FRANK_DETECTION_MODEL=cerebras

# Optional: public HTTPS address for the phone app; otherwise derived from `tailscale status`.
# FRANK_FUNNEL_URL=https://<machine>.<tailnet>.ts.net
