    def Scope "Physics"
    {
        def Material "PhysicsMaterial" (
            apiSchemas = ["PhysicsMaterialAPI", "NewtonMaterialAPI"]
        )
        {
            float newton:contactDamping = 100
            float newton:contactStiffness = 2500
            float newton:rollingFriction = 0.0001
            float newton:torsionalFriction = 0.005
            float physics:dynamicFriction = 1
            float physics:staticFriction = 1
        }
    }

    def DomeLight "ambient" (
        prepend apiSchemas = ["ShadowAPI"]
    )
    {
        color3f inputs:color = (0.9333333, 0.9333333, 1)
        # With the fittings gone this is the room's light, the way a World is in Blender: sun through
        # the skylights makes the bright patches and this fills everything else. 0.18 was sized to be
        # a whisper next to eighteen lamps; now it has to do their job.
        float inputs:intensity = 1.8
        bool inputs:shadow:enable = 0
    }

    def DistantLight "sun" (
        prepend apiSchemas = ["ShadowAPI"]
    )
    {
        color3f inputs:color = (1, 0.9636363, 0.9090909)
        float inputs:intensity = 1.4
        bool inputs:shadow:enable = 1
        quatf xformOp:orient = (0.973249, -0.18380234, 0.13785174, 0)
        uniform token[] xformOpOrder = ["xformOp:orient"]
    }
}

def RenderSettings "Look"
{
    # How the scene wants to be shown, so a viewer does not have to guess. Filmic tone mapping rolls
    # bright colour toward white, which costs a lit room most of its paint; the neutral curve keeps the
    # hue and takes the brightness instead. The saturation and contrast afterwards are what a render
    # out of Blender has and a plain rasterised frame does not.
    # AgX, Blender's own default, was tried here and measured worse: it is built for renders with
    # sixteen stops to compress, and this room is low-contrast to begin with, so all it did was
    # desaturate (0.094 -> 0.059) and flatten. The neutral curve keeps the hue and the contrast.
    uniform token dimos:look:toneMap = "neutral"
    # The fittings were turned up while the filmic curve was still rolling their highlights off.
    # Without that curve the same light clips the walls to flat white, so the room is exposed down
    # to put the bright end back inside the range, and the contrast bump -- which pushes exactly the
    # values that were clipping -- goes away. Saturation is what is actually wanted here.
    float dimos:look:exposure = 0.85
    # No environment light. Blender's bounce comes from irradiance volumes, which vary through space
    # and know what is occluding what; a single environment map does not, so it fills the floor under
    # a desk exactly as much as the floor beside it and erases the shadow it was meant to soften.
    # Measured: shadow depth went 0.81 -> 0.89. The viewer still supports it for scenes that want it.
    float dimos:look:saturation = 1.6
    float dimos:look:contrast = 1
}

def PhysicsScene "PhysicsScene" (
    apiSchemas = ["NewtonSceneAPI", "MjcSceneAPI"]
)
{
    uniform token mjc:compiler:angle = "radian"
    uniform int newton:maxSolverIterations = 100
    uniform int newton:timeStepsPerSecond = 500
    vector3f physics:gravityDirection = (0, 0, -1)
    float physics:gravityMagnitude = 9.81
}
