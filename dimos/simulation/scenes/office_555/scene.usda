    def Scope "Materials"
    {
        def Material "ground" (
            apiSchemas = ["MaterialXConfigAPI"]
            instanceable = false
            add references = </Flattened_Prototype_1>
        )
        {
            string config:mtlx:version = "1.39"
            color3f inputs:color = (0.99999994, 1, 0.9999999) (
                limits = {
                    dictionary hard = {
                        float3 maximum = (1, 1, 1)
                        float3 minimum = (0, 0, 0)
                    }
                }
                sdrMetadata = {
                    string uimax = "1, 1, 1"
                    string uimin = "0, 0, 0"
                }
            )
            float inputs:metallic = 0 (
                limits = {
                    dictionary hard = {
                        float maximum = 1
                        float minimum = 0
                    }
                }
                sdrMetadata = {
                    string uimax = "1"
                    string uimin = "0"
                }
            )
            float inputs:opacity = 1 (
                limits = {
                    dictionary hard = {
                        float maximum = 1
                        float minimum = 0
                    }
                }
                sdrMetadata = {
                    string uimax = "1"
                    string uimin = "0"
                }
            )
            float inputs:roughness = 0.5 (
                limits = {
                    dictionary hard = {
                        float maximum = 1
                        float minimum = 0
                    }
                }
                sdrMetadata = {
                    string uimax = "1"
                    string uimin = "0"
                }
            )
            token outputs:mtlx:surface.connect = </office_555/Materials/ground/OpenPBR.outputs:out>
            token outputs:surface.connect = </office_555/Materials/ground/mjcPreviewSurface.outputs:surface>

            def Shader "mjcPreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </office_555/Materials/ground/mjcTexture_ground.outputs:rgb>
                token outputs:surface
            }

            def Shader "mjcTexture_ground" (
                assetInfo = {
                    asset identifier = @meshes/ground_grid.png@
                    string version = "sha256:0cdf3b0b6b7bdc320a431b34286dfbfdeac5951247050e89e4ecfdf78c47279f"
                }
            )
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @meshes/ground_grid.png@
                float3 outputs:rgb
            }
        }

