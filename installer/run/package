"""Build the dimup wheel and stamp a bootstrap for a DimOS GitHub release."""

import argparse
from hashlib import sha256
from pathlib import Path
import subprocess


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("output", type=Path)
    parser.add_argument("--release", required=True, help="GitHub release tag, e.g. v0.0.14")
    args = parser.parse_args()
    root = Path(__file__).resolve().parents[1]
    output = args.output.resolve()
    output.mkdir(parents=True, exist_ok=True)
    subprocess.run(
        ["uv", "build", "--project", str(root), "--wheel", "--out-dir", str(output)], check=True
    )
    (wheel,) = output.glob("dimup-*.whl")
    digest = sha256(wheel.read_bytes()).hexdigest()
    url = f"https://github.com/dimensionalOS/dimos/releases/download/{args.release}/{wheel.name}"
    bootstrap = (
        (root / "bootstrap.sh")
        .read_text()
        .replace("@DIMUP_WHEEL_URL@", url)
        .replace("@DIMUP_WHEEL_SHA@", digest)
    )
    (output / "dimup.sh").write_text(bootstrap)
    (output / "DIMUP_SHA256SUMS").write_text(f"{digest}  {wheel.name}\n")


if __name__ == "__main__":
    main()
