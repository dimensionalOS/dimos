"""Exercise the documented SDK application journey using the installed dimup."""

import argparse
import os
from pathlib import Path
import shutil
import signal
import subprocess
import tempfile
import threading


def run(root: Path, command: list[str], log: Path) -> None:
    with log.open("a") as output:
        subprocess.run(
            command, cwd=root, stdout=output, stderr=subprocess.STDOUT, check=True, timeout=1800
        )


def activated(root: Path, command: list[str], log: Path) -> None:
    run(
        root,
        [
            "bash",
            "--noprofile",
            "--norc",
            "-c",
            'source .dimos/activate.sh && exec "$@"',
            "acceptance",
            *command,
        ],
        log,
    )


def run_demo(root: Path, expected: str, log: Path) -> None:
    ready = threading.Event()
    failures: list[str] = []
    with log.open("a") as output:
        process = subprocess.Popen(
            [
                "bash",
                "--noprofile",
                "--norc",
                "-c",
                "source .dimos/activate.sh && exec dimos --viewer none run my-robot.demo",
            ],
            cwd=root,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            start_new_session=True,
        )

        def read() -> None:
            assert process.stdout is not None
            for line in process.stdout:
                output.write(line)
                output.flush()
                if (
                    "Exception in RPC handler" in line
                    or "Traceback (most recent call last)" in line
                ):
                    failures.append(line)
                if expected in line:
                    ready.set()

        reader = threading.Thread(target=read, daemon=True)
        reader.start()
        try:
            if not ready.wait(90):
                raise RuntimeError(f"No {expected!r} output; see {log}")
            os.killpg(process.pid, signal.SIGINT)
            code = process.wait(timeout=30)
            if code not in (0, 130, -signal.SIGINT):
                raise RuntimeError(f"Demo exited with {code}; see {log}")
        finally:
            if process.poll() is None:
                os.killpg(process.pid, signal.SIGKILL)
                process.wait()
            reader.join(timeout=5)
            if process.stdout is not None:
                process.stdout.close()
        if failures:
            raise RuntimeError(f"Demo reported runtime errors; see {log}")


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--ref", required=True)
    parser.add_argument("--results", type=Path, required=True)
    parser.add_argument("--native", action="store_true")
    args = parser.parse_args()
    results = args.results.resolve()
    results.mkdir(parents=True, exist_ok=True)
    log = results / "journey.log"
    with tempfile.TemporaryDirectory(prefix="dimup-acceptance-") as temporary:
        parent = Path(temporary)
        project = parent / "my-robot"
        run(parent, ["dimup", "init", str(project), "--ref", args.ref], log)
        activated(project, ["pytest", "-q"], log)
        activated(project, ["dimos", "doctor"], log)
        run_demo(project, "image 160x120", results / "demo.log")
        activated(project, ["uv", "add", "humanize"], log)
        for path in (project / "src/my_robot/demo.py", project / "tests/test_demo.py"):
            path.write_text(path.read_text().replace("160", "192"))
        activated(project, ["pytest", "-q"], log)
        run_demo(project, "image 192x120", results / "edited-demo.log")
        run(project, ["git", "init", "--quiet"], log)
        run(project, ["git", "add", "."], log)
        run(
            project,
            [
                "git",
                "-c",
                "user.name=DimOS",
                "-c",
                "user.email=build@dimos.invalid",
                "-c",
                "core.hooksPath=/dev/null",
                "commit",
                "--no-gpg-sign",
                "-m",
                "Application",
            ],
            log,
        )
        clone = parent / "clone"
        run(parent, ["git", "clone", str(project), str(clone)], log)
        run(clone, ["uv", "sync", "--locked"], log)
        activated(clone, ["pytest", "-q"], log)
        activated(clone, ["dimos", "doctor"], log)
        run_demo(clone, "image 192x120", results / "clone-demo.log")
        shutil.copy(project / ".dimos/setup.log", results / "setup.log")
        if args.native:
            script = Path(__file__).with_name("native_acceptance.py")
            activated(clone, ["python", str(script), str(results)], results / "native.log")
    print(f"Application journey passed. Results: {results}")


if __name__ == "__main__":
    main()
