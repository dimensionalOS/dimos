global-exclude *.pyc
global-exclude __pycache__
global-exclude .DS_Store

# --- Runtime data shipped inside the package ---
# Keep these sdist inputs in sync with tool.setuptools.package-data. Wheel data
# is selected explicitly there, independently of this manifest.
recursive-include dimos *.yaml *.yml *.json *.urdf *.html *.css *.js *.svg *.tcss
include dimos/robot/galaxea/r1pro/vendor_setup.sh

# Native modules build these release-matched sources at runtime, including
# nested workspaces, C shims, vendored licenses and hidden Cargo config.
recursive-include dimos/**/rust *.rs *.toml Cargo.lock *.nix flake.lock *.c *.h LICENSE* README.md *.cdr
recursive-include dimos/**/rust/**/.cargo *.toml

# --- Exclusions (must come after the includes above so they win) ---
prune dimos/**/rust/**/target
prune dimos/**/rust/**/build
prune dimos/**/rust/**/result*

# Test fixtures must never ship.
recursive-exclude dimos/agents/fixtures *
recursive-exclude dimos/agents/mcp/fixtures *
recursive-exclude dimos/mapping/google_maps/fixtures *

# The on-robot agent's Node package runs from a checkout, never from the package.
prune dimos/agents/node_modules
prune dimos/agents/dist
exclude dimos/agents/package.json dimos/agents/package-lock.json
exclude dimos/agents/tsconfig.json dimos/agents/.prettierrc.json

# Exclude web development directories
recursive-exclude dimos/web/websocket_vis/node_modules *

# Deno relay sources (repo-root web/): shipped inside the wheel by the
# build_py hook in setup.py (copied to dimos/web/relay_bridge/_relay_dist).
# The graft keeps them in the sdist so sdist->wheel builds (uv build, pip)
# can reproduce that copy.
# Per directory: `graft web` walks web/node_modules symlinks and loses their targets.
graft web/cockpit
graft web/examples
graft web/relay
graft web/sdk
graft web/shared
include web/README.md web/deno.json web/deno.lock
prune web/cockpit/node_modules
prune web/sdk/node_modules

# Exclude development files
exclude .gitignore
exclude .gitattributes
prune .git
prune .github
prune .mypy_cache
prune .pytest_cache
prune .ruff_cache
prune .vscode

global-exclude test_*.py
global-exclude conftest.py
