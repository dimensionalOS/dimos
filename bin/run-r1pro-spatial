#!/usr/bin/env bash
# Run on the R1 Pro Jetson. The vendor drivers/tracker must already be running.
set -eo pipefail
cd "$(dirname "$0")/.."
source /opt/ros/humble/setup.bash
source /home/nvidia/galaxea-dimos/install/setup.bash
export ROS_DOMAIN_ID="${DIMOS_R1PRO_ROS_DOMAIN_ID:-0}"
export RMW_IMPLEMENTATION=rmw_fastrtps_cpp
export PATH="$HOME/.local/bin:$HOME/.nix-profile/bin:/nix/var/nix/profiles/default/bin:$PATH"
source .venv/bin/activate
python -m dimos.robot.galaxea.r1pro.spatial_preflight
if [[ "${1:-}" == "--check" ]]; then exit 0; fi
exec dimos --simulation "" --viewer none run r1pro-spatial "$@"
