#!/usr/bin/env python3
"""Render the PR comment for a profile run.

This layout is ours to edit -- Bencher's own comment is generated inside its
Rust CLI and cannot be templated, which is why this exists.

Usage:
    bin/rusage-comment <current.json> [baseline.json] [ref] > comment.md

Both files are Bencher Metric Format: {benchmark: {measure: {value: N}}}.
The baseline is the same file from the last green run on the compared ref;
omit it and the deltas are left off.
"""

import json
from pathlib import Path
import sys

TEMPLATE = """\
<!-- dimos-profile -->
### Deployment resource footprint

{blocks}

<sub>vs. last green run on `{ref}` &middot; `bin/rusage`, cgroup accounting
over the whole process tree &middot; recorded, not gated</sub>
"""

BLOCK = "**{benchmark}** &nbsp; {cells}"

CELL = "{label} {value}{delta}"
JOIN = " &nbsp; "

# Short labels, in the order they are printed. Measures missing from a
# benchmark are skipped, so `venv` prints as a single Size cell.
LABELS = {
    "wall-seconds": "Wall",
    "cpu-core-seconds": "Cpu",
    "cpu-user-seconds": "Usr",
    "cpu-system-seconds": "Sys",
    "peak-memory-mib": "Mem",
    "peak-threads": "Thr",
    "disk-read-mib": "Rd",
    "disk-write-mib": "Wr",
    "net-rx-mib": "Rx",
    "net-tx-mib": "Tx",
    "install-size-mib": "Size",
}

# Deltas at or above this are bolded. Colour would need MathJax, which drags
# the serif math font in with it -- bold is the emphasis that stays in the
# comment's own typeface.
LOUD_PCT = 12


def number(slug: str, value: float) -> str:
    """Carry the unit and keep it readable: 201s, 5.8s, 2.7GiB, 312."""
    if slug.endswith("-seconds"):
        return f"{value:.0f}s" if abs(value) >= 100 else f"{value:.1f}s"
    if slug.endswith("-mib"):
        return f"{value / 1024:.1f}GiB" if abs(value) >= 1024 else f"{value:.0f}MiB"
    return f"{value:.0f}"


def delta(value: float, baseline: float | None) -> str:
    if baseline is None or baseline == 0:
        return ""
    pct = round((value - baseline) / baseline * 100)
    text = f"Δ{pct:+d}%"
    return f" **{text}**" if abs(pct) >= LOUD_PCT else f" {text}"


def block(benchmark: str, measures: dict, base: dict) -> str:
    cells = [
        CELL.format(
            label=label,
            value=number(slug, measures[slug]["value"]),
            delta=delta(measures[slug]["value"], base.get(slug, {}).get("value")),
        )
        for slug, label in LABELS.items()
        if slug in measures
    ]
    return BLOCK.format(benchmark=benchmark, cells=JOIN.join(cells))


def main() -> None:
    if len(sys.argv) < 2:
        sys.exit("usage: bin/rusage-comment <current.json> [baseline.json] [ref]")

    current = json.loads(Path(sys.argv[1]).read_text())
    baseline_path = Path(sys.argv[2]) if len(sys.argv) > 2 else None
    ref = sys.argv[3] if len(sys.argv) > 3 else "main"

    base = {}
    if baseline_path and baseline_path.is_file():
        base = json.loads(baseline_path.read_text())

    blocks = [block(name, m, base.get(name, {})) for name, m in current.items()]
    print(TEMPLATE.format(ref=ref, blocks="\n\n".join(blocks)))


if __name__ == "__main__":
    main()
