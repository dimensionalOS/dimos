#!/usr/bin/env python3
"""Find and build the PyO3 extension modules in this repository.

A PyO3 extension is the one rust artefact nix does not produce for us: pytest
imports the compiled `.so`, and it must match the interpreter uv resolved, not
nixpkgs'. Every one is abi3, so one build per OS serves every Python version.

Discovery is by content, never by path. An extension is any tracked
`pyproject.toml` whose build backend is maturin; its `[tool.maturin] module-name`
is the name python imports. Adding a binding needs no edit here or in CI.

  --list         print `<manifest> <module-name>` per extension
  --build        maturin develop each one into the active virtualenv, then import it
  --wheels DIR   build a wheel of each into DIR (CI installs these in the test jobs)
"""

import argparse
from pathlib import Path
import subprocess
import sys

if sys.version_info >= (3, 11):
    import tomllib
else:
    import tomli as tomllib

REPO_ROOT = Path(__file__).resolve().parent.parent


def _tracked(pattern: str) -> list[str]:
    return subprocess.run(
        ["git", "ls-files", pattern],
        cwd=str(REPO_ROOT),
        capture_output=True,
        text=True,
        check=True,
    ).stdout.split()


def extensions() -> list[tuple[Path, str]]:
    """(Cargo manifest, python module name) for every maturin-built crate."""
    found = []
    for path in _tracked("*pyproject.toml"):
        try:
            config = tomllib.loads((REPO_ROOT / path).read_text())
        except tomllib.TOMLDecodeError:
            continue
        if config.get("build-system", {}).get("build-backend") != "maturin":
            continue
        directory = (REPO_ROOT / path).parent
        module = config.get("tool", {}).get("maturin", {}).get("module-name")
        if not module:
            sys.exit(f"{path}: a maturin build needs [tool.maturin] module-name")
        found.append((directory / "Cargo.toml", module))
    return sorted(found)


def _maturin(command: str, manifest: Path, module: str, *extra: str) -> None:
    # Own target dir: a crate another extension depends on is built there without its
    # python feature, under the same output name, and maturin would install that copy.
    target = REPO_ROOT / "target" / "pyo3" / module
    # cargo reads .cargo/config.toml from its cwd (a crate's macOS link flags live there)
    subprocess.run(
        ["maturin", command, "-m", str(manifest), "--target-dir", str(target), *extra],
        cwd=manifest.parent,
        check=True,
    )


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--list", action="store_true")
    mode.add_argument("--build", action="store_true")
    mode.add_argument("--wheels", type=Path, metavar="DIR")
    args = parser.parse_args()

    found = extensions()
    if not found:
        sys.exit("no maturin-built crates found; discovery is broken")

    if args.list:
        for manifest, module in found:
            print(f"{manifest.relative_to(REPO_ROOT)} {module}")
        return

    if args.wheels:
        for manifest, module in found:
            _maturin("build", manifest, module, "--out", str(args.wheels.resolve()))
        return

    for manifest, module in found:
        _maturin("develop", manifest, module)
    names = [module for _, module in found]
    subprocess.run(
        [sys.executable, "-c", "import " + ", ".join(names)], cwd=str(REPO_ROOT), check=True
    )


if __name__ == "__main__":
    main()
