#!/usr/bin/env bash
# Build the mkdocs site and stage it into the github pages repo.
#
# The pages repo serves rendered html straight from the working tree, so
# deploying is: build, replace the target directory, commit there. The sphinx
# build lives beside it under sphinx/ so the two can be compared.
#
# Leaves the pages repo staged but uncommitted unless --commit is passed, and
# never pushes. A CI job should call this same script.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

PAGES_REPO="${DOCS_PAGES_REPO:-$HOME/coding/dimensional/dimensionalOS.github.io}"
TARGET_DIR="mkdocs"
DO_COMMIT=0

usage() {
  cat >&2 <<'EOF'
Usage: bin/docs-deploy [options]

  --pages-repo DIR  Checkout of dimensionalOS.github.io
                    (default: $DOCS_PAGES_REPO, else ~/coding/dimensional/dimensionalOS.github.io)
  --target DIR      Subdirectory within the pages repo (default: mkdocs)
  --commit          Commit in the pages repo. Never pushes.

Serves at https://dimensionalos.github.io/<target>/
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    --pages-repo)
      PAGES_REPO="${2:?--pages-repo requires a path}"
      shift 2
      ;;
    --target)
      TARGET_DIR="${2:?--target requires a name}"
      shift 2
      ;;
    --commit)
      DO_COMMIT=1
      shift
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage
      exit 2
      ;;
  esac
done

if [[ ! -d "$PAGES_REPO/.git" ]]; then
  echo "Not a git checkout: $PAGES_REPO" >&2
  exit 1
fi

DEST="$PAGES_REPO/$TARGET_DIR"

echo "Building mkdocs site..."
uv run mkdocs build --strict --site-dir "$REPO_ROOT/site"

# Replace rather than merge: a stale page left behind still resolves, and a
# reader has no way to tell it is from the previous build.
echo "Replacing $DEST"
rm -rf "$DEST"
mkdir -p "$DEST"
cp -r "$REPO_ROOT/site/." "$DEST/"

cd "$PAGES_REPO"
git add -A "$TARGET_DIR"

SOURCE_REV="$(git -C "$REPO_ROOT" rev-parse --short HEAD)"
echo
echo "Staged $(git diff --cached --numstat -- "$TARGET_DIR" | wc -l) files in $PAGES_REPO/$TARGET_DIR"
echo "Built from dimos $SOURCE_REV"

if [[ "$DO_COMMIT" -eq 1 ]]; then
  git commit -q -m "docs: deploy mkdocs build from dimos $SOURCE_REV"
  echo "Committed. Push it yourself when you are happy with it."
else
  echo "Review with: git -C $PAGES_REPO diff --cached --stat"
fi
