#!/usr/bin/env bash
# Install the Pi CLI that the agent eval tests (dimos/evals/agents) drive into the npm
# prefix given as $1, by default the dimos-test-clis cache directory.
# Production DimOS agent evals use in-repo `dimos agent` (DimosAgentAdapter), not the
# retired npm @dimensionalos/dimcode package (base64-on-wire Err source).
# Hosts without Node 24 get a private Node 24 next to the CLIs. The prefix must not have
# a "dimos" path component, because the no_dimos evals drop such PATH entries.
set -euo pipefail
prefix=${1:-"${XDG_CACHE_HOME:-$HOME/.cache}/dimos-test-clis"}
packages=(@earendil-works/pi-coding-agent@0.85.1)
case "$(node --version 2>/dev/null || true)" in
  v24.*) ;;
  *) packages+=(node@24) ;;
esac
npm install --prefix "$prefix" --no-fund --no-audit "${packages[@]}"
