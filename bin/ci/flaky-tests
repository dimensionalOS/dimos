#!/usr/bin/env python3
"""Tests that failed on pull requests in the last N days, by test, as JSON.

{"<test>": ["<branch>", ...], ...} from Codecov's test analytics, where every
test job uploads its junit results, cancelled runs included. A PR is a branch
(main is left out), and the tests come most-affected first: by how many
authors' PRs they failed on, then by how many PRs. The authors matter because
one author's PRs can be a stack carrying the same change, so a test
failing on ten of them is broken by that change, not flaky.

  GITHUB_REPOSITORY=dimensionalOS/dimos bin/ci/flaky-tests --days 1

With --create-issues (the daily flaky-tests workflow) a test that failed on the
PRs of MIN_AUTHORS or more authors gets an issue; one per test while it stays
open.
"""

import argparse
from collections import defaultdict
from collections.abc import Iterable, Iterator
from datetime import datetime, timedelta, timezone
from itertools import count
import json
import os
import time
from typing import Any
import urllib.error
import urllib.parse
import urllib.request

CODECOV = "https://api.codecov.io/api/v2/github"
API = "https://api.github.com"
BRANCH = "main"
PAGE = 1000  # Codecov serves up to 2000; a day of failures is a few hundred rows.
# Authors whose PRs a test must have failed on.
MIN_AUTHORS = 3
LABEL = "ci-alerts"
MARKER = "<!-- flaky-tests: {test} -->"


def fetch(
    url: str,
    token: str | None,
    body: dict[str, Any] | None = None,
    /,
    **params: str | int,
) -> Any:
    req = urllib.request.Request(
        f"{url}?{urllib.parse.urlencode(params)}",
        data=json.dumps(body).encode() if body else None,  # A POST when given.
        headers={
            "Accept": "application/json",
            "Content-Type": "application/json",
            "X-GitHub-Api-Version": "2022-11-28",
            **({"Authorization": f"Bearer {token}"} if token else {}),
        },
    )
    for attempt in count(1):
        try:
            with urllib.request.urlopen(req, timeout=60) as resp:
                return json.load(resp)
        except OSError as err:  # HTTPError, URLError and socket errors alike.
            if (isinstance(err, urllib.error.HTTPError) and err.code < 500) or attempt == 3 or body:
                raise
            time.sleep(2**attempt)


def failures(repo: str, since: datetime) -> Iterator[dict[str, Any]]:
    """Codecov's failed test runs since `since`, newest first."""
    owner, name = repo.split("/")
    url = f"{CODECOV}/{owner}/repos/{name}/test-analytics/"
    for page in count(1):
        data = fetch(url, None, outcome="failure", page_size=PAGE, page=page)
        for row in data["results"]:
            if datetime.fromisoformat(row["timestamp"]) < since:
                return
            yield row
        if not data["next"]:
            return


def authors(branches: Iterable[str]) -> set[str]:
    """The <who> of each <who>/<type>/<topic> branch; a bot's prefix counts as one."""
    return {branch.split("/", 1)[0] for branch in branches}


def gist(message: str) -> str:
    """pytest's E lines: the assertion or exception without the traceback."""
    lines = [line for line in message.splitlines() if line.startswith("E ")]
    return "\n".join(lines[:12] or message.splitlines()[-1:])[:1500]


def file_issues(
    failed: dict[str, dict[str, list[str]]],
    messages: dict[str, str],
    days: int,
    repo: str,
    token: str | None,
) -> list[str]:
    """One issue per test that failed on the PRs of MIN_AUTHORS authors."""
    flagged = [test for test in failed if len(authors(failed[test])) >= MIN_AUTHORS]
    if not flagged:
        return []

    issues = f"{API}/repos/{repo}/issues"
    bodies = [
        issue["body"] or ""
        for issue in fetch(issues, token, labels=LABEL, state="open", per_page=100)
    ]
    try:
        fetch(f"{API}/repos/{repo}/labels/{LABEL}", token)
    except urllib.error.HTTPError as err:
        if err.code != 404:
            raise
        label = {"name": LABEL, "color": "d93f0b", "description": "Filed by bin/ci/flaky-tests"}
        fetch(f"{API}/repos/{repo}/labels", token, label)
    window = "day" if days == 1 else f"{days} days"

    actions = []
    for test in flagged:
        if any(MARKER.format(test=test) in body for body in bodies):
            actions.append(f"{test}: an issue is already open")
            continue
        branches = failed[test]
        rows = "\n".join(
            f"| [{branch}](https://github.com/{repo}/pulls?q=head%3A{urllib.parse.quote(branch)})"
            f" | {len(commits)} | [{commits[0][:10]}](https://github.com/{repo}/commit/{commits[0]}) |"
            for branch, commits in sorted(branches.items())
        )
        issue = fetch(
            issues,
            token,
            {
                "title": f"Flaky test: {test} failed on {len(branches)} PRs in the last {window}",
                "body": f"""{MARKER.format(test=test)}
`{test}` failed on {len(branches)} PRs by {len(authors(branches))} authors in the last {window}.

| Branch | Failing commits | Latest |
|---|---|---|
{rows}

The latest failure:
```
{gist(messages[test])}
```
""",
                "labels": [LABEL],
            },
        )
        actions.append(f"{test}: filed {issue['html_url']}")
    return actions


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("--days", type=int, default=1)
    parser.add_argument(
        "--create-issues", action="store_true", help="needs GITHUB_TOKEN with issues: write"
    )
    args = parser.parse_args()
    repo = os.environ["GITHUB_REPOSITORY"]
    since = datetime.now(timezone.utc) - timedelta(days=args.days)

    failed: dict[str, dict[str, list[str]]] = defaultdict(lambda: defaultdict(list))
    messages: dict[str, str] = {}  # The newest failure's, per test.
    for row in failures(repo, since):
        if not row["branch"] or row["branch"] == BRANCH:
            continue
        commits = failed[row["computed_name"]][row["branch"]]
        if row["commit_sha"] not in commits:
            commits.append(row["commit_sha"])
        messages.setdefault(row["computed_name"], row["failure_message"] or "")
    ranked = sorted(
        failed, key=lambda test: (-len(authors(failed[test])), -len(failed[test]), test)
    )
    print(json.dumps({test: sorted(failed[test]) for test in ranked}, indent=1))
    if args.create_issues:
        for action in file_issues(
            failed, messages, args.days, repo, os.environ.get("GITHUB_TOKEN")
        ):
            print(action)


if __name__ == "__main__":
    main()
