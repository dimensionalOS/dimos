#!/usr/bin/env bash
# Measure CPU time and peak memory of a command *and every process it spawns*.
#
# The command runs inside a transient systemd scope with CPU/memory accounting
# on, and the counters are read from the scope's own cgroup. That is why this
# exists instead of `/usr/bin/time -v`: cgroup counters cover grandchildren and
# native subprocesses that were never reaped by the shell, and `memory.peak` is
# the tree's simultaneous high-water mark rather than the largest single process.
#
# Usage:
#   bin/rusage --name <benchmark> --out results.json -- <cmd> [args...]
#
# Writes Bencher Metric Format (BMF) JSON to --out, a human summary to stderr,
# and exits with the command's own exit code.
#
# Caveat: processes that deliberately escape the scope are not counted --
# docker containers land in docker.slice, and anything started via its own
# `systemd-run`/`systemctl start` gets its own unit.
set -euo pipefail

name=""
out=""

while [[ $# -gt 0 ]]; do
	case "$1" in
	--name)
		name="$2"
		shift 2
		;;
	--out)
		out="$2"
		shift 2
		;;
	--)
		shift
		break
		;;
	*)
		echo "rusage: unexpected argument: $1" >&2
		exit 2
		;;
	esac
done

if [[ -z $name || -z $out || $# -eq 0 ]]; then
	echo "usage: bin/rusage --name <benchmark> --out <results.json>" \
		"-- <cmd> [args...]" >&2
	exit 2
fi

if [[ ! -e /sys/fs/cgroup/cgroup.controllers ]]; then
	echo "rusage: needs cgroup v2 (no /sys/fs/cgroup/cgroup.controllers)" >&2
	exit 1
fi

dir="$(mktemp -d -t rusage.XXXXXX)"
stats="$dir/stats"
trap 'rm -rf "$dir"' EXIT

# Prefer a system scope: only the system manager can enable the io controller
# or attach the eBPF counters behind IPAccounting, so a user scope silently
# loses disk and network. It needs passwordless sudo, so probe with `sudo -n`
# and fall back to a user scope rather than blocking on a prompt.
unit="rusage-$$"
if sudo -n true 2>/dev/null; then
	scope=(sudo -E systemd-run --scope --quiet --uid="$(id -u)" --gid="$(id -g)")
	manager=--system
else
	scope=(systemd-run --user --scope --quiet)
	manager=--user
fi

# Read the counters from *inside* the scope, after the payload exits but while
# this shell still holds the scope open -- a transient scope is released as soon
# as its last process is gone, so there is nothing left to read afterwards.
# Optional files are copied out raw and parsed outside: systemd expands ${...}
# in the command line before bash sees it, so no shell arithmetic in here.
inner='
	"$@" && rc=0 || rc=$?
	cg=/sys/fs/cgroup$(cut -d: -f3 </proc/self/cgroup)
	cat "$cg/cpu.stat" >"$RUSAGE_DIR/stats"
	echo "memory_peak_bytes $(cat "$cg/memory.peak")" >>"$RUSAGE_DIR/stats"
	echo "pids_peak $(cat "$cg/pids.peak")" >>"$RUSAGE_DIR/stats"
	for f in io.stat io.pressure memory.pressure cpu.pressure; do
		[ -r "$cg/$f" ] && cat "$cg/$f" >"$RUSAGE_DIR/$f"
	done
	# There is no cgroup file for network bytes. systemd keeps its own eBPF
	# counters per unit, readable while this shell still holds the unit open.
	systemctl "$RUSAGE_MANAGER" show -p IPIngressBytes -p IPEgressBytes \
		"$RUSAGE_UNIT" >"$RUSAGE_DIR/ip" 2>/dev/null || true
	exit $rc
'

started=$EPOCHREALTIME
"${scope[@]}" \
	--unit="$unit" \
	--property=MemoryAccounting=1 \
	--property=IOAccounting=1 \
	--property=IPAccounting=yes \
	--setenv=RUSAGE_DIR="$dir" \
	--setenv=RUSAGE_UNIT="$unit.scope" \
	--setenv=RUSAGE_MANAGER="$manager" \
	-- bash -c "$inner" rusage-payload "$@" && rc=0 || rc=$?
wall=$(awk -v a="$started" -v b="$EPOCHREALTIME" 'BEGIN { printf "%.3f", b - a }')

field() {
	awk -v key="$1" '$1 == key && NF >= 2 { print $2; found = 1 } END { exit !found }' "$stats" ||
		{
			echo "rusage: '$1' missing from cgroup accounting -- is the controller delegated?" >&2
			exit 1
		}
}

user_usec=$(field user_usec)
system_usec=$(field system_usec)
usage_usec=$(field usage_usec)
peak_bytes=$(field memory_peak_bytes)
# Tasks, so threads not just processes -- which is the number that regresses
# when a native library quietly sizes another pool to all cores.
peak_threads=$(field pids_peak)

read -r cpu_user cpu_system cpu_total peak_mib < <(
	awk -v u="$user_usec" -v s="$system_usec" -v t="$usage_usec" -v p="$peak_bytes" \
		'BEGIN { printf "%.3f %.3f %.3f %.1f\n", u / 1e6, s / 1e6, t / 1e6, p / 1048576 }'
)

json=""
add() {
	[[ -n $json ]] && json+=$',\n'
	json+="    \"$1\": { \"value\": $2 }"
}

# A measure the kernel did not report is left out rather than sent as zero,
# which would read as "no disk traffic" instead of "not measured".
add_mib() {
	[[ -n $2 ]] || return 0
	add "$1" "$(awk -v b="$2" 'BEGIN { printf "%.3f", b / 1048576 }')"
}

io_read=""
io_write=""
if [[ -s "$dir/io.stat" ]]; then
	read -r io_read io_write < <(awk '
		{ for (i = 2; i <= NF; i++) { split($i, kv, "="); io[kv[1]] += kv[2] } }
		END { print io["rbytes"] + 0, io["wbytes"] + 0 }
	' "$dir/io.stat")
fi

# "[no data]" when the manager cannot attach the eBPF counters, which is the
# normal case for an unprivileged user unit.
ip_field() {
	awk -F= -v key="$1" '$1 == key && $2 ~ /^[0-9]+$/ { print $2 }' "$dir/ip" 2>/dev/null || true
}

add cpu-core-seconds "$cpu_total"
add cpu-user-seconds "$cpu_user"
add cpu-system-seconds "$cpu_system"
add peak-memory-mib "$peak_mib"
add peak-threads "$peak_threads"
add wall-seconds "$wall"
add_mib disk-read-mib "$io_read"
add_mib disk-write-mib "$io_write"
add_mib net-rx-mib "$(ip_field IPIngressBytes)"
add_mib net-tx-mib "$(ip_field IPEgressBytes)"

cat >"$out" <<JSON
{
  "$name": {
$json
  }
}
JSON

# Which optional sources the kernel actually offered. Without this a missing
# measure is indistinguishable from a measure that read zero.
printf 'rusage %s: scope=%s io.stat=%s ip=%s\n' \
	"$name" "${manager#--}" \
	"$([[ -s "$dir/io.stat" ]] && echo yes || echo no)" \
	"$([[ -n $(ip_field IPIngressBytes) ]] && echo yes || echo no)" >&2

printf 'rusage %s: %ss wall, %ss cpu (%ss user + %ss sys), %s peak rss, exit %d\n' \
	"$name" "$wall" "$cpu_total" "$cpu_user" "$cpu_system" \
	"$(numfmt --to=iec-i --suffix=B "$peak_bytes")" "$rc" >&2

exit "$rc"
