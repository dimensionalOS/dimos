set -euo pipefail

fail() { echo "$*" >&2; exit 1; }
[[ $# == 0 ]] || fail "usage: sudo bash bin/hardware/g1/install-jetson-clocks"
[[ $EUID == 0 ]] || fail "Run with sudo to install the system service. DimOS itself runs as your normal user."
[[ -r /etc/nv_tegra_release ]] || fail "This installer requires a Jetson."
[[ -x /usr/bin/jetson_clocks ]] || fail "Missing NVIDIA /usr/bin/jetson_clocks."
[[ -d /run/systemd/system ]] || fail "This installer requires a systemd booted Jetson."
[[ $(systemctl show nvpmodel.service --property=LoadState --value) == loaded ]] \
    || fail "NVIDIA nvpmodel.service is required to set the power mode before locking clocks."
systemctl is-enabled --quiet nvpmodel.service \
    || fail "Enable NVIDIA nvpmodel.service before installing the clock service."

SONIC_UNIT_SOURCE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/dimos-jetson-clocks.service"
systemd-analyze verify "$SONIC_UNIT_SOURCE"
install -o root -g root -m 0644 "$SONIC_UNIT_SOURCE" /etc/systemd/system/dimos-jetson-clocks.service
systemctl daemon-reload
systemctl enable dimos-jetson-clocks.service
systemctl restart dimos-jetson-clocks.service
systemctl --no-pager status dimos-jetson-clocks.service

echo "Jetson clocks applied now and enabled at boot, after nvpmodel."
echo "The selected power mode and fan policy are unchanged. No robot process was restarted."
