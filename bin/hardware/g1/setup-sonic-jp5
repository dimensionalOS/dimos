# Build the pinned CUDA ONNX Runtime wheel for a JetPack 5 G1 PC2.
set -euo pipefail

REPO_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)
CUDA_HOME_JP5=/usr/local/cuda-11.8
SONIC_VENV="$REPO_ROOT/.venv-sonic-jp5"
SONIC_PYTHON_VERSION=3.10
ORT_VERSION=1.20.1
ORT_COMMIT=5c1b7ccbff7e5141c1da7a9d963d660e5741c319
TASK_CACHE_HOME=${XDG_CACHE_HOME:-$HOME/.cache}/dimos/sonic-jp5
ORT_SOURCE="$TASK_CACHE_HOME/onnxruntime-$ORT_VERSION"
WHEEL_CACHE="$TASK_CACHE_HOME/wheels"
CHECK_ONLY=false
FAILED=0

usage() {
    echo "usage: bin/hardware/g1/setup-sonic-jp5 [--check]"
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --check) CHECK_ONLY=true ;;
        -h|--help) usage; exit 0 ;;
        *) echo "unknown argument: $1" >&2; usage >&2; exit 2 ;;
    esac
    shift
done

pass() {
    echo "PASS  $1"
}

fail() {
    echo "FAIL  $1" >&2
    FAILED=$((FAILED + 1))
}

[[ -f "$REPO_ROOT/pyproject.toml" && -f "$REPO_ROOT/uv.lock" ]] \
    && pass "DimOS source checkout: $REPO_ROOT" \
    || fail "run this script from a DimOS source checkout"

[[ $(uname -m) == aarch64 ]] \
    && pass "architecture: aarch64" \
    || fail "expected the G1 PC2 aarch64 host, found $(uname -m)"

if [[ -r /etc/nv_tegra_release ]] && head -n 1 /etc/nv_tegra_release | grep -q '^# R35'; then
    pass "Jetson Linux: $(head -n 1 /etc/nv_tegra_release)"
else
    fail "expected Jetson Linux R35 (JetPack 5)"
fi

[[ -x "$CUDA_HOME_JP5/bin/nvcc" ]] \
    && pass "CUDA 11.8 compiler: $CUDA_HOME_JP5/bin/nvcc" \
    || fail "CUDA 11.8 is missing from $CUDA_HOME_JP5"

[[ -e "$CUDA_HOME_JP5/compat/libcuda.so" ]] \
    && pass "CUDA 11.8 compatibility driver: $CUDA_HOME_JP5/compat/libcuda.so" \
    || fail "cuda-compat-11-8 is missing"

[[ -e /usr/lib/aarch64-linux-gnu/libcudnn.so.8 ]] \
    && pass "cuDNN 8: /usr/lib/aarch64-linux-gnu/libcudnn.so.8" \
    || fail "cuDNN 8 is missing"

[[ -x /usr/bin/gcc-10 && -x /usr/bin/g++-10 ]] \
    && pass "compiler: gcc-10/g++-10" \
    || fail "gcc-10 and g++-10 are required (GCC 9.4 is too old for ORT 1.20)"

command -v uv >/dev/null 2>&1 && pass "uv: $(command -v uv)" || fail "uv is missing"
command -v git >/dev/null 2>&1 && pass "git: $(command -v git)" || fail "git is missing"
command -v git-lfs >/dev/null 2>&1 \
    && pass "git-lfs: $(command -v git-lfs)" \
    || fail "git-lfs is missing"

AVAILABLE_KB=$(df -Pk "$REPO_ROOT" | awk 'NR == 2 {print $4}')
if [[ -n "$AVAILABLE_KB" && "$AVAILABLE_KB" -ge 12582912 ]]; then
    pass "free disk: $((AVAILABLE_KB / 1024 / 1024)) GiB"
else
    fail "at least 12 GiB free disk is required to build ONNX Runtime"
fi

if [[ "$FAILED" -ne 0 ]]; then
    cat >&2 <<'EOF'

Prerequisites failed. This setup does not flash JetPack and does not install
system packages. For CUDA, use NVIDIA's CUDA 11.8 archive and select:
  Linux / aarch64-jetson / Ubuntu / 20.04 / deb
Then install the versioned packages:
  sudo apt-get install cuda-11-8 cuda-compat-11-8 gcc-10 g++-10
https://developer.nvidia.com/cuda-11-8-0-download-archive
EOF
    exit 1
fi

if [[ "$CHECK_ONLY" == true ]]; then
    echo "JetPack 5 SONIC prerequisites passed."
    exit 0
fi

mkdir -p "$TASK_CACHE_HOME" "$WHEEL_CACHE"

if [[ ! -d "$ORT_SOURCE/.git" ]]; then
    git clone \
        --branch "v$ORT_VERSION" \
        --depth 1 \
        --recurse-submodules \
        --shallow-submodules \
        https://github.com/microsoft/onnxruntime.git \
        "$ORT_SOURCE"
fi

ACTUAL_ORT_COMMIT=$(git -C "$ORT_SOURCE" rev-parse HEAD)
if [[ "$ACTUAL_ORT_COMMIT" != "$ORT_COMMIT" ]]; then
    echo "cached ONNX Runtime checkout is not the pinned commit:" >&2
    echo "  expected: $ORT_COMMIT" >&2
    echo "  actual:   $ACTUAL_ORT_COMMIT" >&2
    echo "Move $ORT_SOURCE aside and rerun setup." >&2
    exit 1
fi

if [[ ! -x "$SONIC_VENV/bin/python" ]] \
    || [[ $("$SONIC_VENV/bin/python" -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")') != "$SONIC_PYTHON_VERSION" ]]; then
    uv venv --clear --python "$SONIC_PYTHON_VERSION" "$SONIC_VENV"
fi
DIMOS_ALLOW_MISSING_COCKPIT=1 VIRTUAL_ENV="$SONIC_VENV" uv sync \
    --active \
    --python "$SONIC_VENV/bin/python" \
    --locked \
    --no-default-groups \
    --extra unitree-dds \
    --inexact \
    --no-install-package gtsam-extended \
    --no-install-package onnxruntime
uv pip install \
    --python "$SONIC_VENV/bin/python" \
    "cmake>=3.28,<4" \
    coloredlogs \
    flatbuffers \
    ninja \
    "numpy==1.26.4" \
    packaging \
    protobuf \
    setuptools \
    sympy \
    wheel

shopt -s nullglob
WHEELS=("$WHEEL_CACHE"/onnxruntime_gpu-"$ORT_VERSION"-*.whl)
shopt -u nullglob
if [[ ${#WHEELS[@]} -eq 0 ]]; then
    export PATH="$SONIC_VENV/bin:$CUDA_HOME_JP5/bin:$PATH"
    export LD_LIBRARY_PATH="$CUDA_HOME_JP5/compat:$CUDA_HOME_JP5/lib64:/usr/lib/aarch64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    export CC=/usr/bin/gcc-10
    export CXX=/usr/bin/g++-10
    (
        cd "$ORT_SOURCE"
        ./build.sh \
            --config Release \
            --update \
            --build \
            --parallel 2 \
            --nvcc_threads 1 \
            --skip_tests \
            --build_wheel \
            --use_cuda \
            --cuda_home "$CUDA_HOME_JP5" \
            --cudnn_home /usr \
            --cmake_extra_defines \
                CMAKE_CUDA_ARCHITECTURES=87 \
                onnxruntime_BUILD_UNIT_TESTS=OFF
    )
    cp "$ORT_SOURCE"/build/Linux/Release/dist/onnxruntime_gpu-"$ORT_VERSION"-*.whl \
        "$WHEEL_CACHE/"
    shopt -s nullglob
    WHEELS=("$WHEEL_CACHE"/onnxruntime_gpu-"$ORT_VERSION"-*.whl)
    shopt -u nullglob
fi

if [[ ${#WHEELS[@]} -ne 1 ]]; then
    echo "expected one cached ONNX Runtime wheel, found ${#WHEELS[@]}" >&2
    exit 1
fi

uv pip uninstall --python "$SONIC_VENV/bin/python" onnxruntime onnxruntime-gpu || true
uv pip install --python "$SONIC_VENV/bin/python" "${WHEELS[0]}"

cat <<EOF

JetPack 5 SONIC environment is ready.

Before each run:
  export PATH=$CUDA_HOME_JP5/bin:\$PATH
  export LD_LIBRARY_PATH=$CUDA_HOME_JP5/compat:$CUDA_HOME_JP5/lib64:/usr/lib/aarch64-linux-gnu\${LD_LIBRARY_PATH:+:\$LD_LIBRARY_PATH}
  source $SONIC_VENV/bin/activate
  dimos hardware g1 sonic-doctor

Use the activated environment's dimos command directly. Do not use uv run.
EOF
