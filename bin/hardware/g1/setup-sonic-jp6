# Install NVIDIA Jetson AI Lab's CUDA 12.6 / cuDNN 9 Python 3.10 wheel.
set -euo pipefail

REPO_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)
cd "$REPO_ROOT"
SONIC_VENV="$REPO_ROOT/.venv-sonic-jp6"
ORT_WHEEL_URL=https://pypi.jetson-ai-lab.io/jp6/cu126/+f/d98/0b934b9a29c1a/onnxruntime_gpu-1.24.0-cp310-cp310-linux_aarch64.whl
ORT_WHEEL_SHA256=d980b934b9a29c1a9d6f39751edd7662b69fadd75556a10ff363773a58ce0950
CHECK_ONLY=false

case "${1:-}" in
    --check) CHECK_ONLY=true ;;
    -h|--help) echo "usage: bin/hardware/g1/setup-sonic-jp6 [--check]"; exit 0 ;;
    "") ;;
    *) echo "usage: bin/hardware/g1/setup-sonic-jp6 [--check]" >&2; exit 2 ;;
esac
[[ $# -le 1 ]] || { echo "unexpected arguments" >&2; exit 2; }

[[ $(uname -m) == aarch64 ]] || { echo "expected aarch64 Jetson" >&2; exit 1; }
if [[ ! -r /etc/nv_tegra_release ]] || ! head -n 1 /etc/nv_tegra_release | grep -q '^# R36'; then
    echo "expected Jetson Linux R36 (JetPack 6); this script does not flash the robot" >&2
    exit 1
fi
for library in \
    /usr/local/cuda-12.6/lib64/libcudart.so.12 \
    /usr/lib/aarch64-linux-gnu/nvidia/libcuda.so.1 \
    /usr/lib/aarch64-linux-gnu/libcudnn.so.9; do
    [[ -e "$library" ]] || { echo "missing JetPack 6 library: $library" >&2; exit 1; }
done
command -v uv >/dev/null || { echo "uv is required" >&2; exit 1; }
echo "PASS  JetPack 6 / CUDA 12.6 / cuDNN 9 prerequisites"
[[ "$CHECK_ONLY" == false ]] || exit 0

# Keep the workstation/default environment and any JetPack 5 environment intact.
if [[ ! -x "$SONIC_VENV/bin/python" ]]; then
    uv venv --python /usr/bin/python3.10 "$SONIC_VENV"
fi
if [[ $("$SONIC_VENV/bin/python" -c 'import sys; print(sys.version_info[:2] == (3, 10))') != True ]]; then
    echo "$SONIC_VENV must use Python 3.10; move it aside and retry" >&2
    exit 1
fi
DIMOS_ALLOW_MISSING_COCKPIT=1 VIRTUAL_ENV="$SONIC_VENV" uv sync \
    --active --python "$SONIC_VENV/bin/python" --locked --no-default-groups \
    --extra unitree-dds --extra control --inexact \
    --no-install-package onnxruntime --no-install-package onnxruntime-gpu

# Both distributions own the onnxruntime/ tree. Remove CPU/older wheels before
# reinstalling the reviewed GPU wheel; use system CUDA, not PyPI's CUDA extras.
uv pip uninstall --python "$SONIC_VENV/bin/python" \
    onnxruntime onnxruntime-gpu onnxruntime-gpu-extended onnxruntime-gpu-extended-auto
# PyPI's ORT 1.24 has no cp310 wheel, so the project's generic cp310 constraint
# excludes it. This NVIDIA build explicitly supplies cp310; use its exact pin.
uv --no-config pip install --python "$SONIC_VENV/bin/python" --no-deps --require-hashes \
    "$ORT_WHEEL_URL#sha256=$ORT_WHEEL_SHA256"

"$SONIC_VENV/bin/python" - <<'PY'
import onnxruntime as ort

from dimos.control.tasks.g1_sonic_wbc_task.sonic_onnx_runtime import prepare_sonic_onnx_runtime
from dimos.cli.dimos import cli_main
from dimos.robot.unitree.g1.blueprints.basic.unitree_g1_sonic_wbc import (
    unitree_g1_sonic_wbc,
)

prepare_sonic_onnx_runtime()
print(f"PASS  ONNX Runtime {ort.__version__}: {ort.get_available_providers()}")
print("PASS  DimOS CLI and SONIC controller blueprint imports")
PY

"$SONIC_VENV/bin/python" -m dimos.control.tasks.g1_sonic_wbc_task.models --profile all

cat <<EOF

JetPack 6 SONIC dependencies are installed. Validate before motor control:
  source $SONIC_VENV/bin/activate
  export DIMOS_TRANSPORT=zenoh
  sudo nvpmodel -m 0
  sudo jetson_clocks
  dimos-sonic-models --check --profile all

The model check verifies installed assets without contacting the robot.
Use the activated environment's dimos directly; uv run can replace the GPU wheel.
EOF
