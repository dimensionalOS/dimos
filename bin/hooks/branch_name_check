#!/usr/bin/env python3
"""Pre-commit hook: branches are named <who>/<type>/<topic>, e.g. paul/feat/add-3d-map.

Runs locally on every commit and in CI through the pre-commit job. CI checks
out a detached merge commit on pull requests, so the branch name is taken
from GITHUB_HEAD_REF there and from git everywhere else.
"""

import os
import subprocess
import sys

TYPES = (
    "feat",
    "fix",
    "refactor",
    "docs",
    "test",
    "chore",
    "perf",
    "build",
    "ci",
    "style",
    "revert",
)

# Branches no person named: base branches, bots, GitHub's own machinery.
EXEMPT_NAMES = ("HEAD", "main")
EXEMPT_PREFIXES = (
    "release/",
    "dependabot/",
    "backport/",
    "copilot/",
    "revert-",
    "gh-readonly-queue/",
)

EXAMPLE = "paul/feat/add-3d-map"


def current_branch() -> str:
    name = os.environ.get("GITHUB_HEAD_REF")
    if name:
        return name
    result = subprocess.run(
        ["git", "rev-parse", "--abbrev-ref", "HEAD"], capture_output=True, text=True, check=True
    )
    return result.stdout.strip()


def check(name: str) -> tuple[str | None, str | None]:
    """Returns (error, hint). An error fails the hook, a hint only prints."""
    if name in EXEMPT_NAMES or name.startswith(EXEMPT_PREFIXES):
        return None, None
    parts = name.split("/")
    if len(parts) != 3 or not all(parts):
        return f"branch '{name}' is not <who>/<type>/<topic>, e.g. {EXAMPLE}", None
    who, kind, topic = parts
    if kind not in TYPES:
        return f"branch '{name}': type '{kind}' is not one of {', '.join(TYPES)}", None
    tidy = name.lower().replace("_", "-")
    if tidy != name:
        return None, f"branch '{name}': prefer lowercase and hyphens, e.g. {tidy}"
    return None, None


def main() -> int:
    error, hint = check(current_branch())
    in_actions = bool(os.environ.get("GITHUB_ACTIONS"))
    if error:
        print(("::error::" if in_actions else "") + error)
        if in_actions:
            print("Rename the branch on GitHub, the pull request follows the rename.")
        else:
            print(f"Rename with: git branch -m {EXAMPLE}")
        return 1
    if hint:
        print(("::warning::" if in_actions else "") + hint)
    return 0


if __name__ == "__main__":
    sys.exit(main())
