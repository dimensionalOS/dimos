#!/usr/bin/env bash

set -euo pipefail

uv sync --locked --inexact --group tests-self-hosted

rm -f .coverage .coverage.*

bin/build-test-natives
bin/fetch-test-data

export _DIMOS_COV=1
export PATH="${XDG_CACHE_HOME:-$HOME/.cache}/dimos-test-clis/node_modules/.bin:$PATH"

uv run --no-sync coverage run -m pytest "$@" -m ''
uv run --no-sync coverage combine
uv run --no-sync coverage html
uv run --no-sync coverage report
